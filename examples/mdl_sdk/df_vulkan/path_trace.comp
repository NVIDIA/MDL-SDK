    vec3 tangent_v;
};

const float M_PI = 3.14159265358979323846;
const float M_ONE_OVER_PI = 0.318309886183790671538;
const float DIRAC = -1.0;


//-------------------------------------------------------------------------------------------------
// Spectral rendering helpers
//-------------------------------------------------------------------------------------------------

#ifdef MDL_SPECTRAL_RENDERING

// Convert a spectral sample to RGB.
vec3 spectral_to_rgb(Spectral_sample values, Spectral_sample lambdas, bool is_reflectivity)
{
    vec3 xyz = vec3(0.0);

    // weight by CIE XYZ color matching functions
    // (using Wyman et al - "Simple Analytic Approximations to the CIE XYZ Color Matching Functions")
    for (int i = 0; i < MDL_DF_SPECTRAL_SAMPLES; ++i)
    {
        float lambda = lambdas.values[i];
        if (lambda < 360.0 || lambda > 830.0)
            continue;

        // for reflectivity values multiply by the spectral whitepoint of the RGB color space
        // (normalized to luminance 1)
        const float factor = is_reflectivity ? lookup_d65(lambda) : 1.0;
        {
            const float p1 = (lambda - 442.0) * ((lambda < 442.0) ? 0.0624 : 0.0374);
            const float p2 = (lambda - 599.8) * ((lambda < 599.8) ? 0.0264 : 0.0323);
            const float p3 = (lambda - 501.1) * ((lambda < 501.1) ? 0.0490 : 0.0382);
            xyz.x += (0.362 * exp(-0.5 * p1 * p1)
                    + 1.056 * exp(-0.5 * p2 * p2)
                    - 0.065 * exp(-0.5 * p3 * p3)) * values.values[i] * factor;
        }
        {
            const float p1 = (lambda - 568.8) * ((lambda < 568.8) ? 0.0213 : 0.0247);
            const float p2 = (lambda - 530.9) * ((lambda < 530.9) ? 0.0613 : 0.0322);
            xyz.y += (0.821 * exp(-0.5 * p1 * p1)
                    + 0.286 * exp(-0.5 * p2 * p2)) * values.values[i] * factor;
        }
        {
            const float p1 = (lambda - 437.0) * ((lambda < 437.0) ? 0.0845 : 0.0278);
            const float p2 = (lambda - 459.0) * ((lambda < 459.0) ? 0.0385 : 0.0725);
            xyz.z += (1.217 * exp(-0.5 * p1 * p1)
                    + 0.681 * exp(-0.5 * p2 * p2)) * values.values[i] * factor;
        }
    }

    // apply scaling from radiometric to photometric units
    xyz *= 683.002;

    // MDL_DF_SPECTRAL_SAMPLES samples uniformly on wavelength range
    if (uSpectralMaxWavelength != uSpectralMinWavelength)
        xyz *= (uSpectralMaxWavelength - uSpectralMinWavelength) / float(MDL_DF_SPECTRAL_SAMPLES);

    // convert to linear sRGB
    return vec3(
        dot(xyz, vec3( 3.240600, -1.537200, -0.498600)),
        dot(xyz, vec3(-0.968900,  1.875800,  0.041500)),
        dot(xyz, vec3( 0.055700, -0.204000,  1.057000)));
}

// Update spectral PDF ratios after a BSDF sample event and return the MIS weight scaling factor.
float update_spectral_pdf_ratios(inout Ray_state ray_state, Spectral_sample pdfs,
                                 bool specular, bool specular_dispersion)
{
    // main wavelength has been used for sampling, so MIS weight is
    // w = p[0] / sum(p) = 1 / (sum(p) / p[0])
    // for pdf p up to this point in the path

    // here we:
    // - update the pdf ratios
    // - compute the new weight
    // - return factor that changes from old to new weight

    if (specular && !specular_dispersion) // specular without dispersion: nothing to do
        return 1.0;

    if (!specular_dispersion && pdfs.values[0] <= 0.0) // this really has zero probablity
        return 0.0;

    float inv_w_old = 1.0;
    float inv_w_new = 1.0;
    const float inv_p0 = specular_dispersion ? 0.0 : (1.0 / pdfs.values[0]);
    for (int i = 1; i < MDL_DF_SPECTRAL_SAMPLES; ++i)
    {
        inv_w_old += ray_state.spectral_pdf_ratios[i - 1];
        ray_state.spectral_pdf_ratios[i - 1] *= pdfs.values[i] * inv_p0;
        inv_w_new += ray_state.spectral_pdf_ratios[i - 1];
    }

    return inv_w_old / inv_w_new;
}

// Return a Color_sample with all channels set to v.
Color_sample make_color_sample(float v)
{
    Color_sample s;
    for (int i = 0; i < MDL_DF_SPECTRAL_SAMPLES; ++i)
        s.values[i] = v;
    return s;
}

Color_sample addcc(Color_sample a, Color_sample b)
{
    Color_sample result;
    for (int i = 0; i < MDL_DF_SPECTRAL_SAMPLES; ++i)
        result.values[i] = a.values[i] + b.values[i];
    return result;
}

Color_sample mulcc(Color_sample a, Color_sample b)
{
    Color_sample result;
    for (int i = 0; i < MDL_DF_SPECTRAL_SAMPLES; ++i)
        result.values[i] = a.values[i] * b.values[i];
    return result;
}

Color_sample mulcf(Color_sample a, float b)
{
    Color_sample result;
    for (int i = 0; i < MDL_DF_SPECTRAL_SAMPLES; ++i)
        result.values[i] = a.values[i] * b;
    return result;
}

#define rgb_to_color(rgb, is_emission) \
    rgb_to_spectral((rgb), ray_state.spectral_wavelengths, (is_emission))

#define color_to_rgb(col, is_reflectivity) \
    spectral_to_rgb((col), ray_state.spectral_wavelengths, (is_reflectivity))

#define get_main_pdf(pdf) ((pdf).values[0])

#else

// Return a Color_sample with all channels set to v.
Color_sample make_color_sample(float v)
{
    return vec3(v);
}

Color_sample addcc(Color_sample a, Color_sample b)
{
    return a + b;
}

Color_sample mulcc(Color_sample a, Color_sample b)
{
    return a * b;
}

Color_sample mulcf(Color_sample a, float b)
{
    return a * b;
}

#define rgb_to_color(rgb, is_emission) (rgb)

#define color_to_rgb(col, is_reflectivity) (col)

#define get_main_pdf(pdf) (pdf)

#endif // MDL_SPECTRAL_RENDERING


