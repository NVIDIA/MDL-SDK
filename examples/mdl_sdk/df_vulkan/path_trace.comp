//-------------------------------------------------------------------------------------------------
// random number generator based on the Optix SDK
//-------------------------------------------------------------------------------------------------
uint tea(uint N, uint val0, uint val1)
{
    uint v0 = val0;
    uint v1 = val1;
    uint s0 = 0;

    for (uint n = 0; n < N; n++)
    {
        s0 += 0x9e3779b9;
        v0 += ((v1 << 4) + 0xa341316c) ^ (v1 + s0) ^ ((v1 >> 5) + 0xc8013ea4);
        v1 += ((v0 << 4) + 0xad90777d) ^ (v0 + s0) ^ ((v0 >> 5) + 0x7e95761e);
    }

    return v0;
}

// Generate random uint in [0, 2^24)
uint lcg(inout uint prev)
{
    const uint LCG_A = 1664525u;
    const uint LCG_C = 1013904223u;
    prev = (LCG_A * prev + LCG_C);
    return prev & 0x00FFFFFF;
}

// Generate random float in [0, 1)
float rnd(inout uint prev)
{
    return float(lcg(prev)) / float(0x01000000);
}


//-------------------------------------------------------------------------------------------------
// environment map importance sampling
//-------------------------------------------------------------------------------------------------
vec3 environment_evaluate(vec3 normalized_dir, out float pdf)
{
    // assuming lat long
    float u = atan(normalized_dir.z, normalized_dir.x) * 0.5 * M_ONE_OVER_PI + 0.5;
    u -= uEnvironmentRotation;
    if (u < 0.0f)
        u += 1.0f;
    const float v = acos(-normalized_dir.y) * M_ONE_OVER_PI;

    // get radiance and calculate pdf
    vec3 t = textureLod(uEnvironmentMap, vec2(u, v), /*lod=*/0).xyz;
    pdf = max(t.x, max(t.y, t.z)) * uEnvironmentInvIntegral;
    return t * uEnvironmentIntensityFactor;
}

vec3 environment_sample(inout uint seed, out vec3 to_light, out float pdf)
{
    vec3 xi = vec3(rnd(seed), rnd(seed), rnd(seed));

    // importance sample an envmap pixel using an alias map
    ivec2 tex_size = textureSize(uEnvironmentMap, /*lod=*/0);
    const uint size = tex_size.x * tex_size.y;
    const uint idx = min(uint(xi.x * float(size)), size - 1);
    uint env_idx;
    float xi_y = xi.y;
    if (xi_y < uEnvMapSampleData[idx].q)
    {
        env_idx = idx;
        xi_y /= uEnvMapSampleData[idx].q;
    }
    else
    {
        env_idx = uEnvMapSampleData[idx].alias;
        xi_y = (xi_y - uEnvMapSampleData[idx].q) / (1.0 - uEnvMapSampleData[idx].q);
    }

    const uint py = env_idx / tex_size.x;
    const uint px = env_idx % tex_size.x;

    // uniformly sample spherical area of pixel
    const float u = float(px + xi_y) / float(tex_size.x);
    float u_rot = u + uEnvironmentRotation;
    if (u_rot > 1.0f)
        u_rot -= 1.0f;
    const float phi = u_rot * 2.0 * M_PI - M_PI;
    const float sin_phi = sin(phi);
    const float cos_phi = cos(phi);
    const float step_theta = M_PI / float(tex_size.y);
    const float theta0 = float(py) * step_theta;
    const float cos_theta = cos(theta0) * (1.0 - xi.z) + cos(theta0 + step_theta) * xi.z;
    const float theta = acos(cos_theta);
    const float sin_theta = sin(theta);
    to_light = vec3(cos_phi * sin_theta, -cos_theta, sin_phi * sin_theta);

    // lookup filtered beauty
    const float v = theta * M_ONE_OVER_PI;
    const vec4 t = textureLod(uEnvironmentMap, vec2(u, v), /*lod=*/0);
    pdf = max(t.x, max(t.y, t.z)) * uEnvironmentInvIntegral;
    return vec3(t.x, t.y, t.z) * uEnvironmentIntensityFactor;
}

vec3 sample_lights(State state, inout uint seed, out vec3 to_light, out float light_pdf)
{
    float p_select_light = 1.0;

    if (uPointLightIntensity > 0.0)
    {
        p_select_light = uEnvironmentIntensityFactor > 0.0 ? 0.5 : 1.0;

        if (rnd(seed) <= p_select_light)
        {
            light_pdf = DIRAC; // infinity

            to_light = uPointLightPos - state.position;
            const float inv_distance2 = 1.0 / dot(to_light, to_light);
            to_light *= sqrt(inv_distance2);
            return uPointLightColor * uPointLightIntensity * inv_distance2 * 0.25 * M_ONE_OVER_PI / p_select_light;
        }

        // Probability to select the environment instead
        p_select_light = (1.0 - p_select_light);
    }

    vec3 radiance = environment_sample(seed, to_light, light_pdf);

    // Return radiance over pdf
    light_pdf *= p_select_light;
    return radiance / light_pdf;
}


// Intersects the unit sphere that is located at the world origin.
bool intersect_sphere(vec3 ray_origin, vec3 ray_dir, out Ray_hit_info out_info)
{
    const float sphere_radius = 1.0;
    const float a = dot(ray_dir, ray_dir);
    const float half_b = dot(ray_dir, ray_origin);
    const float c = dot(ray_origin, ray_origin) - sphere_radius * sphere_radius;
    const float discriminant = half_b * half_b - a * c;
    if (discriminant < 0.0)
        return false;

    const float sqrt_discr = sqrt(discriminant);
    float t = (-half_b - sqrt_discr) / a;
    if (t < 0.0)
        t = (-half_b + sqrt_discr) / a;

    if (t < 0.0)
        return false;

    out_info.dist = t;
    out_info.position = ray_origin + ray_dir * t;
    out_info.normal = normalize(out_info.position);

    const float phi = atan(out_info.normal.x, out_info.normal.z);
    const float theta = acos(out_info.normal.y);
    vec2 tex_coord = vec2(
        phi * M_ONE_OVER_PI + 1.0,
        uUvFlip != 0 ? theta * M_ONE_OVER_PI : 1.0 - theta * M_ONE_OVER_PI);
    tex_coord = tex_coord * uUvScale + uUvOffset;
    if (uUvRepeat != 0)
        tex_coord -= floor(tex_coord);
    if (uUvClamp != 0)
        tex_coord = clamp(tex_coord, 0.0, 1.0);
    out_info.tex_coord = vec3(tex_coord, 0.0);

    const float sin_phi = sin(phi);
    const float cos_phi = cos(phi);
    const float sin_theta = sin(theta);

    out_info.tangent_u = vec3(cos_phi * sin_theta, 0.0, -sin_phi * sin_theta) * M_PI * sphere_radius;
    out_info.tangent_u = normalize(out_info.tangent_u);

    out_info.tangent_v = vec3(sin_phi * out_info.normal.y, -sin_theta, cos_phi * out_info.normal.y) * -M_PI * sphere_radius;
    out_info.tangent_v = normalize(out_info.tangent_v);

    return true;
}

vec3 offset_ray(const vec3 p, const vec3 n)
{
    const float origin = 1.0 / 32.0;
    const float float_scale = 1.0 / 65536.0;
    const float int_scale = 256.0;
    const ivec3 of_i = ivec3(int_scale * n);

    vec3 p_i = vec3(intBitsToFloat(floatBitsToInt(p.x) + ((p.x < 0.0) ? -of_i.x : of_i.x)),
                    intBitsToFloat(floatBitsToInt(p.y) + ((p.y < 0.0) ? -of_i.y : of_i.y)),
                    intBitsToFloat(floatBitsToInt(p.z) + ((p.z < 0.0) ? -of_i.z : of_i.z)));

    return vec3(abs(p.x) < origin ? p.x + float_scale * n.x : p_i.x,
                abs(p.y) < origin ? p.y + float_scale * n.y : p_i.y,
                abs(p.z) < origin ? p.z + float_scale * n.z : p_i.z);
}

// Applies volume scattering and absorption.
//
// Scattering is implemented as random walk.
// The function returns true if a scattering event happened, in that case further evaluation has to
// be skipped and the next path segment needs to be traced.
bool handle_volume_events(inout Ray_state ray_state, in State state, float distance, inout uint seed)
{
#if defined(MDL_HAS_VOLUME_SCATTERING) || defined(MDL_HAS_VOLUME_ABSORPTION)
    #if defined(MDL_HAS_VOLUME_SCATTERING)
    const Color_sample s_coeff = mdl_volume_scattering_coefficient(state);
    #else
    const Color_sample s_coeff = make_color_sample(0.0);
    #endif

    #if defined(MDL_HAS_VOLUME_ABSORPTION)
    const Color_sample a_coeff = mdl_volume_absorption_coefficient(state);
    #else
    const Color_sample a_coeff = make_color_sample(0.0);
    #endif

    #if defined(MDL_HAS_VOLUME_SCATTERING_DIRECTIONAL_BIAS)
    const float g = mdl_volume_scattering_directional_bias(state);
    #else
    const float g = 0.0;
    #endif

    const Color_sample t_coeff = addcc(a_coeff, s_coeff);

    // scatter only if we have non-zero scatter coefficients
    #if defined(MDL_SPECTRAL_RENDERING)
    bool do_scatter = false;
    for (uint i = 0; i < MDL_DF_SPECTRAL_SAMPLES && !do_scatter; ++i)
        do_scatter = s_coeff.values[i] > 0.0f;
    #else
    const bool do_scatter = s_coeff.x > 0.0f || s_coeff.y > 0.0 || s_coeff.z > 0.0f;
    #endif
    float survival_prob = 1.0f;
    if (do_scatter)
    {
        #if defined(MDL_SPECTRAL_RENDERING)
        const float sample_coeff = t_coeff.values[0];
        #else
        const float s_coeff_max = max(s_coeff.x, max(s_coeff.y, s_coeff.z));
        const float t_coeff_min = min(t_coeff.x, min(t_coeff.y, t_coeff.z));

        float sample_coeff = 0.0f;
        if (s_coeff_max <= t_coeff_min)
        {
            // can use common coefficient for distance importance sampling while keeping variance bounded
            sample_coeff = t_coeff_min;
        }
        else if (!has_flag(ray_state.flags, FLAG_SSS_R | FLAG_SSS_G | FLAG_SSS_B))
        {
            // switch to single color
            const float xi = rnd(seed);
            if (xi < (1.0 / 3.0))
            {
                add_flag(ray_state.flags, FLAG_SSS_R);
                ray_state.weight.x *= 3.0f;
                ray_state.weight.y = 0.0f;
                ray_state.weight.z = 0.0f;
            }
            else if (xi < (2.0 / 3.0))
            {
                add_flag(ray_state.flags, FLAG_SSS_G);
                ray_state.weight.x = 0.0f;
                ray_state.weight.y *= 3.0f;
                ray_state.weight.z = 0.0f;
            }
            else
            {
                add_flag(ray_state.flags, FLAG_SSS_B);
                ray_state.weight.x = 0.0f;
                ray_state.weight.y = 0.0f;
                ray_state.weight.z *= 3.0f;
            }
        }

        if (has_flag(ray_state.flags, FLAG_SSS_R))
            sample_coeff = t_coeff.x;
        else if (has_flag(ray_state.flags, FLAG_SSS_G))
            sample_coeff = t_coeff.y;
        else if (has_flag(ray_state.flags, FLAG_SSS_B))
            sample_coeff = t_coeff.z;
        #endif // MDL_SPECTRAL_RENDERING

        // sample travel distance in meters
        const float sampled_distance = -log(1.0 - rnd(seed)) / sample_coeff;

        // scattering event happened
        if (sampled_distance < distance)
        {
            // compute scattering position in scene units
            distance = sampled_distance;
            ray_state.origin += ray_state.dir * distance;

            // random direction, Henyey-Greenstein phase function
            float cosTheta;
            if (g < 0.001)
                cosTheta = 1.0 - 2.0 * rnd(seed);
            else
            {
                const float inner_term = (1.0 - g * g) / (1.0 - g + 2.0 * g * rnd(seed));
                cosTheta = (1.0 + g * g - inner_term * inner_term) / (2.0 * g);
            }
            const float phi = 2.0 * M_PI * rnd(seed);
            const float sinTheta = sqrt(1.0 - cosTheta * cosTheta);
            const float sinPhi = sin(phi);
            const float cosPhi = cos(phi);

            // Duff et al - "Building an Orthonormal Basis, Revisited"
            vec3 u, v;
            {
                const vec3 n = ray_state.dir;
                const float sign = (n.z >= 0.0f) ? 1.0f : -1.0f;
                const float a = -1.0f / (sign + n.z);
                const float b = n.x * n.y * a;
                u = vec3(1.0f + sign * n.x * n.x * a, sign * b, -sign * n.x);
                v = vec3(b, sign + n.y * n.y * a, -n.y);
            }
            ray_state.dir = u * cosPhi * sinTheta + v * sinPhi * sinTheta + ray_state.dir * cosTheta;

            // apply scattering and volume attenuation
            // note, this is limited to uniform scattering for subsurface scattering
            // for non-uniform volume data, this is not sufficient
            #if defined(MDL_SPECTRAL_RENDERING)
            Spectral_sample pdfs;
            for (uint i = 0; i < MDL_DF_SPECTRAL_SAMPLES; ++i)
            {
                pdfs.values[i] = t_coeff.values[i] * exp(-t_coeff.values[i] * distance);
                if (i == 0)
                    ray_state.weight.values[i] *= s_coeff.values[i] / t_coeff.values[i];
                else
                    ray_state.weight.values[i] *= s_coeff.values[i] * exp(-t_coeff.values[i] * distance) / pdfs.values[0];
            }
            ray_state.weight = mulcf(ray_state.weight, update_spectral_pdf_ratios(ray_state, pdfs, false, false));
            #else
            float pdf_dist = sample_coeff * exp(-sample_coeff * distance);
            if (ray_state.weight.x > 0.0f)
                ray_state.weight.x *= s_coeff.x * exp(-t_coeff.x * distance) / pdf_dist;
            if (ray_state.weight.y > 0.0f)
                ray_state.weight.y *= s_coeff.y * exp(-t_coeff.y * distance) / pdf_dist;
            if (ray_state.weight.z > 0.0f)
                ray_state.weight.z *= s_coeff.z * exp(-t_coeff.z * distance) / pdf_dist;
            #endif // MDL_SPECTRAL_RENDERING

            // continue the ray into scattering direction
            return true;
        }

        // probability to reach the distance
        survival_prob = exp(-sample_coeff * distance);
    }

    // apply volume attenuation
    #if defined(MDL_SPECTRAL_RENDERING)
    Spectral_sample survival_probs;
    for (uint i = 0; i < MDL_DF_SPECTRAL_SAMPLES; ++i)
    {
        survival_probs.values[i] = exp(-t_coeff.values[i] * distance);
        if (ray_state.weight.values[i] > 0.0f)
            ray_state.weight.values[i] *= survival_probs.values[i] / survival_prob;
    }
    if (do_scatter)
        ray_state.weight = mulcf(ray_state.weight, update_spectral_pdf_ratios(ray_state, survival_probs, false, false));
    #else
    if (ray_state.weight.x > 0.0f)
        ray_state.weight.x *= exp(-t_coeff.x * distance) / survival_prob;
    if (ray_state.weight.y > 0.0f)
        ray_state.weight.y *= exp(-t_coeff.y * distance) / survival_prob;
    if (ray_state.weight.z > 0.0f)
        ray_state.weight.z *= exp(-t_coeff.z * distance) / survival_prob;
    #endif // MDL_SPECTRAL_RENDERING

#endif // defined(MDL_HAS_VOLUME_SCATTERING) || defined(MDL_HAS_VOLUME_ABSORPTION)
    return false;
}

State make_mdl_state(Ray_hit_info hit_info, Ray_state ray_state)
{
    const vec3 oriented_normal =
        has_flag(ray_state.flags, FLAG_INSIDE) ? -hit_info.normal : hit_info.normal;

    State state;
    state.normal = oriented_normal;
    state.geom_normal = oriented_normal;
    state.position = hit_info.position;
    state.animation_time = 0.0;
    state.text_coords[0] = hit_info.tex_coord;
    state.tangent_u[0] = hit_info.tangent_u;
    state.tangent_v[0] = hit_info.tangent_v;
#ifdef NUM_TEX_RESULTS
    // text_results is left uninitialized (populated by mdl_init)
#endif
    state.ro_data_segment_offset = 0;
    state.world_to_object = mat4(1.0);
    state.object_to_world = mat4(1.0);
    state.object_id = 0;
    state.meters_per_scene_unit = 1.0;
    state.arg_block_offset = 0;
#ifdef MDL_SPECTRAL_RENDERING
    state.spectral_wavelengths = ray_state.spectral_wavelengths;
#endif
    return state;
}


void trace_path(inout Ray_state ray_state, inout uint seed)
{
    uint sss_steps_left = MAX_SSS_STEPS;
    for (int bounce = 0; bounce < uMaxPathLength; bounce++)
    {
        Ray_hit_info hit_info;
        if (!intersect_sphere(ray_state.origin, ray_state.dir, hit_info))
        {
            // Ray missed
            float light_pdf;
            Color_sample light_radiance = rgb_to_color(
                environment_evaluate(ray_state.dir, light_pdf), true);

            // Incorporate point light selection probability
            if (uPointLightIntensity > 0.0)
                light_pdf *= 0.5;

            float mis_weight = ray_state.last_bsdf_pdf == DIRAC
                ? 1.0
                : ray_state.last_bsdf_pdf / (ray_state.last_bsdf_pdf + light_pdf);

            ray_state.contribution += color_to_rgb(
                mulcc(light_radiance, mulcf(ray_state.weight, mis_weight)), false);
            break;
        }

        // Ray hit the sphere
        remove_flag(ray_state.flags, FLAG_CAMERA_RAY);

        State state = make_mdl_state(hit_info, ray_state);

        // Handle cutout opacity
        float x_anyhit = rnd(seed);
        if (x_anyhit > mdl_standalone_cutout_opacity(state))
        {
            // Don't count this as a bounce
            bounce--;

            toggle_flag(ray_state.flags, FLAG_INSIDE);
            ray_state.origin = offset_ray(state.position, -state.geom_normal);

            continue;
        }

        // Pre-compute and cache data used by generated MDL *_sample, *_evaluate functions
        // NOTE: Would also cache data for cutout_opacity, but in this example we compile the
        //       cutout_opacity function standalone so no expensive pre-computation is done if
        //       the cutout opacity causes this hit to be ignored.
        mdl_init(state);

        const bool is_inside = has_flag(ray_state.flags, FLAG_INSIDE);
        const bool thin_walled = mdl_thin_walled(state);
        const bool is_backface = is_inside && thin_walled;
        const Color_sample ior1 = make_color_sample((is_inside && !thin_walled) ? BSDF_USE_MATERIAL_IOR : 1.0);
        const Color_sample ior2 = make_color_sample((is_inside && !thin_walled) ? 1.0 : BSDF_USE_MATERIAL_IOR);

        // Apply volume attenuation and scattering
        if (is_inside
            && !thin_walled
            && handle_volume_events(ray_state, state, hit_info.dist, seed))
        {
            // we enter this block if a scattering event happened

            // don't count volume scattering steps using the regular ray depth
            if (sss_steps_left > 0)
            {
                sss_steps_left--;
                bounce--;
                // continue tracing inside the volume
                continue;
            }
            break;
        }

        // Add emission
        Edf_evaluate_data edf_evaluate_data;
        edf_evaluate_data.k1 = -ray_state.dir;

        if (is_backface)
        {
            mdl_backface_edf_evaluate(edf_evaluate_data, state);
            const Color_sample emission_intensity = mdl_backface_emission_intensity(state);

            ray_state.contribution += color_to_rgb(
                mulcc(ray_state.weight, mulcc(emission_intensity, edf_evaluate_data.edf)), false);
        }
        else if (!is_inside)
        {
            mdl_edf_evaluate(edf_evaluate_data, state);
            const Color_sample emission_intensity = mdl_emission_intensity(state);

            ray_state.contribution += color_to_rgb(
                mulcc(ray_state.weight, mulcc(emission_intensity, edf_evaluate_data.edf)), false);
        }

#ifdef ENABLE_AUXILIARY
        // BSDF
        //
        // Output auxiliary data
        if (bounce == 0)
        {
            Bsdf_auxiliary_data bsdf_aux_data;
            bsdf_aux_data.ior1 = ior1;
            bsdf_aux_data.ior2 = ior2;
            bsdf_aux_data.k1 = -ray_state.dir;
            bsdf_aux_data.flags = uBsdfDataFlags;

            if (is_backface)
                mdl_backface_bsdf_auxiliary(bsdf_aux_data, state);
            else
                mdl_bsdf_auxiliary(bsdf_aux_data, state);

            ray_state.aux_albedo_diffuse += color_to_rgb(bsdf_aux_data.albedo_diffuse, true);
            ray_state.aux_albedo_glossy += color_to_rgb(bsdf_aux_data.albedo_glossy, true);
            ray_state.aux_normal += bsdf_aux_data.normal;
            ray_state.aux_roughness += bsdf_aux_data.roughness.xy;
            ray_state.aux_num_samples++;
        }
#endif

        // Sample lights
        if (bounce < uMaxPathLength - 1)
        {
            vec3 to_light;
            float light_pdf;
            vec3 light_radiance_over_pdf = sample_lights(state, seed, to_light, light_pdf);

            float offset_dir = sign(dot(state.geom_normal, to_light));
            vec3 shadow_ray_origin = offset_ray(state.position, state.geom_normal * offset_dir);

            Ray_hit_info shadow_hit;
            bool shadow_ray_hit = intersect_sphere(shadow_ray_origin, to_light, shadow_hit);
            float x_light_anyhit = rnd(seed);
            if (shadow_ray_hit)
            {
                State shadow_hit_state = make_mdl_state(shadow_hit, ray_state);
                shadow_ray_hit = (x_light_anyhit <= mdl_standalone_cutout_opacity(shadow_hit_state));
            }

            if (!shadow_ray_hit && light_pdf != 0.0)
            {
                Bsdf_evaluate_data bsdf_eval_data;
                bsdf_eval_data.ior1 = ior1;
                bsdf_eval_data.ior2 = ior2;
                bsdf_eval_data.k1 = -ray_state.dir;
                bsdf_eval_data.k2 = to_light;
                bsdf_eval_data.flags = uBsdfDataFlags;

                if (is_backface)
                    mdl_backface_bsdf_evaluate(bsdf_eval_data, state);
                else
                    mdl_bsdf_evaluate(bsdf_eval_data, state);

                if (get_main_pdf(bsdf_eval_data.pdf) > 0.0)
                {
                    const Color_sample bsdf =
                        addcc(bsdf_eval_data.bsdf_diffuse, bsdf_eval_data.bsdf_glossy);
                    const float mis_weight = (light_pdf == DIRAC)
                        ? 1.0
                        : light_pdf / (light_pdf + get_main_pdf(bsdf_eval_data.pdf));

                    ray_state.contribution += color_to_rgb(
                        mulcf(
                            mulcc(
                                mulcc(
                                    ray_state.weight,
                                    rgb_to_color(light_radiance_over_pdf, true)),
                                bsdf),
                            mis_weight),
                        false);
                }
            }
        }

        // Sample BSDF
        Bsdf_sample_data bsdf_sample_data;
        bsdf_sample_data.ior1 = ior1;
        bsdf_sample_data.ior2 = ior2;
        bsdf_sample_data.k1 = -ray_state.dir;
        bsdf_sample_data.xi = vec4(rnd(seed), rnd(seed), rnd(seed), rnd(seed));
        bsdf_sample_data.flags = uBsdfDataFlags;

        if (is_backface)
            mdl_backface_bsdf_sample(bsdf_sample_data, state);
        else
            mdl_bsdf_sample(bsdf_sample_data, state);

        if (bsdf_sample_data.event_type == BSDF_EVENT_ABSORB)
            break;

        // Continue path
        bool is_specular = (bsdf_sample_data.event_type & BSDF_EVENT_SPECULAR) != 0;
        bool is_transmission = (bsdf_sample_data.event_type & BSDF_EVENT_TRANSMISSION) != 0;

        if (is_transmission)
        {
            toggle_flag(ray_state.flags, FLAG_INSIDE);
            ray_state.origin = offset_ray(state.position, -state.geom_normal);
        }
        else
        {
            ray_state.origin = offset_ray(state.position, state.geom_normal);
        }

#ifdef MDL_SPECTRAL_RENDERING
        {
            bool specular_dispersion = false;
            if (is_specular && is_transmission && !thin_walled)
            {
                for (int si = 1; si < MDL_DF_SPECTRAL_SAMPLES; ++si)
                {
                    if (bsdf_sample_data.ior1.values[si] != bsdf_sample_data.ior1.values[0] ||
                        bsdf_sample_data.ior2.values[si] != bsdf_sample_data.ior2.values[0])
                    {
                        specular_dispersion = true;
                        break;
                    }
                }
            }

            float ratio_factor = update_spectral_pdf_ratios(
                ray_state, bsdf_sample_data.pdf, is_specular, specular_dispersion);
            ray_state.weight = mulcf(
                mulcc(ray_state.weight, bsdf_sample_data.bsdf_over_pdf),
                ratio_factor);
        }
#else
        ray_state.weight *= bsdf_sample_data.bsdf_over_pdf;
#endif
        ray_state.dir = bsdf_sample_data.k2;
        ray_state.last_bsdf_pdf = is_specular ? DIRAC : get_main_pdf(bsdf_sample_data.pdf);
    }
}


//-------------------------------------------------------------------------------------------------
// entry point
//-------------------------------------------------------------------------------------------------
void main()
{
    uvec2 image_size = uvec2(imageSize(uBeautyBuffer));
    if (gl_GlobalInvocationID.x >= image_size.x || gl_GlobalInvocationID.y >= image_size.y)
        return;

    vec3 contribution = vec3(0.0);
#ifdef ENABLE_AUXILIARY
    vec3 aux_albedo_diffuse = vec3(0.0);
    vec3 aux_albedo_glossy = vec3(0.0);
    vec3 aux_normal = vec3(0.0);
    vec2 aux_roughness = vec2(0.0);
    uint aux_num_samples = 0;
#endif

    for (uint iteration = 0; iteration < uSamplesPerIteration; iteration++)
    {
        uint seed = tea(
            16, /*magic (see OptiX path tracing example)*/
            gl_GlobalInvocationID.y * image_size.x + gl_GlobalInvocationID.x,
            uProgressiveIteration + iteration);

        vec2 resolution = vec2(image_size);
        vec2 jitter = vec2(rnd(seed), rnd(seed));
        vec2 uv = (vec2(gl_GlobalInvocationID.xy) + jitter) / resolution * 2.0 - 1.0;
        float aspect = resolution.y / resolution.x;

        vec3 ray_origin = uCamPos;
        vec3 ray_dir = normalize(uCamDir * uCamFocal + uCamRight * uv.x + uCamUp * uv.y * aspect);

        Ray_state ray_state;
        ray_state.contribution = vec3(0.0);
#ifdef ENABLE_AUXILIARY
        ray_state.aux_albedo_diffuse = vec3(0.0);
        ray_state.aux_albedo_glossy = vec3(0.0);
        ray_state.aux_normal = vec3(0.0);
        ray_state.aux_roughness = vec2(0.0);
        ray_state.aux_num_samples = 0;
#endif
        ray_state.weight = make_color_sample(1.0);
        ray_state.origin = ray_origin;
        ray_state.dir = ray_dir;
        ray_state.last_bsdf_pdf = DIRAC;
        ray_state.flags = FLAG_NONE;
#ifdef MDL_SPECTRAL_RENDERING
        {
            // uniform wavelength sampling across the configured wavelength range for this path
            float xi = rnd(seed);
            for (int i = 0; i < MDL_DF_SPECTRAL_SAMPLES; ++i)
            {
                xi += 1.0 / float(MDL_DF_SPECTRAL_SAMPLES);
                if (xi > 1.0) xi -= 1.0;
                ray_state.spectral_wavelengths.values[i] =
                    mix(uSpectralMinWavelength, uSpectralMaxWavelength, xi);
            }

            // initialize the spectral PDF ratios
            for (int i = 0; i < MDL_DF_SPECTRAL_SAMPLES - 1; ++i)
                ray_state.spectral_pdf_ratios[i] = 1.0;
        }
#endif

        if (dot(ray_origin, ray_origin) < 1.0)
            add_flag(ray_state.flags, FLAG_INSIDE);
        else
            remove_flag(ray_state.flags, FLAG_INSIDE);

        add_flag(ray_state.flags, FLAG_CAMERA_RAY);

        trace_path(ray_state, seed);

        // replace the background with a constant color when visible to the camera
        if (uBackgroundColorEnabled != 0 && has_flag(ray_state.flags, FLAG_CAMERA_RAY))
            contribution += uBackgroundColor;
        else
            contribution += ray_state.contribution;

#ifdef ENABLE_AUXILIARY
        aux_albedo_diffuse += ray_state.aux_albedo_diffuse;
        aux_albedo_glossy += ray_state.aux_albedo_glossy;
        aux_normal += ray_state.aux_normal;
        aux_roughness += ray_state.aux_roughness;
        aux_num_samples += ray_state.aux_num_samples;
#endif
    }

    contribution *= 1.0 / float(uSamplesPerIteration);

#ifdef ENABLE_AUXILIARY
    const float aux_weight = 1.0 / max(1.0, float(aux_num_samples));
    aux_albedo_diffuse *= aux_weight;
    aux_albedo_glossy *= aux_weight;
    if (dot(aux_normal, aux_normal) > 0.0)
        aux_normal = normalize(aux_normal);
    aux_roughness *= aux_weight;
#endif

    const ivec2 image_coord = ivec2(gl_GlobalInvocationID.xy);

    vec3 old_beauty = imageLoad(uBeautyBuffer, image_coord).xyz;
#ifdef ENABLE_AUXILIARY
    vec3 old_aux_albedo_diffuse = imageLoad(uAuxAlbedoDiffuseBuffer, image_coord).xyz;
    vec3 old_aux_albedo_glossy = imageLoad(uAuxAlbedoGlossyBuffer, image_coord).xyz;
    vec3 old_aux_normal = imageLoad(uAuxNormalBuffer, image_coord).xyz;
    vec2 old_aux_roughness = imageLoad(uAuxRoughnessBuffer, image_coord).xy;
#endif

    float blend_weight
        = float(uSamplesPerIteration) / float(uProgressiveIteration + uSamplesPerIteration);
    vec3 new_beauty = mix(old_beauty, contribution, blend_weight);
#ifdef ENABLE_AUXILIARY
    vec3 new_aux_albedo_diffuse = mix(old_aux_albedo_diffuse, aux_albedo_diffuse, blend_weight);
    vec3 new_aux_albedo_glossy = mix(old_aux_albedo_glossy, aux_albedo_glossy, blend_weight);
    vec3 new_aux_normal = mix(old_aux_normal, aux_normal, blend_weight);
    vec2 new_aux_roughness = mix(old_aux_roughness, aux_roughness, blend_weight);

    // Renormalize auxiliary normal
    if (dot(new_aux_normal, new_aux_normal) > 0.0)
        new_aux_normal = normalize(new_aux_normal);
#endif

    imageStore(uBeautyBuffer, image_coord, vec4(new_beauty, 0.0));
#ifdef ENABLE_AUXILIARY
    imageStore(uAuxAlbedoDiffuseBuffer, image_coord, vec4(new_aux_albedo_diffuse, 0.0));
    imageStore(uAuxAlbedoGlossyBuffer, image_coord, vec4(new_aux_albedo_glossy, 0.0));
    imageStore(uAuxNormalBuffer, image_coord, vec4(new_aux_normal, 0.0));
    imageStore(uAuxRoughnessBuffer, image_coord, vec4(new_aux_roughness, 0.0, 0.0));
#endif
}
