mdl 1.10;

import ::df::*;

/* add backscatter parameter in 1.11 */
export material test_specular_bsdf(
) = material(
    surface: material_surface(
        scattering: df::specular_bsdf(
        )
    )
);

/* add backscatter parameter in 1.11 */
export material test_simple_glossy_bsdf(
) = material(
    surface: material_surface(
        scattering: df::simple_glossy_bsdf(
            roughness_u: 1.0f
        )
    )
);

/* add backscatter parameter in 1.11 */
export material test_microfacet_beckmann_smith_bsdf(
) = material(
    surface: material_surface(
        scattering: df::microfacet_beckmann_smith_bsdf(
            roughness_u: 1.0f
        )
    )
);

/* add backscatter parameter in 1.11 */
export material test_microfacet_ggx_smith_bsdf(
) = material(
    surface: material_surface(
        scattering: df::microfacet_ggx_smith_bsdf(
            roughness_u: 1.0f
        )
    )
);

/* add backscatter parameter in 1.11 */
export material test_microfacet_beckmann_vcavities_bsdf(
) = material(
    surface: material_surface(
        scattering: df::microfacet_beckmann_vcavities_bsdf(
            roughness_u: 1.0f
        )
    )
);

/* add backscatter parameter in 1.11 */
export material test_microfacet_ggx_vcavities_bsdf(
) = material(
    surface: material_surface(
        scattering: df::microfacet_ggx_vcavities_bsdf(
            roughness_u: 1.0f
        )
    )
);

/* add backscatter parameter in 1.11 */
export material test_fresnel_factor(
) = material(
    surface: material_surface(
        scattering: df::fresnel_factor(
            ior: color(1.0f, 1.0f, 1.0f),
            extinction_coefficient: color(1.0f, 1.0f, 1.0f)
        )
    )
);

/* add backscatter parameter in 1.11 */
export material test_directional_factor_bsdf(
) = material(
    surface: material_surface(
        scattering: df::directional_factor(
            base: bsdf()
        )
    )
);

/* add backscatter parameter in 1.11 */
export material test_directional_factor_edf(
) = material(
    surface: material_surface(
        emission: material_emission(
            emission: df::directional_factor(
                base: edf()
            )
        )
    )
);

/* add backscatter parameter in 1.11 */
export material test_measured_curve_factor(
) = material(
    surface: material_surface(
        scattering: df::measured_curve_factor(
            curve_values: color[](color(1.0f, 1.0f, 1.0f))
        )
    )
);

/* add backscatter parameter in 1.11 */
export material test_measured_factor(
) = material(
    surface: material_surface(
        scattering: df::measured_factor(
            values: texture_2d()
        )
    )
);

/* add backscatter parameter in 1.11 */
export material test_fresnel_layer(
) = material(
    surface: material_surface(
        scattering: df::fresnel_layer(
            ior: 1.0f
        )
    )
);

/* add backscatter parameter in 1.11 */
export material test_color_fresnel_layer(
) = material(
    surface: material_surface(
        scattering: df::color_fresnel_layer(
            ior: color(1.0f, 1.0f, 1.0f)
        )
    )
);

/* add backscatter parameter in 1.11 */
export material test_custom_curve_layer(
) = material(
    surface: material_surface(
        scattering: df::custom_curve_layer(
            normal_reflectivity: 1.0f
        )
    )
);

