mdl 1.8;

import ::df::*;
import ::scene::*;

// Material used by test_distilled_scene_data to verify that referenced scene data
// names are preserved on ICompiled_material after distilling (MDL-1780).
export material md_geomprop() = material(
    surface: material_surface(
        scattering: df::diffuse_reflection_bsdf(
            tint: color(scene::data_lookup_float3("CUSTOM_GEOMPROP", float3(0.0)))
        )
    )
);
