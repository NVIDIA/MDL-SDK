        _)
        --> matched_bsdf [[ type = type1,
                                  c_c = c_c1, c_ru = c_ru1, c_rv = c_rv1, c_t = c_t1, c_w0 = c_w01, c_w90 = c_w901,c_n = c_n1,
                                  g_c0 = g_c01, g_c90 = g_c901, g_ru = g_ru1, g_rv = g_rv1, g_t = g_t1, g_w0 = g_w01, g_w90 = g_w901, g_e = g_e1, g_n = g_n1,
                                  gt_c = gt_c1, gt_w = gt_w1, gt_ior = gt_ior1,
                                  d_c = d_c1,d_w = d_w1, dt_c = dt_c1, dt_w = dt_w1, b_n = b_n1,
                                  r_c = r_c1, r_r = r_r1, r_w = r_w1, is_sheen = s1, r_ms_base = r_ms_base1, r_ms_d_c = r_ms_d_c1, r_ms_dt_c = r_ms_dt_c1, r_ms_dt_w = r_ms_dt_w1, r_ms_b_n = r_ms_b_n1]];

    //dielectric, faloff with special e in the glossy
    matched_bsdf ~ custom_curve_layer(w0,w90,_,w,
        _[[  type ~ type1,
                                  c_c ~ c_c1, c_ru ~ c_ru1, c_rv ~ c_rv1, c_t ~ c_t1, c_w0 ~ c_w01, c_w90 ~ c_w901, c_n ~ c_n1, //coat
                                  g_c0 ~ g_c01, g_c90 ~ g_c901, g_ru ~ g_ru1, g_rv ~ g_rv1, g_t ~ g_t1, g_w0, g_w90 , g_e ~ g_e1, g_n, //glossy
                                  gt_c, gt_w, //glass
                                  d_c, d_w, dt_c, dt_w, b_n, //diffuse
                                  r_c , r_r, r_w]],
        _[[  type ~ type2,
                                  c_c , c_ru , c_rv , c_t, c_w0, c_w90, c_n , //coat
                                  g_c0, g_c90, g_ru, g_rv, g_t, g_w0, g_w90, g_n, //glossy
                                  gt_c ~gt_c2, gt_w ~gt_w2 ,  gt_ior ~ gt_ior1,//glass
                                  d_c ~ d_c2, d_w ~ d_w2, dt_c ~ dt_c2, dt_w ~ dt_w2, b_n ~ b_n2, //diffuse
                                  r_c ~r_c2, r_r ~r_r2, r_w ~ r_w2, is_sheen ~ s2, r_ms_base ~ r_ms_base2, r_ms_d_c ~ r_ms_d_c2, r_ms_dt_c ~ r_ms_dt_c2, r_ms_dt_w ~ r_ms_dt_w2, r_ms_b_n ~ r_ms_b_n2]],
        n)
        --> matched_bsdf [[ type = "dielectric",
                                  c_c = c_c1, c_ru = c_ru1, c_rv = c_rv1, c_t = c_t1, c_w0 = c_w01, c_w90 = c_w901,c_n = c_n1,
                                  g_c0 = g_c01, g_c90 = g_c901, g_ru = g_ru1, g_rv = g_rv1, g_t = g_t1, g_w0 = w0*w, g_w90 = w90*w, g_e = g_e1, g_n = n,
                                  gt_c = gt_c2, gt_w = gt_w2, gt_ior = gt_ior1,
                                  d_c = d_c2,d_w = d_w2, dt_c = dt_c2, dt_w = dt_w2, b_n = b_n2,
                                  r_c = r_c2, r_r = r_r2, r_w = r_w2, is_sheen = s2, r_ms_base = r_ms_base2, r_ms_d_c = r_ms_d_c2, r_ms_dt_c = r_ms_dt_c2, r_ms_dt_w = r_ms_dt_w2, r_ms_b_n = r_ms_b_n2]]
        if ( type2 == "diffuse" ) && ( type1 == "metal" ) && ( g_e1 != 5.0);


    //dielectric, heuristik: if reflection roughness does not match transmission roughness, bias towards transmission roughness
    matched_bsdf ~ custom_curve_layer(w0,w90,e,w,
        _[[  type ~ type1,
                                  c_c ~ c_c1, c_ru ~ c_ru1, c_rv ~ c_rv1, c_t ~ c_t1, c_w0 ~ c_w01, c_w90 ~ c_w901, c_n ~ c_n1, //coat
                                  g_c0 ~ g_c01, g_c90 ~ g_c901, g_ru ~ g_ru1, g_rv ~ g_rv1, g_t ~ g_t1, g_w0, g_w90 , g_e , g_n, //glossy
                                  gt_c, gt_w, //glass
                                  d_c, d_w, dt_c, dt_w, b_n, //diffuse
                                  r_c , r_r, r_w]],
        _[[  type ~ type2,
                                  c_c , c_ru , c_rv , c_t, c_w0, c_w90, c_n , //coat
                                  g_c0, g_c90, g_ru ~ g_ru2, g_rv ~ g_rv2, g_t, g_w0, g_w90, g_n, //glossy
                                  gt_c ~gt_c2, gt_w ~gt_w2 ,  gt_ior ~ gt_ior1,//glass
                                  d_c ~ d_c2, d_w ~ d_w2, dt_c ~ dt_c2, dt_w ~ dt_w2, b_n ~ b_n2, //diffuse
                                  r_c ~r_c2, r_r ~r_r2, r_w ~ r_w2, is_sheen ~ s2, r_ms_base ~ r_ms_base2, r_ms_d_c ~ r_ms_d_c2, r_ms_dt_c ~ r_ms_dt_c2, r_ms_dt_w ~ r_ms_dt_w2, r_ms_b_n ~ r_ms_b_n2]],
        n)
        --> matched_bsdf [[ type = "dielectric",
                                  c_c = c_c1, c_ru = c_ru1, c_rv = c_rv1, c_t = c_t1, c_w0 = c_w01, c_w90 = c_w901,c_n = c_n1,
                                  g_c0 = g_c01, g_c90 = g_c901, g_ru = math::lerp(g_ru1, g_ru2, math::sqrt(gt_w2)), g_rv = math::lerp(g_rv1, g_rv2, math::sqrt(gt_w2)), g_t = g_t1, g_w0 = w0*w, g_w90 = w90*w, g_e = e, g_n = n,
                                  gt_c = gt_c2, gt_w = gt_w2, gt_ior = gt_ior1,
                                  d_c = d_c2,d_w = d_w2, dt_c = dt_c2, dt_w = dt_w2, b_n = b_n2,
                                  r_c = r_c2, r_r = r_r2, r_w = r_w2, is_sheen = s2, r_ms_base = r_ms_base2, r_ms_d_c = r_ms_d_c2, r_ms_dt_c = r_ms_dt_c2, r_ms_dt_w = r_ms_dt_w2, r_ms_b_n = r_ms_b_n2]]
        if ( (type2 == "diffuse" ) || (type2 == "retroreflective" ) || (type2 == "diffuse_retro" ))&& ( type1 == "metal" );

// double glossy that is really a directional blend
    matched_bsdf ~ custom_curve_layer(w0,w90,e,w,
        _[[  type ~ type1,
                                  c_c , c_ru , c_rv , c_t , c_w0 , c_w90, c_n, //coat
                                  g_c0 , g_c90 ~ g_c901, g_ru ~ g_ru1, g_rv ~ g_rv1, g_t ~ g_t1, g_w0, g_w90, g_n, //glossy
                                  gt_c, gt_w, //glass
                                  d_c, d_w, dt_c, dt_w, b_n, //diffuse
                                  r_c , r_r, r_w]],
        _[[  type ~ type2,
                                  c_c  , c_ru , c_rv , c_t, c_w0 , c_w90 , c_n , //coat
                                  g_c0 ~ g_c02, g_c90 , g_ru , g_rv , g_t , g_w0 , g_w90 , g_n ~ g_n2, //glossy
                                  gt_c , gt_w  , //glass
                                  d_c , d_w , dt_c , dt_w , b_n , //diffuse
                                  r_c , r_r , r_w ]],
        n)
        --> matched_bsdf [[ type = "metal",
                                  c_c = color(0.0), c_ru = 0.0, c_rv = 0.0, c_t = state::texture_tangent_u(0), c_w0 = 0.0, c_w90 = 0.0,c_n = state::normal(),
                                  g_c0 = g_c02,
                                  g_c90 = g_c901,
                                  g_ru = g_ru1, g_rv = g_rv1, g_t = g_t1, g_w0 = 1.0, g_w90 = 1.0, g_e = e,
                                  g_n = n,
                                  gt_c = color(0.0), gt_w = 0.0, gt_ior = color(1.0),
                                  d_c = color(0.0), d_w = 0.0, dt_c = color(0.0), dt_w = 0.0, b_n = state::normal(),
                                  r_c = color(0.0), r_r = 0.0, r_w = 0.0, is_sheen = false, r_ms_base = bsdf(), r_ms_d_c = color(0.0), r_ms_dt_c = color(0.0), r_ms_dt_w = 0.0, r_ms_b_n = state::normal()]]
        if ( type2 == "metal") && ( type1 == "metal" ) && (w0 == 0.0) && (w90 == 1.0) && (w == 1.0) && (g_n2 == state::normal())
        debug_name "directional_blend"    
        ;

    // double glossy that is really a directional blend, here both glossy lobes have a normalmap
    matched_bsdf ~ custom_curve_layer(w0,w90,e,w,
        _[[  type ~ type1,
                                  c_c , c_ru , c_rv , c_t , c_w0 , c_w90, c_n, //coat
                                  g_c0 , g_c90 ~ g_c901, g_ru ~ g_ru1, g_rv ~ g_rv1, g_t ~ g_t1, g_w0, g_w90, g_n , //glossy
                                  gt_c, gt_w, //glass
                                  d_c, d_w, dt_c, dt_w, b_n, //diffuse
                                  r_c , r_r, r_w]],
        _[[  type ~ type2,
                                  c_c  , c_ru , c_rv , c_t, c_w0 , c_w90 , c_n , //coat
                                  g_c0 ~ g_c02, g_c90 , g_ru , g_rv , g_t , g_w0 , g_w90 , g_n ~ g_n2, //glossy
                                  gt_c , gt_w  , //glass
                                  d_c , d_w , dt_c , dt_w , b_n , //diffuse
                                  r_c , r_r , r_w ]],
        _)
        --> matched_bsdf [[ type = "metal",
                                  c_c = color(0.0), c_ru = 0.0, c_rv = 0.0, c_t = state::texture_tangent_u(0), c_w0 = 0.0, c_w90 = 0.0,c_n = state::normal(),
                                  g_c0 = g_c02,
                                  g_c90 = g_c901,
                                  g_ru = g_ru1, g_rv = g_rv1, g_t = g_t1, g_w0 = 1.0, g_w90 = 1.0, g_e = e,
                                  g_n = g_n2,
                                  gt_c = color(0.0), gt_w = 0.0, gt_ior = color(1.0),
                                  d_c = color(0.0), d_w = 0.0, dt_c = color(0.0), dt_w = 0.0, b_n = state::normal(),
                                  r_c = color(0.0), r_r = 0.0, r_w = 0.0, is_sheen = false, r_ms_base = bsdf(), r_ms_d_c = color(0.0), r_ms_dt_c = color(0.0), r_ms_dt_w = 0.0, r_ms_b_n = state::normal()]]
        if ( type2 == "metal") && ( type1 == "metal" ) && (w0 == 0.0) && (w90 == 1.0) && (w == 1.0) && (e == 0.5) ;

    //directional factor like
    matched_bsdf ~ custom_curve_layer(w0,w90,e,w,
        _[[  type ~ type1,
                                  c_c , c_ru ~ c_ru1, c_rv ~ c_rv1, c_t ~ c_t1 , c_w0 ~ c_w01, c_w90 ~ c_w901, c_n ~ c_n1, //coat
                                  g_c0, g_c90 ~ g_c901, g_ru ~ g_ru1, g_rv ~ g_rv1, g_t ~ g_t1, g_w0~ g_w01, g_w90~ g_w901, g_n~ g_n1, //glossy
                                  gt_c, gt_w ~ gt_w1, gt_ior ~ gt_ior1, //glass
                                  d_c, d_w ~ d_w1, dt_c, dt_w ~ dt_w1, b_n ~ b_n1, //diffuse
                                  r_c , r_r ~ r_r1, r_w ~ r_w1, is_sheen ~ s1, r_ms_base ~ r_ms_base1, r_ms_d_c ~ r_ms_d_c1, r_ms_dt_c ~ r_ms_dt_c1, r_ms_dt_w ~ r_ms_dt_w1, r_ms_b_n ~ r_ms_b_n1]],
        _[[  type,
                                  c_c ~ c_c2,  c_ru,  c_rv, c_t,   c_w0, c_w90, c_n , //coat
                                  g_c0 ~ g_c02, g_c90, g_ru, g_rv,  g_t,  g_w0,  g_w90, g_e, g_n, //glossy
                                  gt_c ~ gt_c2, gt_w, gt_ior,//glass
                                  d_c ~ d_c2,  d_w,  dt_c ~ dt_c2,  dt_w, b_n, //diffuse
                                  r_c ~  r_c2,  r_r,  r_w]],
        _)
        --> matched_bsdf [[ type = type1,
                                  c_c = c_c2,
                                  c_ru = c_ru1, c_rv = c_rv1, c_t = c_t1, c_w0 = c_w01, c_w90 = c_w901,c_n = c_n1,
                                  g_c0 = g_c02,
                                  g_c90 = g_c901,
                                  g_ru = g_ru1, g_rv = g_rv1, g_t = g_t1, g_w0 = g_w01, g_w90 = g_w901,
                                  g_e = e,
                                  g_n = g_n1,
                                  gt_c = gt_c2,
                                  gt_w = gt_w1, gt_ior = gt_ior1,
                                  d_c = d_c2,
                                  d_w = d_w1,
                                  dt_c = dt_c2,
                                  dt_w = dt_w1, b_n = b_n1,
                                  r_c = r_c2,
                                  r_r = r_r1, r_w = r_w1, is_sheen = s1, r_ms_base = r_ms_base1, r_ms_d_c = r_ms_d_c1, r_ms_dt_c = r_ms_dt_c1, r_ms_dt_w = r_ms_dt_w1, r_ms_b_n = r_ms_b_n1]]
        if (w0 == 0.0) && (w90 == 1.0) && (w == 1.0) && (e == 0.5) 
        debug_name "directional_factor_like"
        ;

    // double glossy
    matched_bsdf ~ custom_curve_layer(w0,w90,_,w,
        _[[  type ~ type1,
                                  c_c , c_ru , c_rv , c_t , c_w0 , c_w90, c_n, //coat
                                  g_c0 ~ g_c01, g_c90 , g_ru ~ g_ru1, g_rv ~ g_rv1, g_t ~ g_t1, g_w0, g_w90, g_n, //glossy
                                  gt_c, gt_w, //glass
                                  d_c, d_w, dt_c, dt_w, b_n, //diffuse
                                  r_c , r_r, r_w]],
        _[[  type ~ type2,
                                  c_c ~ c_c2 , c_ru , c_rv , c_t, c_w0 , c_w90 ~ c_w902, c_n , //coat
                                  g_c0 ~ g_c02, g_c90 ~ g_c902, g_ru ~ g_ru2, g_rv ~ g_rv2, g_t ~ g_t2, g_w0 ~g_w02, g_w90 ~g_w902, g_e ~ g_e2 , g_n ~g_n2, //glossy
                                  gt_c ~ gt_c2, gt_w ~gt_w2 , //glass
                                  d_c ~ d_c2, d_w ~ d_w2, dt_c ~ dt_c2, dt_w ~ dt_w2, b_n ~ b_n2, //diffuse
                                  r_c ~ r_c2, r_r ~ r_r2, r_w ~ r_w2, is_sheen ~ s2, r_ms_base ~ r_ms_base2, r_ms_d_c ~ r_ms_d_c2, r_ms_dt_c ~ r_ms_dt_c2, r_ms_dt_w ~ r_ms_dt_w2, r_ms_b_n ~ r_ms_b_n2]],
        n)
        --> matched_bsdf [[ type = "doubleglossy",
                                  c_c = g_c01, c_ru = g_ru1, c_rv = g_rv1, c_t = g_t1, c_w0 = w0*w, c_w90 = w90*w,c_n = n,
                                  g_c0 = g_c02,
                                  g_c90 = math::lerp(g_c902,c_c2,c_w902),
                                  g_ru = g_ru2, g_rv = g_rv2, g_t = g_t2, g_w0 = g_w02,
                                  g_w90 = c_w902 + (1.0-c_w902)*g_w902,
                                  g_e = g_e2,
                                  g_n = g_n2, gt_ior = color(1.0),
                                  gt_c = gt_c2, gt_w = gt_w2,
                                  d_c = d_c2, d_w = d_w2, dt_c = dt_c2, dt_w = dt_w2, b_n = b_n2,
                                  r_c = r_c2, r_r = r_r2, r_w = r_w2, is_sheen = s2, r_ms_base = r_ms_base2, r_ms_d_c = r_ms_d_c2, r_ms_dt_c = r_ms_dt_c2, r_ms_dt_w = r_ms_dt_w2, r_ms_b_n = r_ms_b_n2]]
        if ( type2 == "metal") && ( type1 == "metal" ) ;

    //coated dielectric, coated metal
    matched_bsdf ~ custom_curve_layer(w0,w90,_,w,
        _[[  type ~ type1,
                                  c_c , c_ru , c_rv , c_t , c_w0 , c_w90, c_n, //coat
                                  g_c0 ~ g_c01, g_c90 , g_ru ~ g_ru1, g_rv ~ g_rv1, g_t ~ g_t1, g_w0, g_w90, g_n, //glossy
                                  gt_c, gt_w, //glass
                                  d_c, d_w, dt_c, dt_w, b_n, //diffuse
                                  r_c , r_r, r_w]],
        _[[  type ~ type2,
                                  c_c , c_ru , c_rv , c_t, c_w0, c_w90, c_n , //coat
                                  g_c0 ~ g_c02, g_c90 ~ g_c902, g_ru ~ g_ru2, g_rv ~ g_rv2, g_t ~ g_t2, g_w0 ~g_w02, g_w90 ~g_w902, g_e ~ g_e2 , g_n ~g_n2, //glossy
                                  gt_c ~ gt_c2, gt_w ~ gt_w2 , gt_ior ~ gt_ior1,//glass
                                  d_c ~ d_c2, d_w ~ d_w2, dt_c ~ dt_c2, dt_w ~ dt_w2, b_n ~ b_n2, //diffuse
                                  r_c ~ r_c2, r_r ~ r_r2, r_w ~ r_w2, is_sheen ~ s2, r_ms_base ~ r_ms_base2, r_ms_d_c ~ r_ms_d_c2, r_ms_dt_c ~ r_ms_dt_c2, r_ms_dt_w ~ r_ms_dt_w2, r_ms_b_n ~ r_ms_b_n2]],
        n)
        --> matched_bsdf [[ type = "coated",
                                  c_c = g_c01, c_ru = g_ru1, c_rv = g_rv1, c_t = g_t1, c_w0 = w0*w, c_w90 = w90*w,c_n = n,
                                  g_c0 = g_c02, g_c90 = g_c902, g_ru = g_ru2, g_rv = g_rv2, g_t = g_t2, g_w0 = g_w02, g_w90 = g_w902, g_e = g_e2, g_n = g_n2,
                                  gt_c = gt_c2, gt_w = gt_w2, gt_ior = gt_ior1,
                                  d_c = d_c2, d_w = d_w2, dt_c = dt_c2, dt_w = dt_w2, b_n = b_n2,
                                  r_c = r_c2, r_r = r_r2, r_w = r_w2, is_sheen = s2, r_ms_base = r_ms_base2, r_ms_d_c = r_ms_d_c2, r_ms_dt_c = r_ms_dt_c2, r_ms_dt_w = r_ms_dt_w2, r_ms_b_n = r_ms_b_n2]]
        if ( (type2 == "dielectric") || (type2 == "metalrough"))  && ( type1 == "metal" );

    //double coat, push 1st coat into glossy
    matched_bsdf ~ custom_curve_layer(w0,w90,_,w,
        _[[  type ~ type1,
                                  c_c , c_ru , c_rv , c_t , c_w0 , c_w90, c_n, //coat
                                  g_c0 ~ g_c01, g_c90 , g_ru ~ g_ru1, g_rv ~ g_rv1, g_t ~ g_t1, g_w0, g_w90, g_n, //glossy
                                  gt_c, gt_w, //glass
                                  d_c, d_w, dt_c, dt_w, b_n, //diffuse
                                  r_c , r_r, r_w]],
        _[[  type ~ type2,
                                  c_c  ~ c_c2,  c_ru  ~ c_ru2,  c_rv ~ c_rv2,  c_w0 ~ c_w02, c_w90 ~ c_w902, g_e ~ g_e2 ,c_n ~c_n2, //coat
                                  g_c0 ~ g_c02, g_c90 ~ g_c902, g_ru ~ g_ru2, g_rv ~ g_rv2, g_t  ~ g_t2,  g_w0  ~ g_w02,  g_w90 ~ g_w902, g_n, //glossy
                                  gt_c ~ gt_c2, gt_w  ~ gt_w2 ,  gt_ior ~ gt_ior1,//glass
                                  d_c  ~ d_c2, d_w ~ d_w2,  dt_c ~ dt_c2,  dt_w ~ dt_w2, b_n  ~ b_n2, //diffuse
                                  r_c  ~ r_c2,  r_r   ~ r_r2,   r_w  ~ r_w2, is_sheen ~ s2, r_ms_base ~ r_ms_base2, r_ms_d_c ~ r_ms_d_c2, r_ms_dt_c ~ r_ms_dt_c2, r_ms_dt_w ~ r_ms_dt_w2, r_ms_b_n ~ r_ms_b_n2]],
        n)
        --> matched_bsdf [[ type = "coated",
                                  c_c = g_c01, c_ru = g_ru1, c_rv = g_rv1, c_t = g_t1, c_w0 = w0*w, c_w90 = w90*w,c_n = n,
                                  g_c0 = nvidia::distilling_support::average(g_w02,g_c02,new_c_w02,new_c_c2), 
								  g_c90 = nvidia::distilling_support::average(g_w902,g_c902,new_c_w902,new_c_c2),
                                  g_ru = nvidia::distilling_support::average(math::max(g_w02,gt_w2),g_ru2,new_c_w02,c_ru2), 
								  g_rv = nvidia::distilling_support::average(math::max(g_w02,gt_w2),g_rv2,new_c_w02,c_rv2),
                                  g_t = g_t2, 
								  g_w0 = new_c_w02+g_w02*(1.0-new_c_w02), 
								  g_w90 = new_c_w902+g_w902*(1.0-new_c_w902), g_e = g_e2 ,g_n = c_n2,
                                  gt_c = gt_c2, gt_w = gt_w2, gt_ior = gt_ior1,
                                  d_c = d_c2, d_w = d_w2, dt_c = dt_c2, dt_w = dt_w2, b_n = b_n2,
                                  r_c = r_c2, r_r = r_r2, r_w = r_w2, is_sheen = s2, r_ms_base = r_ms_base2, r_ms_d_c = r_ms_d_c2, r_ms_dt_c = r_ms_dt_c2, r_ms_dt_w = r_ms_dt_w2, r_ms_b_n = r_ms_b_n2]]
        if  (type2 == "coated")   && ( type1 == "metal" )
		where
			new_c_c2 = c_c2/math::max(math::max_value(c_c2),0.001)
			new_c_w02 = c_w02*math::max_value(c_c2)
			new_c_w902 = c_w902*math::max_value(c_c2);

    //dielectric over retro (drivesimpbr) d_c1*((w0+w90)*0.5*w) or not?
    matched_bsdf ~ custom_curve_layer(w0,w90,_,w,
        _[[  type ~ type1,
                                  c_c ~ c_c1, c_ru ~ c_ru1, c_rv ~ c_rv1, c_t ~ c_t1, c_w0 ~ c_w01, c_w90 ~ c_w901, c_n ~ c_n1, //coat
                                  g_c0 ~ g_c01, g_c90 ~ g_c901, g_ru ~ g_ru1, g_rv ~ g_rv1, g_t ~ g_t1, g_w0 ~g_w01, g_w90 ~ g_w901,g_e ~ g_e1 , g_n ~g_n1, //glossy
                                  gt_c ~ gt_c1, gt_w ~ gt_w1,  gt_ior ~ gt_ior1,//glass
                                  d_c  ~ d_c1, d_w ~ d_w1,  dt_c  ~ dt_c1,  dt_w ~ dt_w1, b_n  ~ b_n1, //diffuse
                                  r_c , r_r, r_w]],
        _[[  type ~ type2,
                                  c_c  ,  c_ru  ,  c_rv , c_t,  c_w0 , c_w90 , c_n , //coat
                                  g_c0 , g_c90 , g_ru , g_rv , g_t  ,  g_w0  ,  g_w90 , g_n, //glossy
                                  gt_c , gt_w  , //glass
                                  d_c  , d_w ,  dt_c  ,  dt_w , b_n , //diffuse
                                  r_c  ~ r_c2,  r_r   ~ r_r2,   r_w  ~ r_w2, is_sheen ~ s2, r_ms_base ~ r_ms_base2, r_ms_d_c ~ r_ms_d_c2, r_ms_dt_c ~ r_ms_dt_c2, r_ms_dt_w ~ r_ms_dt_w2, r_ms_b_n ~ r_ms_b_n2]],
        _)
        --> matched_bsdf [[ type = type1,
                                  c_c = c_c1, c_ru = c_ru1, c_rv = c_rv1, c_t = c_t1, c_w0 = c_w01, c_w90 = c_w901,c_n = c_n1,
                                  g_c0 = g_c01, g_c90 = g_c901, g_ru = g_ru1, g_rv = g_rv1, g_t = g_t1, g_w0 = g_w01*w0*w, g_w90 = g_w901*w90*w, g_e = g_e1 , g_n = g_n1,
                                  gt_c = gt_c1, gt_w = gt_w1, gt_ior = gt_ior1,
                                  d_c = d_c1*((w0+w90)*0.5*w), d_w = d_w1, dt_c = dt_c1, dt_w = dt_w1, b_n = b_n1,
                                  r_c = r_c2, r_r = r_r2, r_w = r_w2*(1.0-(w*(w0+w90)*0.5)), is_sheen = s2, r_ms_base = r_ms_base2, r_ms_d_c = r_ms_d_c2, r_ms_dt_c = r_ms_dt_c2, r_ms_dt_w = r_ms_dt_w2, r_ms_b_n = r_ms_b_n2]]
         if  (type2 == "retroreflective");

    //coat anything
    matched_bsdf ~ custom_curve_layer(w0,w90,_,w,
        _[[  type ~ type1 ,
                                  c_c , c_ru , c_rv , c_t , c_w0 , c_w90, c_n, //coat
                                  g_c0 ~ g_c01, g_c90 , g_ru ~ g_ru1, g_rv ~ g_rv1, g_t ~ g_t1, g_w0, g_w90, g_n, //glossy
                                  gt_c, gt_w, //glass
                                  d_c, d_w, dt_c, dt_w, b_n, //diffuse
                                  r_c , r_r, r_w]],
        _[[  type,
                                  c_c ,  c_ru   ,  c_rv   , c_t,  c_w0 ~ c_w02 , c_w90 ~c_w902 , c_n , //coat
                                  g_c0 ~ g_c02, g_c90 ~ g_c902, g_ru ~ g_ru2, g_rv ~ g_rv2, g_t  ~ g_t2,  g_w0  ~ g_w02,  g_w90 ~ g_w902,g_e ~ g_e2 , g_n ~ g_n2, //glossy
                                  gt_c ~ gt_c2, gt_w  ~ gt_w2 ,  gt_ior ~ gt_ior1,//glass
                                  d_c  ~ d_c2, d_w ~ d_w2,  dt_c  ~ dt_c2,  dt_w ~ dt_w2, b_n  ~ b_n2, //diffuse
                                  r_c  ~ r_c2,  r_r   ~ r_r2,   r_w  ~ r_w2, is_sheen ~ s2, r_ms_base ~ r_ms_base2, r_ms_d_c ~ r_ms_d_c2, r_ms_dt_c ~ r_ms_dt_c2, r_ms_dt_w ~ r_ms_dt_w2, r_ms_b_n ~ r_ms_b_n2]],
        n)
        --> matched_bsdf [[ type = "unknown",
                                  c_c = g_c01, c_ru = g_ru1, c_rv = g_rv1, c_t = g_t1, c_w0 = w0*w, c_w90 = w90*w,c_n = n,
                                  g_c0 = g_c02,
                                  g_c90 = g_c902,
                                  g_ru = g_ru2,
                                  g_rv = g_rv2,
                                  g_t = g_t2,
                                  g_w0 = g_w02,
                                  g_w90 = g_w902,
                                  
                                  g_e = g_e2 ,
                                  g_n = g_n2,
                                  gt_c = gt_c2, gt_w = gt_w2, gt_ior = gt_ior1,
                                  d_c = d_c2, d_w = d_w2, dt_c = dt_c2, dt_w = dt_w2, b_n = b_n2,
                                  r_c = r_c2, r_r = r_r2, r_w = r_w2, is_sheen = s2, r_ms_base = r_ms_base2, r_ms_d_c = r_ms_d_c2, r_ms_dt_c = r_ms_dt_c2, r_ms_dt_w = r_ms_dt_w2, r_ms_b_n = r_ms_b_n2]]
        if  (type1 == "metal") && (c_w02 == 0.0) && (c_w902 == 0.0)
            debug_name "coat anything thats uncoated" 
        ;

    //any other custom curve layer
    matched_bsdf ~ custom_curve_layer(w0,w90,_,w,
        _[[  type,
                                  c_c , c_ru , c_rv , c_t , c_w0 , c_w90, c_n, //coat
                                  g_c0 ~ g_c01, g_c90 , g_ru ~ g_ru1, g_rv ~ g_rv1, g_t ~ g_t1, g_w0, g_w90, g_n, //glossy
                                  gt_c, gt_w, //glass
                                  d_c, d_w, dt_c, dt_w, b_n, //diffuse
                                  r_c , r_r, r_w]],
        _[[  type,
                                  c_c  ~ c_c2,  c_ru  ~ c_ru2,  c_rv ~ c_rv2, c_t,  c_w0 ~ c_w02, c_w90 ~ c_w902, c_n , //coat
                                  g_c0 ~ g_c02, g_c90 ~ g_c902, g_ru ~ g_ru2, g_rv ~ g_rv2, g_t  ~ g_t2,  g_w0  ~ g_w02,  g_w90 ~ g_w902,g_e ~ g_e2 , g_n ~ g_n2, //glossy
                                  gt_c ~ gt_c2, gt_w  ~ gt_w2 ,  gt_ior ~ gt_ior1,//glass
                                  d_c  ~ d_c2, d_w ~ d_w2,  dt_c  ~ dt_c2,  dt_w ~ dt_w2, b_n  ~ b_n2, //diffuse
                                  r_c  ~ r_c2,  r_r   ~ r_r2,   r_w  ~ r_w2, is_sheen ~ s2, r_ms_base ~ r_ms_base2, r_ms_d_c ~ r_ms_d_c2, r_ms_dt_c ~ r_ms_dt_c2, r_ms_dt_w ~ r_ms_dt_w2, r_ms_b_n ~ r_ms_b_n2]],
        n)
        --> matched_bsdf [[ type = "unknown",
                                  c_c = g_c01, c_ru = g_ru1, c_rv = g_rv1, c_t = g_t1, c_w0 = w0*w, c_w90 = w90*w,c_n = n,
                                  g_c0 = nvidia::distilling_support::average(g_w02*(1.0-c_w02),g_c02,c_w02,c_c2),
                                  g_c90 = nvidia::distilling_support::average(g_w902*(1.0-c_w902),g_c902,c_w902,c_c2),
                                  g_ru = nvidia::distilling_support::average(math::max(g_w02,gt_w2)*(1.0-c_w02),g_ru2,c_w02,c_ru2),
                                  g_rv = nvidia::distilling_support::average(math::max(g_w02,gt_w2)*(1.0-c_w02),g_rv2,c_w02,c_rv2),


                                  g_t = g_t2,
                                  g_w0 = c_w02+g_w02*(1.0-c_w02),
                                  g_w90 = c_w902+g_w902*(1.0-c_w902),
                                  g_e = g_e2 ,
                                  g_n = g_n2,//math::normalize(math::lerp(g_n2,n,w)),
                                  gt_c = gt_c2, gt_w = gt_w2, gt_ior = gt_ior1,
                                  d_c = d_c2, d_w = d_w2, dt_c = dt_c2, dt_w = dt_w2, b_n = b_n2,
                                  r_c = r_c2, r_r = r_r2, r_w = r_w2, is_sheen = s2, r_ms_base = r_ms_base2, r_ms_d_c = r_ms_d_c2, r_ms_dt_c = r_ms_dt_c2, r_ms_dt_w = r_ms_dt_w2, r_ms_b_n = r_ms_b_n2]]
        debug_name "any other custom curve layer"                          
        ;

    // Tinted glass
    // In case we created the tint to indicate a scatter_transmit microfacet BSDF, we
	// translate a reflection tint of 0.0 into a weight of 0 to differentiate from a black lobe.
    matched_bsdf ~ bsdf_tint_ex(c1,c2, _[[  type ~ type1,
                                  c_c ~ c_c1, c_ru ~ c_ru1, c_rv ~ c_rv1, c_t ~ c_t1, c_w0 ~ c_w01, c_w90 ~ c_w901, c_n ~ c_n1, //coat
                                  g_c0 ~ g_c01, g_c90 ~ g_c901, g_ru ~ g_ru1, g_rv ~ g_rv1, g_t ~ g_t1, g_w0, g_w90,g_e ~ g_e1 , g_n ~ g_n1, //glossy
                                  gt_c ~ gt_c1, gt_w ~ gt_w1, gt_ior ~ gt_ior1,//glass
                                  d_c ~ d_c1, d_w ~ d_w1, dt_c ~ dt_c1, dt_w ~ dt_w1, b_n ~ b_n1, //diffuse
                                  r_c ~r_c1, r_r ~ r_r1, r_w ~ r_w1, is_sheen ~ s1, r_ms_base ~ r_ms_base1, r_ms_d_c ~ r_ms_d_c1, r_ms_dt_c ~ r_ms_dt_c1, r_ms_dt_w ~ r_ms_dt_w1, r_ms_b_n ~ r_ms_b_n1]])//retro
        --> matched_bsdf [[ type = type1,
                                  c_c = c_c1, c_ru = c_ru1, c_rv = c_rv1, c_t = c_t1, c_w0 = c_w01, c_w90 = c_w901,c_n = c_n1,
                                  g_c0 = g_c01, g_c90 = g_c901, g_ru = g_ru1, g_rv = g_rv1, g_t = g_t1, g_w0 = 0.0, g_w90 = 0.0,g_e = g_e1 , g_n = g_n1,
                                  gt_c = gt_c1 * c2, gt_w = gt_w1, gt_ior = gt_ior1,
                                  d_c = d_c1, d_w = d_w1, dt_c = dt_c1, dt_w = dt_w1, b_n = b_n1,
                                  r_c = r_c1, r_r = r_r1, r_w = r_w1, is_sheen = s1, r_ms_base = r_ms_base1, r_ms_d_c = r_ms_d_c1, r_ms_dt_c = r_ms_dt_c1, r_ms_dt_w = r_ms_dt_w1, r_ms_b_n = r_ms_b_n1]]
        if (c1 == color(0.0))
        debug_name "tinted glass (scatter_transmit BSDF)";

    //tinted glass
    matched_bsdf ~ bsdf_tint_ex(c1,c2, _[[  type ~ type1,
                                  c_c ~ c_c1, c_ru ~ c_ru1, c_rv ~ c_rv1, c_t ~ c_t1, c_w0 ~ c_w01, c_w90 ~ c_w901, c_n ~ c_n1, //coat
                                  g_c0 ~ g_c01, g_c90 ~ g_c901, g_ru ~ g_ru1, g_rv ~ g_rv1, g_t ~ g_t1, g_w0 ~ g_w01, g_w90 ~ g_w901,g_e ~ g_e1 , g_n ~ g_n1, //glossy
                                  gt_c ~ gt_c1, gt_w ~ gt_w1, gt_ior ~ gt_ior1,//glass
                                  d_c ~ d_c1, d_w ~ d_w1, dt_c ~ dt_c1, dt_w ~ dt_w1, b_n ~ b_n1, //diffuse
                                  r_c ~r_c1, r_r ~ r_r1, r_w ~ r_w1, is_sheen ~ s1, r_ms_base ~ r_ms_base1, r_ms_d_c ~ r_ms_d_c1, r_ms_dt_c ~ r_ms_dt_c1, r_ms_dt_w ~ r_ms_dt_w1, r_ms_b_n ~ r_ms_b_n1]])//retro
        --> matched_bsdf [[ type = type1,
                                  c_c = c_c1, c_ru = c_ru1, c_rv = c_rv1, c_t = c_t1, c_w0 = c_w01, c_w90 = c_w901,c_n = c_n1,
                                  g_c0 = g_c01 * c1, g_c90 = g_c901, g_ru = g_ru1, g_rv = g_rv1, g_t = g_t1, g_w0 = g_w01, g_w90 = g_w901,g_e = g_e1 , g_n = g_n1,
                                  gt_c = gt_c1 * c2, gt_w = gt_w1, gt_ior = gt_ior1,
                                  d_c = d_c1, d_w = d_w1, dt_c = dt_c1, dt_w = dt_w1, b_n = b_n1,
                                  r_c = r_c1, r_r = r_r1, r_w = r_w1, is_sheen = s1, r_ms_base = r_ms_base1, r_ms_d_c = r_ms_d_c1, r_ms_dt_c = r_ms_dt_c1, r_ms_dt_w = r_ms_dt_w1, r_ms_b_n = r_ms_b_n1]]
        ;

    // EDF leaf: diffuse emission -- full contribution weight
    diffuse_edf() --> diffuse_edf() [[ e_intensity = color(1.0) ]];

    // EDF leaf: spot emission -- full contribution weight
    spot_edf(exponent, spread, global_distribution)
        --> spot_edf(exponent, spread, global_distribution) [[ e_intensity = color(1.0) ]];

    // EDF leaf: measured emission -- full contribution weight
    measured_edf(tangent_u, contribution) --> measured_edf(tangent_u, contribution) [[ e_intensity = color(1.0) ]];

    // EDF leaf: empty -- no contribution
    edf() --> edf() [[ e_intensity = color(0.0) ]];

    // EDF modifier: tint -- scale weight by tint color
    edf_tint(tint, _[[ e_intensity ~ e_i1 ]])
        --> diffuse_edf() [[ e_intensity = tint * e_i1 ]];

    // EDF modifier: directional factor
    edf_directional_factor(tint_n, _tint_g, _exponent, _[[ e_intensity ~ e_i1 ]])
        --> diffuse_edf() [[ e_intensity = tint_n * e_i1 ]];

    // EDF combination: weighted mixes -- blend children's weights
    edf_mix_1(w1, _[[ e_intensity ~ e_i1 ]])
        --> diffuse_edf() [[ e_intensity = color(w1) * e_i1 ]];
    edf_mix_2(w1, _[[ e_intensity ~ e_i1 ]], w2, _[[ e_intensity ~ e_i2 ]])
        --> diffuse_edf() [[ e_intensity = color(w1) * e_i1 + color(w2) * e_i2 ]];
    edf_mix_3(w1, _[[ e_intensity ~ e_i1 ]], w2, _[[ e_intensity ~ e_i2 ]], w3, _[[ e_intensity ~ e_i3 ]])
        --> diffuse_edf() [[ e_intensity = color(w1) * e_i1 + color(w2) * e_i2 + color(w3) * e_i3 ]];
    edf_mix_4(w1, _[[ e_intensity ~ e_i1 ]], w2, _[[ e_intensity ~ e_i2 ]], w3, _[[ e_intensity ~ e_i3 ]], w4, _[[ e_intensity ~ e_i4 ]])
        --> diffuse_edf() [[ e_intensity = color(w1) * e_i1 + color(w2) * e_i2 + color(w3) * e_i3 + color(w4) * e_i4 ]];

    // EDF combination: clamped mixes
    edf_clamped_mix_1(w1, _[[ e_intensity ~ e_i1 ]])
        --> diffuse_edf() [[ e_intensity = color(w1) * e_i1 ]];
    edf_clamped_mix_2(w1, _[[ e_intensity ~ e_i1 ]], w2, _[[ e_intensity ~ e_i2 ]])
        --> diffuse_edf() [[ e_intensity = color(w1) * e_i1 + color(w2) * e_i2 ]];
    edf_clamped_mix_3(w1, _[[ e_intensity ~ e_i1 ]], w2, _[[ e_intensity ~ e_i2 ]], w3, _[[ e_intensity ~ e_i3 ]])
        --> diffuse_edf() [[ e_intensity = color(w1) * e_i1 + color(w2) * e_i2 + color(w3) * e_i3 ]];
    edf_clamped_mix_4(w1, _[[ e_intensity ~ e_i1 ]], w2, _[[ e_intensity ~ e_i2 ]], w3, _[[ e_intensity ~ e_i3 ]], w4, _[[ e_intensity ~ e_i4 ]])
        --> diffuse_edf() [[ e_intensity = color(w1) * e_i1 + color(w2) * e_i2 + color(w3) * e_i3 + color(w4) * e_i4 ]];

    // EDF combination: unbounded mixes
    edf_unbounded_mix_1(w1, _[[ e_intensity ~ e_i1 ]])
        --> diffuse_edf() [[ e_intensity = color(w1) * e_i1 ]];
    edf_unbounded_mix_2(w1, _[[ e_intensity ~ e_i1 ]], w2, _[[ e_intensity ~ e_i2 ]])
        --> diffuse_edf() [[ e_intensity = color(w1) * e_i1 + color(w2) * e_i2 ]];
    edf_unbounded_mix_3(w1, _[[ e_intensity ~ e_i1 ]], w2, _[[ e_intensity ~ e_i2 ]], w3, _[[ e_intensity ~ e_i3 ]])
        --> diffuse_edf() [[ e_intensity = color(w1) * e_i1 + color(w2) * e_i2 + color(w3) * e_i3 ]];
    edf_unbounded_mix_4(w1, _[[ e_intensity ~ e_i1 ]], w2, _[[ e_intensity ~ e_i2 ]], w3, _[[ e_intensity ~ e_i3 ]], w4, _[[ e_intensity ~ e_i4 ]])
        --> diffuse_edf() [[ e_intensity = color(w1) * e_i1 + color(w2) * e_i2 + color(w3) * e_i3 + color(w4) * e_i4 ]];

    // EDF combination: color-weighted mixes
    edf_color_mix_1(w1, _[[ e_intensity ~ e_i1 ]])
        --> diffuse_edf() [[ e_intensity = w1 * e_i1 ]];
    edf_color_mix_2(w1, _[[ e_intensity ~ e_i1 ]], w2, _[[ e_intensity ~ e_i2 ]])
        --> diffuse_edf() [[ e_intensity = w1 * e_i1 + w2 * e_i2 ]];
    edf_color_mix_3(w1, _[[ e_intensity ~ e_i1 ]], w2, _[[ e_intensity ~ e_i2 ]], w3, _[[ e_intensity ~ e_i3 ]])
        --> diffuse_edf() [[ e_intensity = w1 * e_i1 + w2 * e_i2 + w3 * e_i3 ]];
    edf_color_mix_4(w1, _[[ e_intensity ~ e_i1 ]], w2, _[[ e_intensity ~ e_i2 ]], w3, _[[ e_intensity ~ e_i3 ]], w4, _[[ e_intensity ~ e_i4 ]])
        --> diffuse_edf() [[ e_intensity = w1 * e_i1 + w2 * e_i2 + w3 * e_i3 + w4 * e_i4 ]];

    // EDF combination: color-weighted clamped mixes
    edf_color_clamped_mix_1(w1, _[[ e_intensity ~ e_i1 ]])
        --> diffuse_edf() [[ e_intensity = w1 * e_i1 ]];
    edf_color_clamped_mix_2(w1, _[[ e_intensity ~ e_i1 ]], w2, _[[ e_intensity ~ e_i2 ]])
        --> diffuse_edf() [[ e_intensity = w1 * e_i1 + w2 * e_i2 ]];
    edf_color_clamped_mix_3(w1, _[[ e_intensity ~ e_i1 ]], w2, _[[ e_intensity ~ e_i2 ]], w3, _[[ e_intensity ~ e_i3 ]])
        --> diffuse_edf() [[ e_intensity = w1 * e_i1 + w2 * e_i2 + w3 * e_i3 ]];
    edf_color_clamped_mix_4(w1, _[[ e_intensity ~ e_i1 ]], w2, _[[ e_intensity ~ e_i2 ]], w3, _[[ e_intensity ~ e_i3 ]], w4, _[[ e_intensity ~ e_i4 ]])
        --> diffuse_edf() [[ e_intensity = w1 * e_i1 + w2 * e_i2 + w3 * e_i3 + w4 * e_i4 ]];

    // EDF combination: color-weighted unbounded mixes
    edf_color_unbounded_mix_1(w1, _[[ e_intensity ~ e_i1 ]])
        --> diffuse_edf() [[ e_intensity = w1 * e_i1 ]];
    edf_color_unbounded_mix_2(w1, _[[ e_intensity ~ e_i1 ]], w2, _[[ e_intensity ~ e_i2 ]])
        --> diffuse_edf() [[ e_intensity = w1 * e_i1 + w2 * e_i2 ]];
    edf_color_unbounded_mix_3(w1, _[[ e_intensity ~ e_i1 ]], w2, _[[ e_intensity ~ e_i2 ]], w3, _[[ e_intensity ~ e_i3 ]])
        --> diffuse_edf() [[ e_intensity = w1 * e_i1 + w2 * e_i2 + w3 * e_i3 ]];
    edf_color_unbounded_mix_4(w1, _[[ e_intensity ~ e_i1 ]], w2, _[[ e_intensity ~ e_i2 ]], w3, _[[ e_intensity ~ e_i3 ]], w4, _[[ e_intensity ~ e_i4 ]])
        --> diffuse_edf() [[ e_intensity = w1 * e_i1 + w2 * e_i2 + w3 * e_i3 + w4 * e_i4 ]];

    // Combine EDF weight with emission intensity
    material_emission(_[[ e_intensity ~ e_weight ]], intensity, mode)
        --> material_emission(diffuse_edf(), intensity, mode) [[ e_intensity = e_weight * intensity ]];

}

rules Enable_microflake_sheen_base_for_ovrtx bottomup {
    material(thinwalled, surface, backface, ior, volume, geometry)
        --> material(thinwalled, surface, backface, ior, volume, geometry) [[
            use_r_ms = true ]];
}

rules Disable_microflake_sheen_base_for_ovrtx bottomup {
    material(thinwalled, surface, backface, ior, volume, geometry)
        --> material(thinwalled, surface, backface, ior, volume, geometry) [[
            use_r_ms = false ]];
}

rules Inflate_for_ovrtx topdown {

//2 sided material, booth sheen
    material(   thinwalled,
                material_surface(_[[
                                  c_c  ~ c_c1,  c_ru  ~ c_ru1,  c_rv ~ c_rv1, c_t  ~ c_t1,  c_w0 ~ c_w01, c_w90 ~ c_w901, c_n   ~ c_n1, //coat
                                  g_c0 ~ g_c01, g_c90 ~ g_c901, g_ru ~ g_ru1, g_rv ~ g_rv1, g_t  ~ g_t1,  g_w0  ~ g_w01,  g_w90 ~ g_w901 ,g_e ~ g_e1 , g_n ~ g_n1, //glossy
                                  gt_c ~ gt_c1, gt_w  ~ gt_w1,  gt_ior ~ gt_ior1,//glass
                                  d_c  ~ d_c1,  d_w, dt_c  ~ dt_c1,  dt_w ~ dt_w1, b_n  ~ b_n1, //diffuse
