/// \file dist_rules_ovrtx.mdltl
/// \brief Rule sets for the ovrtx distiller target.
///
/// Derived from dist_rules_lod.mdltl in the mdl_lod_distiller plugin
/// (specifically, the rule blocks used by the rtx_distiller pipeline).
//*****************************************************************************
rules Select_sheen_for_ovrtx bottomup {

    // Mark sheen nodes so the surrounding rules can retain the first one in
    // depth-first, argument order. Since this is bottom-up, an outer sheen
    // still wins over any sheen in its multiscatter base.
    selected ~ sheen_bsdf(_,_,_,_,_)
        --> selected [[ selected_sheen = selected ]];
    selected ~ microflake_sheen_bsdf(_,_,_,_,_)
        --> selected [[ selected_sheen = selected ]];

    // Propagate a selected sheen through unary BSDF modifiers.
    bsdf_tint(_, _ [[ selected_sheen ~ selected ]]) --> selected;
    bsdf_tint_ex(_,_, _ [[ selected_sheen ~ selected ]]) --> selected;
    thin_film(_,_, _ [[ selected_sheen ~ selected ]]) --> selected;
    bsdf_directional_factor(_,_,_,_, _ [[ selected_sheen ~ selected ]],_)
        --> selected;
    measured_curve_factor(_, _ [[ selected_sheen ~ selected ]],_)
        --> selected;
    measured_factor(_, _ [[ selected_sheen ~ selected ]],_)
        --> selected;
    fresnel_factor(_,_, _ [[ selected_sheen ~ selected ]],_)
        --> selected;
    coat_absorption_factor(_,_,_, _ [[ selected_sheen ~ selected ]])
        --> selected;

    // Use weighted_layer as a canonical two-child carrier. Its layer is
    // visited before its base, matching the DAG argument order.
    color_weighted_layer(_,layer,base,n)
        --> weighted_layer(1.0,layer,base,n) repeat_rules;
    fresnel_layer(_,_,layer,base,n,_)
        --> weighted_layer(1.0,layer,base,n) repeat_rules;
    color_fresnel_layer(_,_,layer,base,n,_)
        --> weighted_layer(1.0,layer,base,n) repeat_rules;
    custom_curve_layer(_,_,_,_,layer,base,n,_)
        --> weighted_layer(1.0,layer,base,n) repeat_rules;
    color_custom_curve_layer(_,_,_,_,_,layer,base,n,_)
        --> weighted_layer(1.0,layer,base,n) repeat_rules;
    measured_curve_layer(_,_,layer,base,n,_)
        --> weighted_layer(1.0,layer,base,n) repeat_rules;
    color_measured_curve_layer(_,_,layer,base,n,_)
        --> weighted_layer(1.0,layer,base,n) repeat_rules;
    bsdf_conditional_operator(_,true_exp,false_exp)
        --> weighted_layer(1.0,true_exp,false_exp,state::normal()) repeat_rules;

    weighted_layer(_, _ [[ selected_sheen ~ selected ]],_,_) --> selected;
    weighted_layer(_,_, _ [[ selected_sheen ~ selected ]],_) --> selected;

    // Use normalized mixers as canonical mixer carriers. The selector only
    // needs component order, so color weights can be replaced by dummy scalar
    // weights without affecting the selected result.
    bsdf_clamped_mix_1(w1,c1) --> bsdf_mix_1(w1,c1) repeat_rules;
    bsdf_clamped_mix_2(w1,c1,w2,c2) --> bsdf_mix_2(w1,c1,w2,c2) repeat_rules;
    bsdf_clamped_mix_3(w1,c1,w2,c2,w3,c3)
        --> bsdf_mix_3(w1,c1,w2,c2,w3,c3) repeat_rules;
    bsdf_clamped_mix_4(w1,c1,w2,c2,w3,c3,w4,c4)
        --> bsdf_mix_4(w1,c1,w2,c2,w3,c3,w4,c4) repeat_rules;

    bsdf_unbounded_mix_1(w1,c1) --> bsdf_mix_1(w1,c1) repeat_rules;
    bsdf_unbounded_mix_2(w1,c1,w2,c2) --> bsdf_mix_2(w1,c1,w2,c2) repeat_rules;
    bsdf_unbounded_mix_3(w1,c1,w2,c2,w3,c3)
        --> bsdf_mix_3(w1,c1,w2,c2,w3,c3) repeat_rules;
    bsdf_unbounded_mix_4(w1,c1,w2,c2,w3,c3,w4,c4)
        --> bsdf_mix_4(w1,c1,w2,c2,w3,c3,w4,c4) repeat_rules;

    bsdf_color_mix_1(_,c1) --> bsdf_mix_1(1.0,c1) repeat_rules;
    bsdf_color_mix_2(_,c1,_,c2) --> bsdf_mix_2(1.0,c1,1.0,c2) repeat_rules;
    bsdf_color_mix_3(_,c1,_,c2,_,c3)
        --> bsdf_mix_3(1.0,c1,1.0,c2,1.0,c3) repeat_rules;
    bsdf_color_mix_4(_,c1,_,c2,_,c3,_,c4)
        --> bsdf_mix_4(1.0,c1,1.0,c2,1.0,c3,1.0,c4) repeat_rules;

    bsdf_color_clamped_mix_1(_,c1) --> bsdf_mix_1(1.0,c1) repeat_rules;
    bsdf_color_clamped_mix_2(_,c1,_,c2)
        --> bsdf_mix_2(1.0,c1,1.0,c2) repeat_rules;
    bsdf_color_clamped_mix_3(_,c1,_,c2,_,c3)
        --> bsdf_mix_3(1.0,c1,1.0,c2,1.0,c3) repeat_rules;
    bsdf_color_clamped_mix_4(_,c1,_,c2,_,c3,_,c4)
        --> bsdf_mix_4(1.0,c1,1.0,c2,1.0,c3,1.0,c4) repeat_rules;

    bsdf_color_unbounded_mix_1(_,c1) --> bsdf_mix_1(1.0,c1) repeat_rules;
    bsdf_color_unbounded_mix_2(_,c1,_,c2)
        --> bsdf_mix_2(1.0,c1,1.0,c2) repeat_rules;
    bsdf_color_unbounded_mix_3(_,c1,_,c2,_,c3)
        --> bsdf_mix_3(1.0,c1,1.0,c2,1.0,c3) repeat_rules;
    bsdf_color_unbounded_mix_4(_,c1,_,c2,_,c3,_,c4)
        --> bsdf_mix_4(1.0,c1,1.0,c2,1.0,c3,1.0,c4) repeat_rules;

    bsdf_mix_1(_, _ [[ selected_sheen ~ selected ]]) --> selected;
    bsdf_mix_2(_, _ [[ selected_sheen ~ selected ]],_,_) --> selected;
    bsdf_mix_2(_,_,_, _ [[ selected_sheen ~ selected ]]) --> selected;
    bsdf_mix_3(_, _ [[ selected_sheen ~ selected ]],_,_,_,_) --> selected;
    bsdf_mix_3(_,_,_, _ [[ selected_sheen ~ selected ]],_,_) --> selected;
    bsdf_mix_3(_,_,_,_,_, _ [[ selected_sheen ~ selected ]]) --> selected;
    bsdf_mix_4(_, _ [[ selected_sheen ~ selected ]],_,_,_,_,_,_) --> selected;
    bsdf_mix_4(_,_,_, _ [[ selected_sheen ~ selected ]],_,_,_,_) --> selected;
    bsdf_mix_4(_,_,_,_,_, _ [[ selected_sheen ~ selected ]],_,_) --> selected;
    bsdf_mix_4(_,_,_,_,_,_,_, _ [[ selected_sheen ~ selected ]]) --> selected;

    // Canonicalize materials after their surface and backface BSDFs have been
    // folded. Surface precedes backface in material argument order.
    material(_,material_surface(_ [[ selected_sheen ~ selected ]],_),_,_,_,_)
        --> material(false,material_surface(selected),material_surface(),color(1.0),
            material_volume(),material_geometry());
    material(_,_,material_surface(_ [[ selected_sheen ~ selected ]],_),_,_,_)
        --> material(false,material_surface(selected),material_surface(),color(1.0),
            material_volume(),material_geometry());
    material(_,_,_,_,_,_)
        --> material(false,
            material_surface(diffuse_reflection_bsdf(color(0.0),0.0)),
            material_surface(),color(1.0),material_volume(),material_geometry());

    // Material conditionals are folded after their branches. The true branch
    // is encountered before the false branch.
    material_conditional_operator(_,
        selected_material ~ material(_,material_surface(_ [[ selected_sheen ]],_),_,_,_,_),_)
        --> selected_material;
    material_conditional_operator(_,_,
        selected_material ~ material(_,material_surface(_ [[ selected_sheen ]],_),_,_,_,_))
        --> selected_material;
    material_conditional_operator(_,_,_)
        --> material(false,
            material_surface(diffuse_reflection_bsdf(color(0.0),0.0)),
            material_surface(),color(1.0),material_volume(),material_geometry());

    postcond
        match(material(_,material_surface(sheen_bsdf(_,_,_,_,_),_),_,_,_,_))
        || match(material(_,material_surface(microflake_sheen_bsdf(_,_,_,_,_),_),_,_,_,_))
        || match(material(_,material_surface(diffuse_reflection_bsdf(_,_),_),_,_,_,_));
}

rules Reduce_1_4_to_1_3_ovrtx_rules topdown {

    microflake_sheen_bsdf(r,tint,tint2,base,_) --> sheen_bsdf(r,tint,tint2,base);

    fresnel_factor(ior,k,base)
        --> bsdf_directional_factor(r,g,color(1.0),5.0,base)
        where   r = nvidia::distilling_support::refl_from_ior_k(ior,k)
                g = nvidia::distilling_support::g_from_ior_k(ior,k);

    bsdf_color_mix_1(w1,df1) --> bsdf_tint(w1,df1);
    bsdf_color_mix_2(w1,df1,w2,df2) --> bsdf_mix_2( wp1,bsdf_tint(w1/wp1,df1),
                                                    wp2,bsdf_tint(w2/wp2,df2))
            where wp1 = math::clamp( math::max_value(w1), 0.001, 1.0)
                  wp2 = math::clamp( math::max_value(w2), 0.001, 1.0);
                  
    bsdf_color_mix_3(w1,df1,w2,df2,w3,df3) --> bsdf_mix_3( wp1,bsdf_tint(w1/wp1,df1),
                                                           wp2,bsdf_tint(w2/wp2,df2),
                                                           wp3,bsdf_tint(w3/wp3,df3))
            where wp1 = math::clamp( math::luminance(w1), 0.001, 1.0)
                  wp2 = math::clamp( math::luminance(w2), 0.001, 1.0)
                  wp3 = math::clamp( math::luminance(w3), 0.001, 1.0);
    bsdf_color_mix_4(w1,df1,w2,df2,w3,df3,w4,df4) --> bsdf_mix_4( wp1,bsdf_tint(w1/wp1,df1),
                                                                  wp2,bsdf_tint(w2/wp2,df2),
                                                                  wp3,bsdf_tint(w3/wp3,df3),
                                                                  wp4,bsdf_tint(w4/wp4,df4))
            where wp1 = math::clamp( math::luminance(w1), 0.001, 1.0)
                  wp2 = math::clamp( math::luminance(w2), 0.001, 1.0)
                  wp3 = math::clamp( math::luminance(w3), 0.001, 1.0)
                  wp4 = math::clamp( math::luminance(w4), 0.001, 1.0);
    bsdf_color_clamped_mix_1(w1,df1) --> bsdf_tint(w1,df1);
    bsdf_color_clamped_mix_2(w1,df1,w2,df2) --> bsdf_mix_2( wp1,bsdf_tint(w1/wp1,df1),
                                                            wp2,bsdf_tint(w2/wp2,df2))
            where wp1 = math::clamp( math::luminance(w1), 0.001, 1.0)
                  wp2 = math::clamp( math::luminance(w2), 0.001, 1.0);

    bsdf_color_clamped_mix_3(w1,df1,w2,df2,w3,df3) --> bsdf_mix_3( wp1,bsdf_tint(w1/wp1,df1),
                                                                   wp2,bsdf_tint(w2/wp2,df2),
                                                                   wp3,bsdf_tint(w3/wp3,df3))
            where wp1 = math::clamp( math::luminance(w1), 0.001, 1.0)
                  wp2 = math::clamp( math::luminance(w2), 0.001, 1.0)
                  wp3 = math::clamp( math::luminance(w3), 0.001, 1.0);
    bsdf_color_clamped_mix_4(w1,df1,w2,df2,w3,df3,w4,df4) --> bsdf_mix_4( wp1,bsdf_tint(w1/wp1,df1),
                                                                          wp2,bsdf_tint(w2/wp2,df2),
                                                                          wp3,bsdf_tint(w3/wp3,df3),
                                                                          wp4,bsdf_tint(w4/wp4,df4))
            where wp1 = math::clamp( math::luminance(w1), 0.001, 1.0)
                  wp2 = math::clamp( math::luminance(w2), 0.001, 1.0)
                  wp3 = math::clamp( math::luminance(w3), 0.001, 1.0)
                  wp4 = math::clamp( math::luminance(w4), 0.001, 1.0);

    bsdf_color_unbounded_mix_1(w1,df1) --> bsdf_tint(w1,df1);
    bsdf_color_unbounded_mix_2(w1,df1,w2,df2) --> bsdf_mix_2( wp1,bsdf_tint(w1/wp1,df1),
                                                              wp2,bsdf_tint(w2/wp2,df2))
            where wp1 = math::clamp( math::luminance(w1), 0.001, 1.0)
                  wp2 = math::clamp( math::luminance(w2), 0.001, 1.0);

    bsdf_color_unbounded_mix_3(w1,df1,w2,df2,w3,df3) --> bsdf_mix_3( wp1,bsdf_tint(w1/wp1,df1),
                                                                     wp2,bsdf_tint(w2/wp2,df2),
                                                                     wp3,bsdf_tint(w3/wp3,df3))
            where wp1 = math::clamp( math::luminance(w1), 0.001, 1.0)
                  wp2 = math::clamp( math::luminance(w2), 0.001, 1.0)
                  wp3 = math::clamp( math::luminance(w3), 0.001, 1.0);
    bsdf_color_unbounded_mix_4(w1,df1,w2,df2,w3,df3,w4,df4) --> bsdf_mix_4( wp1,bsdf_tint(w1/wp1,df1),
                                                                            wp2,bsdf_tint(w2/wp2,df2),
                                                                            wp3,bsdf_tint(w3/wp3,df3),
                                                                            wp4,bsdf_tint(w4/wp4,df4))
            where wp1 = math::clamp( math::luminance(w1), 0.001, 1.0)
                  wp2 = math::clamp( math::luminance(w2), 0.001, 1.0)
                  wp3 = math::clamp( math::luminance(w3), 0.001, 1.0)
                  wp4 = math::clamp( math::luminance(w4), 0.001, 1.0);

    color_weighted_layer(w,layer,base,n) --> weighted_layer(0.0,layer,base,n)
        if w == color(0.0)
        deadrule; // the optimizer in the compiler removes this case
    color_weighted_layer(w,layer,base,n) --> weighted_layer(1.0,layer,base,n)
        if w == color(1.0);
    color_weighted_layer(w,layer,base,n)
        --> weighted_layer( wp,bsdf_tint(w/color(wp),layer),
                                 bsdf_tint((color(1.0)-w)/color(1.0-wp),base),n)
        where wp = math::clamp( math::luminance(w), 0.001, 0.999);
    color_fresnel_layer(ior,w,layer,base,n)
        --> fresnel_layer(math::luminance(ior),0.0,layer,base,n)
        if w == color(0.0)
        deadrule; // the optimizer in the compiler removes this case
    color_fresnel_layer(ior,w,layer,base,n)
        --> fresnel_layer(math::luminance(ior),1.0,layer,base,n)
        if w == color(1.0);
    color_fresnel_layer(ior,w,layer,base,n)
        --> fresnel_layer( math::luminance(ior),wp,
                                bsdf_tint(w/color(wp),layer),
                                bsdf_tint((color(1.0)-w)/color(1.0-wp),base),
                                n)
        where wp = math::clamp( math::luminance(w), 0.001, 0.999);

    // Preserve the colored normal and grazing reflectivities if there is no base BSDF.
    color_custom_curve_layer(refl_n,refl_g,f82_factor,exp,w,layer,bsdf(),n)
        --> weighted_layer(
                1.0,
                custom_curve_layer(
                    0.0,1.0,exp,1.0,
                    bsdf_tint(refl_g*w*f82_factor,layer),
                    bsdf_tint(refl_n*w,layer),
                    n),
                bsdf(),
                n);

    color_custom_curve_layer(refl_n,refl_g,f82_factor,exp,w,layer,base,n)
        --> custom_curve_layer(rn,rg,exp,0.0,layer,base,n)
        if w == color(0.0)
        where rn = math::luminance(refl_n)
              rg = math::luminance(refl_g*f82_factor)
        deadrule; // the optimizer in the compiler removes this case

    color_custom_curve_layer(refl_n,refl_g,f82_factor,exp,w,layer,base,n)
        --> custom_curve_layer(rn,rg,exp,1.0,
                                    bsdf_tint(refl_n/color(rn),layer),
                                    bsdf_tint((color(1.0)-refl_n)/color(1.0-rn),base),
                                    n)
        if w == color(1.0)
        where rn = math::clamp( math::max_value(refl_n), 0.001, 0.999)
              rg = math::max_value(refl_g*f82_factor);
    color_custom_curve_layer(refl_n,refl_g,_f82,exp,w,layer,base,n)
        --> custom_curve_layer(rn,rg,exp,wp,
                                    bsdf_tint(refl_n*w/color(rn*wp),layer),
                                    bsdf_tint((color(1.0)-refl_n*w)/color(1.0-rn*wp),base),
                                    n)
        where rn = math::clamp( math::luminance(refl_n), 0.001, 0.999)
              rg = math::luminance(refl_g)
              wp = math::clamp( math::luminance(w), 0.001, 0.999);
    color_measured_curve_layer(_,w,layer,base,n) --> fresnel_layer(1.5,0.0,layer,base,n)
        if w == color(0.0);
    color_measured_curve_layer(_,w,layer,base,n) --> fresnel_layer(1.5,1.0,layer,base,n)
        if w == color(1.0);
    color_measured_curve_layer(_,w,layer,base,n) -->
        fresnel_layer( 1.5, wp,
                            bsdf_tint(w/color(wp),layer),
                            bsdf_tint((color(1.0)-w)/color(1.0-wp),base),
                            n)
        where wp = math::clamp( math::luminance(w), 0.001, 0.999);
    postcond nonode(bsdf_color_mix_1)
        && nonode(bsdf_color_mix_2)
        && nonode(bsdf_color_mix_3)
        && nonode(bsdf_color_mix_4)
        && nonode(bsdf_color_clamped_mix_1)
        && nonode(bsdf_color_clamped_mix_2)
        && nonode(bsdf_color_clamped_mix_3)
        && nonode(bsdf_color_clamped_mix_4)
        && nonode(bsdf_color_unbounded_mix_1)
        && nonode(bsdf_color_unbounded_mix_2)
        && nonode(bsdf_color_unbounded_mix_3)
        && nonode(bsdf_color_unbounded_mix_4)
        && nonode(color_weighted_layer)
        && nonode(color_fresnel_layer)
        && nonode(color_custom_curve_layer)
        && nonode(color_measured_curve_layer);
}

rules Elide_conditional_operator_ovrtx_rules bottomup {
    import df;

    // Decompose material-level conditional into field-level conditionals
    // so that emission intensity, BSDFs, EDFs, and VDFs are each blended properly.
    material_conditional_operator(cond,
        material(tw1,
            material_surface(bsdf1, material_emission(edf1, i1, m1)),
            material_surface(bbsdf1, material_emission(bedf1, bi1, bm1)),
            ior1,
            material_volume(vdf1, abs1, scat1),
            material_geometry(dis1, co1, n1)),
        material(tw2,
            material_surface(bsdf2, material_emission(edf2, i2, m2)),
            material_surface(bbsdf2, material_emission(bedf2, bi2, bm2)),
            ior2,
            material_volume(vdf2, abs2, scat2),
            material_geometry(dis2, co2, n2)))
        --> material(
            cond ? tw1 : tw2,
            material_surface(
                bsdf_conditional_operator(cond, bsdf1, bsdf2),
                material_emission(
                    edf_conditional_operator(cond, edf1, edf2),
                    cond ? i1 : i2,
                    cond ? m1 : m2)),
            material_surface(
                bsdf_conditional_operator(cond, bbsdf1, bbsdf2),
                material_emission(
                    edf_conditional_operator(cond, bedf1, bedf2),
                    cond ? bi1 : bi2,
                    cond ? bm1 : bm2)),
            cond ? ior1 : ior2,
            material_volume(
                vdf_conditional_operator(cond, vdf1, vdf2),
                cond ? abs1 : abs2,
                cond ? scat1 : scat2),
            material_geometry(
                cond ? dis1 : dis2,
                cond ? co1 : co2,
                cond ? n1 : n2))
        repeat_rules;

    //HACK: i want to keep the information that this is a conditional.
    //the attribute sometimes does not survive elide_tint though
    //fallback: store info as magic number in second bsdf weight

    //note, mixes might be resorted.consistant use of the conditional atrribute will then fail
    bsdf_conditional_operator( cond, bsdf1, bsdf2)
    //    --> bsdf_mix_2( (cond ? 1.0 : 0.0), bsdf1,  -3.33, bsdf2)[[conditional = cond]];
        -->weighted_layer((cond ? 1.0 : 0.0),bsdf1,bsdf2)[[conditional = cond]];
    edf_conditional_operator( cond, edf1, edf2)
        --> edf_mix_2( (cond ? 1.0 : 0.0), edf1, (cond ? 0.0 : 1.0), edf2)[[conditional  = cond]];
    vdf_conditional_operator( cond, vdf1, vdf2)
        --> vdf_mix_2( (cond ? 1.0 : 0.0), vdf1, (cond ? 0.0 : 1.0), vdf2)[[conditional = cond]];

    postcond nonode(material_conditional_operator)
        &&  nonode(bsdf_conditional_operator)
        &&  nonode(edf_conditional_operator)
        &&  nonode(vdf_conditional_operator);
}

rules Make_simple_for_ovrtx bottomup {
    //this import will be mirrored in the output mdl
    import nvidia::distilling_support;
    import df;

    // LEGACY: Fix wrong 0.0 initialization of the normal field in older materials.
    material( tw,sf,bf,ior,vol,
              material_geometry(dis,cutout,n))
        --> material(tw,sf,bf,ior,vol,material_geometry(dis,cutout,state::normal()))
        if n == 0.0;

    //fix all reflective glossy/specular to be ggx
    microfacet_beckmann_smith_bsdf(ru,rv,tint,tint2,t,mode) --> microfacet_ggx_vcavities_bsdf( ru,rv,tint,tint2,t,mode) repeat_rules;
    specular_bsdf(tint,mode,bs,handle) --> microfacet_ggx_vcavities_bsdf( 0.0,0.0,tint,tint,state::texture_tangent_u(0),mode,bs,handle) repeat_rules;
    microfacet_beckmann_vcavities_bsdf(ru,rv,tint,tint2,t,mode,bs,handle)--> microfacet_ggx_vcavities_bsdf( ru,rv,tint,tint2,t,mode,bs,handle) repeat_rules;
    microfacet_ggx_smith_bsdf(ru,rv,tint,tint2,t,mode,bs,handle) --> microfacet_ggx_vcavities_bsdf( ru,rv,tint,tint2,t,mode,bs,handle) repeat_rules;
    simple_glossy_bsdf(ru,rv,tint,tint2,t,mode,bs,handle) --> microfacet_ggx_vcavities_bsdf( ru,rv,tint,tint2,t,mode,bs,handle) repeat_rules;

    ward_geisler_moroder_bsdf(ru,rv,tint,tint2,t) --> microfacet_ggx_vcavities_bsdf( ru,rv,tint,tint2,t,scatter_reflect);

    //handle the case that 'mode' is a parameter not fixed because we are in class compile.
    microfacet_ggx_vcavities_bsdf(ru,rv,tint,tint2,t,mode,_bs,_handle) --> bsdf_mix_2(
        w,      microfacet_ggx_vcavities_bsdf( ru,rv,tint,tint2,t,scatter_reflect),
        1.0-w,  microfacet_ggx_vcavities_bsdf( ru,rv,tint,tint2,t,scatter_reflect_transmit))
    maybe (mode == scatter_reflect) && (mode == scatter_reflect_transmit)    //maybe either in class compile
    where w = mode ==  scatter_reflect?1.0:0.0;

    // sheen_bsdf() is replaced by a combination of two bsdf_marker() nodes to identify it
    // exactly and ensure that it is eliminated in the end.
    sheen_bsdf(r,tint,tint2,base,_) --> bsdf_marker(1, tint, r, bsdf_marker(2, tint2, r, base))
        repeat_rules;

    //some brutal removal of unsupported components:
    measured_bsdf(_) --> bsdf_marker(3, color(0.0), 0.0, bsdf());
    thin_film(_,_,base) --> base repeat_rules;
    coat_absorption_factor(_, _, _, base) --> base repeat_rules;
    measured_curve_factor(_,bsdf()) --> bsdf();
    measured_curve_factor(a,base) -->
		custom_curve_layer( 0.0,1.,.5, 1., bsdf_tint(nvidia::distilling_support::last(a),base), bsdf_tint(a[0],base));

    measured_factor(t,base) -->
//        bsdf_tint(tex::lookup_color(t,float2(0.0),wrap_repeat,wrap_repeat,float2(0.0,1.0),float2(0.0,1.0),0.0),base);
		custom_curve_layer( 0.0,1.,.5, 1.,
            bsdf_tint(tex::lookup_color(t,float2(1.0),wrap_repeat,wrap_repeat,float2(0.0,1.0),float2(0.0,1.0),0.0),base),
            bsdf_tint(tex::lookup_color(t,float2(0.0),wrap_repeat,wrap_repeat,float2(0.0,1.0),float2(0.0,1.0),0.0),base));

    bsdf_tint( _, bsdf()) --> bsdf();
    custom_curve_layer(_,_,_,_,bsdf(),bsdf()) --> bsdf();
    weighted_layer(_,bsdf(),bsdf()) --> bsdf();
    bsdf_directional_factor(_,_,_,_,bsdf(),_bs) --> bsdf();

    bsdf_directional_factor(tint_n,tint_g,f82_factor,e,base,_bs) -->
        custom_curve_layer( 0.0,1.0,e, 1.0, bsdf_tint(tint_g*f82_factor,base), bsdf_tint(tint_n,base));

    bsdf_clamped_mix_1(w1,df1) --> bsdf_tint( color(w1), df1);
    bsdf_mix_1(w1,df1) --> bsdf_tint( color(w1), df1);

    bsdf_clamped_mix_2(w1,df1,w2,df2) --> bsdf_mix_2(w1,df1,w2,df2);
    bsdf_clamped_mix_3(w1,df1,w2,df2,w3,df3) --> bsdf_mix_2(w1,df1,w2+w3,bsdf_mix_2(w2/math::max((w2+w3),0.00001),df2,w3/math::max((w2+w3),0.00001),df3));
    bsdf_clamped_mix_4(w1,df1,w2,df2,w3,df3,w4,df4) -->
        bsdf_mix_2(w1,df1,
                   w2+w3+w4,bsdf_mix_2(w2/(w2+w3+w4),df2,
                                       (w3+w4)/(w2+w3+w4), bsdf_mix_2(w3/(w3+w4),df3,
                                                                      w4/(w3+w4),df4)));
    bsdf_mix_3(w1,df1,w2,df2,w3,df3)--> bsdf_mix_2(w1,df1,w2+w3,bsdf_mix_2(w2/math::max((w2+w3),0.00001),df2,w3/math::max((w2+w3),0.00001),df3));
    bsdf_mix_4(w1,df1,w2,df2,w3,df3,w4,df4)--> bsdf_mix_2(w1,df1,
                                                          w2+w3+w4,bsdf_mix_2(w2/math::max((w2+w3+w4),0.00001),df2,
                                                                              (w3+w4)/math::max((w2+w3+w4),0.00001),
                                                                              bsdf_mix_2(
                                                                                 w3/math::max((w3+w4),0.00001),df3,
                                                                                 w4/math::max((w3+w4),0.00001),df4)));

    bsdf_unbounded_mix_1(w1,df1) --> bsdf_tint(color(w1),df1);
    bsdf_unbounded_mix_2(w1,df1,w2,df2) --> bsdf_mix_2(w1,df1,w2,df2);
    bsdf_unbounded_mix_3(w1,df1,w2,df2,w3,df3) --> bsdf_mix_2(w1,df1,w2+w3,bsdf_mix_2(w2/(w2+w3),df2,w3/(w2+w3),df3));
    bsdf_unbounded_mix_4(w1,df1,w2,df2,w3,df3,w4,df4) -->
        bsdf_mix_2(w1,df1,
                   w2+w3+w4,bsdf_mix_2(w2/(w2+w3+w4),df2,
                                       (w3+w4)/(w2+w3+w4), bsdf_mix_2(w3/(w3+w4),df3,
                                                                      w4/(w3+w4),df4)));

    //if a glossy is layered on top of a diffuse thats unbumped, bump the diffuse too to emphasize the glossy bump
    //weighted_layer(w,microfacet_ggx_vcavities_bsdf(ru,rv,tint,tint2,t,m),diffuse_reflection_bsdf(tint1,r),n) -->
    //    weighted_layer(w,microfacet_ggx_vcavities_bsdf(ru,rv,tint,tint2,t,m),weighted_layer(1.0,diffuse_reflection_bsdf(tint1,r),bsdf(),n),n)
    //    maybe n != state::normal();

    //optimize some stuff away
    fresnel_layer( ior, _, _, base, _) -->
        base if ior ==1.0;
    //fresnel_layer( _, w, layer, simple_glossy_bsdf(r1,r2,c,ms,m), n) -->
    //    custom_curve_layer(0.04,1.0,5.0,w,layer,
    //        bsdf_mix_2(1.0,simple_glossy_bsdf(r1,r2,c,ms,m),0.0,diffuse_reflection_bsdf(color(0.),0.)),n);
    //fresnel_layer( _, w, layer, base, n) -->
    //    custom_curve_layer(0.04,1.0,5.0,w,layer,base,n);

    measured_curve_layer(a,w,layer,base,n) -->
        weighted_layer( math::max_value(a[0])*w, bsdf_tint(a[0]/math::max_value(a[0]),layer), base, n);

    dusty_diffuse_reflection_bsdf(tint) --> diffuse_reflection_bsdf(tint, 1.0);


    postcond
        //nonode(diffuse_transmission_bsdf) &&
        nonode(specular_bsdf) &&
        //nonode(backscattering_glossy_reflection_bsdf) &&
        nonode(sheen_bsdf) &&
        nonode(microflake_sheen_bsdf) &&
        nonode(measured_bsdf) &&
        nonode(microfacet_beckmann_smith_bsdf) &&
        nonode(microfacet_ggx_smith_bsdf) &&
        nonode(microfacet_beckmann_vcavities_bsdf) &&
        nonode(ward_geisler_moroder_bsdf) &&
        nonode(thin_film) &&
        nonode(coat_absorption_factor) &&
        nonode(bsdf_directional_factor) &&
        nonode(measured_curve_factor) &&
        nonode(measured_factor) &&
        nonode(bsdf_mix_1) &&
        nonode(bsdf_mix_3) &&
        nonode(bsdf_mix_4) &&
        nonode(bsdf_clamped_mix_1) &&
        nonode(bsdf_clamped_mix_2) &&
        nonode(bsdf_clamped_mix_3) &&
        nonode(bsdf_clamped_mix_4) &&
        nonode(bsdf_color_mix_1) &&
        nonode(bsdf_color_mix_2) &&
        nonode(bsdf_color_mix_3) &&
        nonode(bsdf_color_mix_4) &&
        nonode(bsdf_color_clamped_mix_1) &&
        nonode(bsdf_color_clamped_mix_2) &&
        nonode(bsdf_color_clamped_mix_3) &&
        nonode(bsdf_color_clamped_mix_4) &&
        //nonode(fresnel_layer) &&
        nonode(color_fresnel_layer) &&
        nonode(measured_curve_layer) &&
        nonode(fresnel_factor) &&
        nonode(color_measured_curve_layer);
}

rules Elide_tint_for_ovrtx topdown {
    bsdf_tint( _, bsdf()) --> bsdf() skip_recursion;
    bsdf_tint( c, diffuse_reflection_bsdf(tint,r)) --> diffuse_reflection_bsdf( c * tint, r) skip_recursion;
    bsdf_tint( c, diffuse_transmission_bsdf(tint)) --> diffuse_transmission_bsdf( c * tint) skip_recursion;
    bsdf_tint( c, microfacet_ggx_vcavities_bsdf(ru,rv,tint,tint2,t,mode)) --> microfacet_ggx_vcavities_bsdf( ru,rv,c * tint,c*tint2,t,mode) skip_recursion;

    bsdf_tint( c, backscattering_glossy_reflection_bsdf(ru, rv, tint, ms_tint, t, handle)) --> 
        backscattering_glossy_reflection_bsdf(ru, rv, c*tint, c*ms_tint, t, handle) 
        skip_recursion
        debug_name "tint into backscattering_glossy_reflection_bsdf";

    bsdf_tint( c, bsdf_marker(tag1, tint, ru, bsdf_marker(tag2, tint2, rv, base))) --> 
        bsdf_marker(tag1, c * tint, ru, bsdf_marker(tag2, c * tint2, rv, bsdf_tint(c, base)))
        if tag1 == 1 && tag2 == 2;
    bsdf_tint( _, bsdf_marker(tag, c1, f1, base)) --> 
        bsdf_marker(tag, c1, f1, base) // base will always be bsdf()
        if tag == 3;
    //glossy is transmission
    //bsdf_tint( c, simple_glossy_bsdf(ru,rv,tint,_,t)) --> simple_glossy_bsdf( ru,rv,c * tint,color(0.0),t) skip_recursion;
    bsdf_tint( c, bsdf_tint(tint,base)) --> bsdf_tint( c * tint, base) repeat_rules
    debug_name "double_tint"
    ;
    bsdf_tint( c, bsdf_tint_ex(tint,tintt,base)) --> bsdf_tint_ex( c * tint, c * tintt, base) repeat_rules;
    
    bsdf_tint( c,bsdf_conditional_operator( cond, bsdf1, bsdf2)) 
        --> bsdf_conditional_operator( cond, bsdf_tint( c,bsdf1), bsdf_tint( c,bsdf2)) repeat_rules;
    bsdf_tint( c, bsdf_mix_2(w1,df1,w2,df2)) 
        --> bsdf_mix_2( w1, bsdf_tint( c, df1), w2, bsdf_tint( c, df2)) repeat_rules
    debug_name "pusht tint in mix"
    ;
    bsdf_tint( c, custom_curve_layer(f0,f90,e,w,layer,base,n))
        --> custom_curve_layer( f0,f90,e, w, bsdf_tint( c, layer), bsdf_tint( c, base), n) repeat_rules
    debug_name "pusht tint in custom_curve"
    ;
    bsdf_tint( c, weighted_layer(w,layer,base,n))
        --> weighted_layer( w, bsdf_tint( c, layer), bsdf_tint( c, base), n) ;
    bsdf_tint( c, fresnel_layer(ior,w,layer,base,n))
        --> fresnel_layer( ior,w, bsdf_tint( c, layer), bsdf_tint( c, base), n) ;
    bsdf_tint_ex( _, _, bsdf()) --> bsdf() skip_recursion;//eliminate earlier???
    bsdf_tint_ex(tint,tint2,bsdf_tint_ex(tint3,tint4,base)) -->
        bsdf_tint_ex(tint*tint3,tint2*tint4,base) repeat_rules;
    bsdf_tint_ex(tint,_,diffuse_reflection_bsdf(c1,r1))
        -->diffuse_reflection_bsdf(c1*tint,r1) ;
    bsdf_tint_ex(_,tint,diffuse_transmission_bsdf(c1))
        -->diffuse_transmission_bsdf(c1*tint);
    bsdf_tint_ex(tint,_,microfacet_ggx_vcavities_bsdf(ru,rv,tint2,tint3,t,m))
        -->microfacet_ggx_vcavities_bsdf(ru,rv,tint*tint2,tint3,t,m)
        if (m == scatter_reflect);

    bsdf_tint_ex( c1, c2, bsdf_marker(tag1, tint, ru, bsdf_marker(tag2, tint2, rv, base))) -->
        bsdf_marker(tag1, tint, ru, bsdf_marker(tag2, tint2, rv, bsdf_tint_ex(c1, c2, base))) 
        repeat_rules
        if tag1 == 1 && tag2 == 2;
    bsdf_tint_ex( _, _, bsdf_marker(tag, c1, f1, base)) -->
        bsdf_marker(tag, c1, f1, base) // base will always be bsdf() 
        if tag == 3;

    bsdf_tint_ex( c, ct, bsdf_mix_2(w1,df1,w2,df2))
        --> bsdf_mix_2( w1, bsdf_tint_ex( c, ct, df1), w2, bsdf_tint_ex( c, ct, df2)) repeat_rules;
    bsdf_tint_ex( c, ct, custom_curve_layer(f0,f90,e,w,layer,base,n))
        --> custom_curve_layer( f0,f90,e, w, bsdf_tint_ex( c, ct, layer), bsdf_tint_ex( c, ct, base), n) repeat_rules;
    postcond nonode(bsdf_tint) ;
}

rules Unify_glass_for_ovrtx topdown {
//the following configurations are detected as glass:
//-gloss_reflect_transmit ->goal
//-fresnel(gloss_reflect,gloss_transmit) done
//-custom_c(gloss_reflect,gloss_transmit), also reversed  done
//-fresnel(gloss_reflect,mix(gloss_transmit,x))
//-custom_c(gloss_reflect,mix(gloss_transmit,x)), also reversed
    bsdf_tint_ex(tint,tint1,microfacet_ggx_vcavities_bsdf(ru,rv,tint2,tint3,t,m))
        -->bsdf_tint_ex(tint,tint1,microfacet_ggx_vcavities_bsdf(ru,rv,tint2,tint3,t,m)) skip_recursion;

    fresnel_layer( ior, w, microfacet_ggx_vcavities_bsdf(ru,rv,tint,_,t,mode), microfacet_ggx_vcavities_bsdf(_,_,tint2,_,_,mode1), _) -->
        bsdf_tint_ex(w*tint,tint2,microfacet_ggx_vcavities_bsdf(ru,rv,color(1.),color(ior),t,scatter_reflect_transmit))//hack, keep ior somewhere
        skip_recursion if (mode == scatter_reflect) && (mode1 == scatter_transmit) ;
        
    custom_curve_layer(_,_,_,w,microfacet_ggx_vcavities_bsdf(ru,rv,tint,_,t,mode), microfacet_ggx_vcavities_bsdf(_,_,tint2,_,_,mode1),_)-->
        bsdf_tint_ex(w*tint,tint2,microfacet_ggx_vcavities_bsdf(ru,rv,color(1.),color(1.5),t,scatter_reflect_transmit))//hack, keep ior somewhere
        skip_recursion if (mode == scatter_reflect) && (mode1 == scatter_transmit) ;
        
    //custom curve layer works also reversed
    custom_curve_layer(_,_,_,w,microfacet_ggx_vcavities_bsdf(_,_,tint,_,_,mode), microfacet_ggx_vcavities_bsdf(ru,rv,tint2,_,t,mode1),_)-->
        bsdf_tint_ex(w*tint2,tint,microfacet_ggx_vcavities_bsdf(ru,rv,color(1.),color(1.5),t,scatter_reflect_transmit))
        skip_recursion if (mode1 == scatter_reflect) && (mode == scatter_transmit) ;

    // Replace scatter_transmit microfacet BSDF with a scatter_reflect_transmit one, using tint to eliminate the reflection part.
    microfacet_ggx_vcavities_bsdf(ru,rv,tint,_,t,mode) -->
        bsdf_tint_ex(color(0.0),tint,microfacet_ggx_vcavities_bsdf(ru,rv,color(1.0),color(1.0),t,scatter_reflect_transmit))
        skip_recursion if (mode == scatter_transmit);

    // For scatter_reflect_transmit BSDFs, we use the reflection color both for reflection and refraction.
    microfacet_ggx_vcavities_bsdf(ru,rv,c1,_,t,mode1)-->bsdf_tint_ex(c1,c1,microfacet_ggx_vcavities_bsdf(ru,rv,color(1.),color(1.),t,mode1))
        skip_recursion if (mode1 == scatter_reflect_transmit);

    // Microfacet BSDFs with scatter_reflect are left as-is.
}

rules Elide_fresnel_for_ovrtx bottomup {
//all other fresnel is opaque and should be custom_curve_layer
//gloss_transmit not beeing glass needs to be promoted to glass.
//simplify some common constructs that need brutal transform (layered diffuse)

    //all other fresnels to custom curves
    fresnel_layer( ior, w, layer, base, n) -->
        custom_curve_layer(0.0,0.0,5.0,w,layer,base,n) repeat_rules
    if (ior == 1.0) ; 
    fresnel_layer( ior, w, layer, base, n) -->
        custom_curve_layer(nvidia::distilling_support::refl_from_ior(ior),1.0,5.0,w,layer,base,n) repeat_rules
    if (ior != 1.0) ; 
    fresnel_layer( ior, w, layer, base, n) -->
        custom_curve_layer(nvidia::distilling_support::refl_from_ior(ior),ior==1.0?0.0:1.0,5.0,w,layer,base,n)[[is_fresnel = true]]  repeat_rules;

    bsdf_mix_2( //mixes that contain glossy reflections should be changed into custom curve layers. TODO: w2 handling through tint?
        _, b1,
        w1, microfacet_ggx_vcavities_bsdf(ru1,rv1,c1,c2,t1,mode1))
          --> custom_curve_layer( w1 ,w1,5.0,1.0,
            microfacet_ggx_vcavities_bsdf(ru1,rv1,c1,c2,t1,mode1),
            b1,
            state::normal())
        if (mode1 == scatter_reflect);
    custom_curve_layer(w1,w2,e,w, diffuse_reflection_bsdf(c3,r1), microfacet_ggx_vcavities_bsdf(ru1,rv1,c1,c2,t1,mode1), n)
        --> custom_curve_layer(1.0-w1,1.0-w2,e,w,  microfacet_ggx_vcavities_bsdf(ru1,rv1,c1,c2,t1,mode1), diffuse_reflection_bsdf(c3,r1), n)
        if (mode1 == scatter_reflect);
    custom_curve_layer(w1,_,_,w, diffuse_reflection_bsdf(c1,r1), base)
        -->bsdf_mix_2( w1*w, diffuse_reflection_bsdf(c1,r1), 1.0-w1, base);
    custom_curve_layer(w1,w2,e,w, diffuse_transmission_bsdf(c3), microfacet_ggx_vcavities_bsdf(ru1,rv1,c1,c2,t1,mode1), n)
        --> custom_curve_layer(1.0-w1,1.0-w2,e,w, microfacet_ggx_vcavities_bsdf(ru1,rv1,c1,c2,t1,mode1), diffuse_transmission_bsdf(c3), n)
        if (mode1 == scatter_reflect);
    custom_curve_layer(w1,_,_,w, diffuse_transmission_bsdf(c1), base)//????
        -->bsdf_mix_2( w1*w, diffuse_transmission_bsdf(c1), 1.0-w1, base);
    //weighted layers into custom curve for glossy, mix for others
//    weighted_layer(w1,microfacet_ggx_vcavities_bsdf(ru1,rv1,c1,c2,t1,mode1),base,n)
//        -->custom_curve_layer(1.0,1.0,5.0,w1,microfacet_ggx_vcavities_bsdf(ru1,rv1,c1,c2,t1,mode1),base,n)
//        if (mode1 == scatter_reflect);
//    weighted_layer(w1,layer,microfacet_ggx_vcavities_bsdf(ru1,rv1,c1,c2,t1,mode1),n)
//        -->custom_curve_layer(1.0,1.0,5.0,1.0-w1,microfacet_ggx_vcavities_bsdf(ru1,rv1,c1,c2,t1,mode1),layer,n)
//        if (mode1 == scatter_reflect);

//    bsdf() --> diffuse_reflection_bsdf( color(0.0), 0.0);
}

rules Make_for_ovrtx bottomup {
    // Give the empty BSDF a zero-valued carrier so mixer rules preserve the
    // weight of the non-empty child. Without these attributes, the fallback
    // empty-child rules copy the other child's attributes unscaled.
    matched_bsdf ~ bsdf()
        --> matched_bsdf [[ type = "empty",
                                  c_c = color(0.0), c_ru = 0.0, c_rv = 0.0, c_t = state::texture_tangent_u(0), c_w0 = 0.0, c_w90 = 0.0, c_n = state::normal(),
                                  g_c0 = color(0.0), g_c90 = color(0.0), g_ru = 0.0, g_rv = 0.0, g_t = state::texture_tangent_u(0), g_w0 = 0.0, g_w90 = 0.0, g_e = 5.0, g_n = state::normal(),
                                  gt_c = color(0.0), gt_w = 0.0, gt_ior = color(1.0),
                                  d_c = color(0.0), d_w = 0.0, dt_c = color(0.0), dt_w = 0.0, b_n = state::normal(),
                                  r_c = color(0.0), r_r = 0.0, r_w = 0.0, is_sheen = false,
                                  r_ms_base = bsdf(), r_ms_d_c = color(0.0), r_ms_dt_c = color(0.0), r_ms_dt_w = 0.0, r_ms_b_n = state::normal()]]
        debug_name "empty bsdf";

    //single glossy
    matched_bsdf ~ microfacet_ggx_vcavities_bsdf( ru,rv,tint,_,t,mode)
        --> matched_bsdf [[ type = "metal",
                                  c_c = color(0.0), c_ru = 0.0, c_rv = 0.0, c_t = state::texture_tangent_u(0), c_w0 = 0.0, c_w90 = 0.0,c_n = state::normal(),
                                  g_c0 = tint, g_c90 = tint, g_ru = ru, g_rv = rv, g_t = t, g_w0 = 1.0, g_w90 = 1.0, g_e = 5.0, g_n = state::normal(),
                                  gt_c = color(0.0), gt_w = 0.0, gt_ior = color(1.0),
                                  d_c = color(0.0), d_w = 0.0, dt_c = color(0.0), dt_w = 0.0, b_n = state::normal(),
                                  r_c = color(0.0), r_r = 0.0, r_w = 0.0, is_sheen = false,
                                  r_ms_base = bsdf(), r_ms_d_c = color(0.0),
                                  r_ms_dt_c = color(0.0), r_ms_dt_w = 0.0,
                                  r_ms_b_n = state::normal()]]
        if mode == scatter_reflect
        debug_name "single glossy";
    //glass
    matched_bsdf ~ microfacet_ggx_vcavities_bsdf( ru,rv,tint,ior,t,mode)
        --> matched_bsdf [[ type = "glass",
                                  c_c = color(0.0), c_ru = 0.0, c_rv = 0.0, c_t = state::texture_tangent_u(0), c_w0 = 0.0, c_w90 = 0.0,c_n = state::normal(),
                                  g_c0 = tint, g_c90 = tint, g_ru = ru, g_rv = rv, g_t = t, g_w0 = 0.04 /*ior from material?*/, g_w90 = 1.0, g_e = 5.0, g_n = state::normal(),
                                  gt_c = tint, gt_w = 1.0, gt_ior = ior,
                                  d_c = color(0.0), d_w = 0.0, dt_c = color(0.0), dt_w = 0.0, b_n = state::normal(),
                                  r_c = color(0.0), r_r = 0.0, r_w = 0.0, is_sheen = false,
                                  r_ms_base = bsdf(), r_ms_d_c = color(0.0),
                                  r_ms_dt_c = color(0.0), r_ms_dt_w = 0.0,
                                  r_ms_b_n = state::normal()]]
    if (mode == scatter_reflect_transmit) &&  ( math::max_value(ior) > 1.0); //hack: we stored ior here and it is >0 only if its a uniform value

    //glass
    matched_bsdf ~ microfacet_ggx_vcavities_bsdf( ru,rv,tint,_,t,mode)
        --> matched_bsdf [[ type = "glass",
                                  c_c = color(0.0), c_ru = 0.0, c_rv = 0.0, c_t = state::texture_tangent_u(0), c_w0 = 0.0, c_w90 = 0.0,c_n = state::normal(),
                                  g_c0 = tint, g_c90 = tint, g_ru = ru, g_rv = rv, g_t = t, g_w0 = 0.04 /*ior from material?*/, g_w90 = 1.0, g_e = 5.0, g_n = state::normal(),
                                  gt_c = tint, gt_w = 1.0, gt_ior = color(1.0),
                                  d_c = color(0.0), d_w = 0.0, dt_c = color(0.0), dt_w = 0.0, b_n = state::normal(),
                                  r_c = color(0.0), r_r = 0.0, r_w = 0.0, is_sheen = false,
                                  r_ms_base = bsdf(), r_ms_d_c = color(0.0),
                                  r_ms_dt_c = color(0.0), r_ms_dt_w = 0.0,
                                  r_ms_b_n = state::normal()]]
    if (mode == scatter_reflect_transmit)
        debug_name "glass 2";

    //glass
    matched_bsdf ~ microfacet_ggx_vcavities_bsdf( ru,rv,tint,_,t,mode)
        --> matched_bsdf [[ type = "glass",
                                  c_c = color(0.0), c_ru = 0.0, c_rv = 0.0, c_t = state::texture_tangent_u(0), c_w0 = 0.0, c_w90 = 0.0,c_n = state::normal(),
                                  g_c0 = tint, g_c90 = tint, g_ru = ru, g_rv = rv, g_t = t, g_w0 = 0.0 /*ior from material?*/, g_w90 = 0.0, g_e = 5.0, g_n = state::normal(),
                                  gt_c = tint, gt_w = 1.0, gt_ior = color(1.0),
                                  d_c = color(0.0), d_w = 0.0, dt_c = color(0.0), dt_w = 0.0, b_n = state::normal(),
                                  r_c = color(0.0), r_r = 0.0, r_w = 0.0, is_sheen = false,
                                  r_ms_base = bsdf(), r_ms_d_c = color(0.0),
                                  r_ms_dt_c = color(0.0), r_ms_dt_w = 0.0,
                                  r_ms_b_n = state::normal()]]
    if (mode == scatter_transmit);

    //single diffuse
    matched_bsdf ~ diffuse_reflection_bsdf( tint,_)
        --> matched_bsdf [[ type = "diffuse",
                                  c_c = color(0.0), c_ru = 0.0, c_rv = 0.0, c_t = state::texture_tangent_u(0), c_w0 = 0.0, c_w90 = 0.0,c_n = state::normal(),
                                  g_c0 = color(0.), g_c90 = color(0.), g_ru = 0.0, g_rv = 0.0, g_t = state::texture_tangent_u(0), g_w0 = 0.0, g_w90 = 0.0, g_e = 5.0, g_n = state::normal(),
                                  gt_c = color(0.0), gt_w = 0.0, gt_ior = color(1.0),
                                  d_c = tint, d_w = 1.0, dt_c = color(0.0), dt_w = 0.0, b_n = state::normal(),
                                  r_c = color(0.0), r_r = 0.0, r_w = 0.0, is_sheen = false,
                                  r_ms_base = bsdf(), r_ms_d_c = color(0.0),
                                  r_ms_dt_c = color(0.0), r_ms_dt_w = 0.0,
                                  r_ms_b_n = state::normal()]]
    debug_name "single diffuse";

    // Single sheen_bsdf() encoded as a bsdf_marker() combination. Keep the complete base as a
    // BSDF-valued attribute, and derive the fixed-topology multiscatter approximation from the
    // base's already flattened attributes. The small scale on directional lobes projects their
    // grazing energy into the only available diffuse carrier without brightening the full surface.
    matched_bsdf ~ bsdf_marker(tag1, tint, ru, bsdf_marker(tag2, tint2, _rv, 
      _base[[  type ,
                                  c_c ~ ms_c_c, c_ru ~ ms_c_ru, c_rv ~ ms_c_rv,
                                  c_t, c_w0 ~ ms_c_w0, c_w90 ~ ms_c_w90, c_n, //coat
                                  g_c0 ~ ms_g_c0, g_c90 ~ ms_g_c90,
                                  g_ru ~ ms_g_ru, g_rv ~ ms_g_rv, g_t,
                                  g_w0 ~ ms_g_w0, g_w90 ~ ms_g_w90, g_e, g_n, //glossy
                                  gt_c, gt_w,  gt_ior,//glass
                                  d_c  ~ d_c1,  d_w ~ d_w1,  dt_c  ~ dt_c1,  dt_w ~ dt_w1, b_n  ~ b_n1, //diffuse
                                  r_c ~ ms_r_c, r_r, r_w ~ ms_r_w, is_sheen]]
      ))
        --> matched_bsdf [[ type = "retroreflective",
                                  c_c = color(0.0), c_ru = 0.0, c_rv = 0.0, c_t = state::texture_tangent_u(0), c_w0 = 0.0, c_w90 = 0.0,c_n = state::normal(),
                                  g_c0 = color(0.), g_c90 = color(0.), g_ru = 0.0, g_rv = 0.0, g_t = state::texture_tangent_u(0), g_w0 = 0.0, g_w90 = 0.0, g_e = 5.0, g_n = state::normal(),
                                  gt_c = color(0.0), gt_w = 0.0, gt_ior = color(1.0),
                                  d_c = d_c1 * tint2, d_w = d_w1, dt_c = dt_c1, dt_w = dt_w1, b_n = b_n1,
                                  r_c = tint, r_r = ru, r_w = 1.0, is_sheen = true,
                                  r_ms_base = _base,
                                  r_ms_d_c = tint2 * effective_base_color,
                                  r_ms_dt_c = dt_c1, r_ms_dt_w = dt_w1,
                                  r_ms_b_n = b_n1]]
    if tag1 == 1 && tag2 == 2
    where effective_base_color = color(1.0)
              - (color(1.0) - math::clamp(d_c1, color(0.0), color(1.0)))
              * (color(1.0) - math::clamp(
                  0.003 * math::lerp(
                      ms_c_c * ms_c_w0,
                      ms_c_c * ms_c_w90,
                      math::clamp(1.0 - 0.5 * (ms_c_ru + ms_c_rv), 0.0, 1.0)),
                  color(0.0), color(1.0)))
              * (color(1.0) - math::clamp(
                  0.003 * math::lerp(
                      ms_g_c0 * ms_g_w0,
                      ms_g_c90 * ms_g_w90,
                      math::clamp(1.0 - 0.5 * (ms_g_ru + ms_g_rv), 0.0, 1.0)),
                  color(0.0), color(1.0)))
              * (color(1.0) - math::clamp(
                  0.003 * ms_r_c * ms_r_w, color(0.0), color(1.0)));

    //single backscattering_glossy_reflection_bsdf
    matched_bsdf ~ backscattering_glossy_reflection_bsdf( roughness, _, tint,_,_)
        --> matched_bsdf [[ type = "retroreflective",
                                  c_c = color(0.0), c_ru = 0.0, c_rv = 0.0, c_t = state::texture_tangent_u(0), c_w0 = 0.0, c_w90 = 0.0,c_n = state::normal(),
                                  g_c0 = color(0.), g_c90 = color(0.), g_ru = 0.0, g_rv = 0.0, g_t = state::texture_tangent_u(0), g_w0 = 0.0, g_w90 = 0.0, g_e = 5.0, g_n = state::normal(),
                                  gt_c = color(0.0), gt_w = 0.0, gt_ior = color(1.0),
                                  d_c = color(0.0), d_w = 0.0, dt_c = color(0.0), dt_w = 0.0, b_n = state::normal(),
                                  r_c = tint, r_r = roughness, r_w = 1.0, is_sheen = false,
                                  r_ms_base = bsdf(), r_ms_d_c = color(0.0),
                                  r_ms_dt_c = color(0.0), r_ms_dt_w = 0.0,
                                  r_ms_b_n = state::normal()]];

    //single diffuse_transmission_bsdf
    matched_bsdf ~ diffuse_transmission_bsdf( tint)
        --> matched_bsdf [[ type = "diffuse",
                                  c_c = color(0.0), c_ru = 0.0, c_rv = 0.0, c_t = state::texture_tangent_u(0), c_w0 = 0.0, c_w90 = 0.0,c_n = state::normal(),
                                  g_c0 = color(0.), g_c90 = color(0.), g_ru = 0.0, g_rv = 0.0, g_t = state::texture_tangent_u(0), g_w0 = 0.0, g_w90 = 0.0, g_e = 5.0, g_n = state::normal(),
                                  gt_c = color(0.0), gt_w = 0.0, gt_ior = color(1.0),
                                  d_c = color(0.0), d_w = 0.0, dt_c = tint, dt_w = 1.0, b_n = state::normal(),
                                  r_c = color(0.0), r_r = 0.0, r_w = 0.0, is_sheen = false,
                                  r_ms_base = bsdf(), r_ms_d_c = color(0.0),
                                  r_ms_dt_c = color(0.0), r_ms_dt_w = 0.0,
                                  r_ms_b_n = state::normal()]];
    
    //mix is a conditional. both branches represent the same
    matched_bsdf ~ weighted_layer(_,
        _[[  type ~ t1,
                                  c_c  ~ c_c1,  c_ru  ~ c_ru1,  c_rv ~ c_rv1, c_t  ~ c_t1,  c_w0 ~ c_w01, c_w90 ~ c_w901, c_n   ~ c_n1, //coat
                                  g_c0 ~ g_c01, g_c90 ~ g_c901, g_ru ~ g_ru1, g_rv ~ g_rv1, g_t  ~ g_t1,  g_w0  ~ g_w01,  g_w90 ~ g_w901, g_e ~ g_e1 , g_n ~ g_n1, //glossy
                                  gt_c ~ gt_c1, gt_w  ~ gt_w1,  gt_ior ~ gt_ior1,//glass
                                  d_c  ~ d_c1,  d_w   ~ d_w1,  dt_c  ~ dt_c1,  dt_w ~ dt_w1, b_n  ~ b_n1, //diffuse
                                  r_c  ~ r_c1 , r_r   ~ r_r1,   r_w  ~ r_w1, is_sheen ~ s1, r_ms_base ~ r_ms_base1, r_ms_d_c ~ r_ms_d_c1, r_ms_dt_c ~ r_ms_dt_c1, r_ms_dt_w ~ r_ms_dt_w1, r_ms_b_n ~ r_ms_b_n1 ]],
        _[[  type ~ t2,
                                  c_c ~ c_c2,  c_ru  ~ c_ru2, c_rv ~ c_rv2, c_t ~ c_t2,  c_w0 ~ c_w02, c_w90 ~ c_w902, c_n ~ c_n2, //coat
                                  g_c0 ~ g_c02, g_c90 ~ g_c902, g_ru ~ g_ru2, g_rv ~ g_rv2, g_t  ~ g_t2,  g_w0  ~ g_w02,  g_w90 ~ g_w902, g_e ~ g_e2, g_n ~ g_n2, //glossy
                                  gt_c ~ gt_c2, gt_w ~ gt_w2, gt_ior ~ gt_ior2,//glass
                                  d_c ~ d_c2,  d_w ~d_w2,  dt_c ~dt_c2,  dt_w ~dt_w2, b_n ~b_n2, //diffuse
                                  r_c ~r_c2,  r_r ~r_r2,   r_w ~r_w2, is_sheen ~ s2, r_ms_base ~ r_ms_base2, r_ms_d_c ~ r_ms_d_c2, r_ms_dt_c ~ r_ms_dt_c2, r_ms_dt_w ~ r_ms_dt_w2, r_ms_b_n ~ r_ms_b_n2]])[[conditional ~ condition]]
        --> matched_bsdf [[ type = t1,
                                  c_c = condition ? c_c1 : c_c2,
                                  c_ru = condition ? c_ru1 : c_ru2,
                                  c_rv = condition ? c_rv1 : c_rv2,
                                  c_t = condition ? c_t1 : c_t2,
                                  c_w0 = condition ? c_w01 : c_w02,
                                  c_w90 = condition ? c_w901 : c_w902,
                                  c_n = condition ? c_n1 : c_n2,
                                  g_c0 = condition ? g_c01 : g_c02,
                                  g_c90 = condition ? g_c901 : g_c902,
                                  g_ru = condition ? g_ru1 : g_ru2,
                                  g_rv = condition ? g_rv1 : g_rv2,
                                  g_t = condition ? g_t1 : g_t2, 
                                  g_w0 = condition ? g_w01 : g_w02,
                                  g_w90 = condition ? g_w901 : g_w902,
                                  g_e = condition ? g_e1 : g_e2,
                                  g_n = condition ? g_n1 : g_n2,
                                  gt_c = condition ? gt_c1 : gt_c2,
                                  gt_w = condition ? gt_w1 : gt_w2,
                                  gt_ior = condition ? gt_ior1 : gt_ior2,
                                  d_c = condition ? d_c1 : d_c2,
                                  d_w = condition ? d_w1 : d_w2,
                                  dt_c = condition ? dt_c1 : dt_c2,
                                  dt_w = condition ? dt_w1 : dt_w2,
                                  b_n = condition ? b_n1 : b_n2,
                                  r_c = condition ? r_c1 : r_c2,
                                  r_r = condition ? r_r1 : r_r2,
                                  r_w = condition ? r_w1 : r_w2,
                                  is_sheen = condition ? s1 : s2, r_ms_base = bsdf_conditional_operator(condition, r_ms_base1, r_ms_base2), r_ms_d_c = condition ? r_ms_d_c1 : r_ms_d_c2, r_ms_dt_c = condition ? r_ms_dt_c1 : r_ms_dt_c2, r_ms_dt_w = condition ? r_ms_dt_w1 : r_ms_dt_w2, r_ms_b_n = condition ? r_ms_b_n1 : r_ms_b_n2]] 
    if t1 == t2
    debug_name "conditional";

    //mix is a conditional
    matched_bsdf ~ weighted_layer(_,
        _[[  type ,
                                  c_c  ~ c_c1,  c_ru  ~ c_ru1,  c_rv ~ c_rv1, c_t  ~ c_t1,  c_w0 ~ c_w01, c_w90 ~ c_w901, c_n   ~ c_n1, //coat
                                  g_c0 ~ g_c01, g_c90 ~ g_c901, g_ru ~ g_ru1, g_rv ~ g_rv1, g_t  ~ g_t1,  g_w0  ~ g_w01,  g_w90 ~ g_w901, g_e ~ g_e1 , g_n ~ g_n1, //glossy
                                  gt_c ~ gt_c1, gt_w  ~ gt_w1,  gt_ior ~ gt_ior1,//glass
                                  d_c  ~ d_c1,  d_w   ~ d_w1,  dt_c  ~ dt_c1,  dt_w ~ dt_w1, b_n  ~ b_n1, //diffuse
                                  r_c  ~ r_c1 , r_r   ~ r_r1,   r_w  ~ r_w1, is_sheen ~ s1, r_ms_base ~ r_ms_base1, r_ms_d_c ~ r_ms_d_c1, r_ms_dt_c ~ r_ms_dt_c1, r_ms_dt_w ~ r_ms_dt_w1, r_ms_b_n ~ r_ms_b_n1 ]],
        _[[  type ,
                                  c_c ~ c_c2,  c_ru  ~ c_ru2, c_rv ~ c_rv2, c_t ~ c_t2,  c_w0 ~ c_w02, c_w90 ~ c_w902, c_n ~ c_n2, //coat
                                  g_c0 ~ g_c02, g_c90 ~ g_c902, g_ru ~ g_ru2, g_rv ~ g_rv2, g_t  ~ g_t2,  g_w0  ~ g_w02,  g_w90 ~ g_w902, g_e ~ g_e2, g_n ~ g_n2, //glossy
                                  gt_c ~ gt_c2, gt_w ~ gt_w2, gt_ior ~ gt_ior2,//glass
                                  d_c ~ d_c2,  d_w ~d_w2,  dt_c ~dt_c2,  dt_w ~dt_w2, b_n ~b_n2, //diffuse
                                  r_c ~r_c2,  r_r ~r_r2,   r_w ~r_w2, is_sheen ~ s2, r_ms_base ~ r_ms_base2, r_ms_d_c ~ r_ms_d_c2, r_ms_dt_c ~ r_ms_dt_c2, r_ms_dt_w ~ r_ms_dt_w2, r_ms_b_n ~ r_ms_b_n2]])[[conditional ~ condition]]
        --> matched_bsdf [[ type = "full",
                                  c_c = condition ? c_c1 : c_c2,
                                  c_ru = condition ? c_ru1 : c_ru2,
                                  c_rv = condition ? c_rv1 : c_rv2,
                                  c_t = condition ? c_t1 : c_t2,
                                  c_w0 = condition ? c_w01 : c_w02,
                                  c_w90 = condition ? c_w901 : c_w902,
                                  c_n = condition ? c_n1 : c_n2,
                                  g_c0 = condition ? g_c01 : g_c02,
                                  g_c90 = condition ? g_c901 : g_c902,
                                  g_ru = condition ? g_ru1 : g_ru2,
                                  g_rv = condition ? g_rv1 : g_rv2,
                                  g_t = condition ? g_t1 : g_t2, 
                                  g_w0 = condition ? g_w01 : g_w02,
                                  g_w90 = condition ? g_w901 : g_w902,
                                  g_e = condition ? g_e1 : g_e2,
                                  g_n = condition ? g_n1 : g_n2,
                                  gt_c = condition ? gt_c1 : gt_c2,
                                  gt_w = condition ? gt_w1 : gt_w2,
                                  gt_ior = condition ? gt_ior1 : gt_ior2,
                                  d_c = condition ? d_c1 : d_c2,
                                  d_w = condition ? d_w1 : d_w2,
                                  dt_c = condition ? dt_c1 : dt_c2,
                                  dt_w = condition ? dt_w1 : dt_w2,
                                  b_n = condition ? b_n1 : b_n2,
                                  r_c = condition ? r_c1 : r_c2,
                                  r_r = condition ? r_r1 : r_r2,
                                  r_w = condition ? r_w1 : r_w2,
                                  is_sheen = condition ? s1 : s2, r_ms_base = bsdf_conditional_operator(condition, r_ms_base1, r_ms_base2), r_ms_d_c = condition ? r_ms_d_c1 : r_ms_d_c2, r_ms_dt_c = condition ? r_ms_dt_c1 : r_ms_dt_c2, r_ms_dt_w = condition ? r_ms_dt_w1 : r_ms_dt_w2, r_ms_b_n = condition ? r_ms_b_n1 : r_ms_b_n2]] 
    debug_name "conditional";

    //mix is a conditional
    matched_bsdf ~ weighted_layer(_,
        _[[  type ,
                                  c_c  ~ c_c1,  c_ru  ~ c_ru1,  c_rv ~ c_rv1, c_t  ~ c_t1,  c_w0 ~ c_w01, c_w90 ~ c_w901, c_n   ~ c_n1, //coat
                                  g_c0 ~ g_c01, g_c90 ~ g_c901, g_ru ~ g_ru1, g_rv ~ g_rv1, g_t  ~ g_t1,  g_w0  ~ g_w01,  g_w90 ~ g_w901, g_e ~ g_e1 , g_n ~ g_n1, //glossy
                                  gt_c ~ gt_c1, gt_w  ~ gt_w1,  gt_ior ~ gt_ior1,//glass
                                  d_c  ~ d_c1,  d_w   ~ d_w1,  dt_c  ~ dt_c1,  dt_w ~ dt_w1, b_n  ~ b_n1, //diffuse
                                  r_c  ~ r_c1 , r_r   ~ r_r1,   r_w  ~ r_w1 , is_sheen ~ s1, r_ms_base ~ r_ms_base1, r_ms_d_c ~ r_ms_d_c1, r_ms_dt_c ~ r_ms_dt_c1, r_ms_dt_w ~ r_ms_dt_w1, r_ms_b_n ~ r_ms_b_n1]],
        bsdf())[[conditional ~ condition]]
        --> matched_bsdf [[ type = "full",
                                  c_c = condition ? c_c1 : color(0.0),
                                  c_ru = condition ? c_ru1 : 0.0,
                                  c_rv = condition ? c_rv1 : 0.0,
                                  c_t = condition ? c_t1 : state::texture_tangent_u(0),
                                  c_w0 = condition ? c_w01 : 0.0,
                                  c_w90 = condition ? c_w901 : 0.0,
                                  c_n = condition ? c_n1 : state::normal(),
                                  g_c0 = condition ? g_c01 : color(0.0),
                                  g_c90 = condition ? g_c901 : color(0.0),
                                  g_ru = condition ? g_ru1 : 0.0,
                                  g_rv = condition ? g_rv1 : 0.0,
                                  g_t = condition ? g_t1 : state::texture_tangent_u(0), 
                                  g_w0 = condition ? g_w01 : 0.0,
                                  g_w90 = condition ? g_w901 : 0.0,
                                  g_e = condition ? g_e1 : 5.0,
                                  g_n = condition ? g_n1 : state::normal(),
                                  gt_c = condition ? gt_c1 : color(0.0),
                                  gt_w = condition ? gt_w1 : 0.0,
                                  gt_ior = condition ? gt_ior1 : color(1.5),
                                  d_c = condition ? d_c1 : color(0.0),
                                  d_w = condition ? d_w1 : 0.0,
                                  dt_c = condition ? dt_c1 : color(0.0),
                                  dt_w = condition ? dt_w1 : 0.0,
                                  b_n = condition ? b_n1 : state::normal(),
                                  r_c = condition ? r_c1 : color(0.0),
                                  r_r = condition ? r_r1 : 0.0,
                                  r_w = condition ? r_w1 : 0.0,
                                  is_sheen = condition ? s1 : false, r_ms_base = r_ms_base1, r_ms_d_c = r_ms_d_c1, r_ms_dt_c = r_ms_dt_c1, r_ms_dt_w = r_ms_dt_w1, r_ms_b_n = r_ms_b_n1]] 
    debug_name "conditional measured bottom";

    //mix is a conditional, but one path is empty
    matched_bsdf ~ weighted_layer(_,
        bsdf(),
        _[[  type  ,
                                  c_c ~ c_c2,  c_ru  ~ c_ru2, c_rv ~ c_rv2, c_t ~ c_t2,  c_w0 ~ c_w02, c_w90 ~ c_w902, c_n ~ c_n2, //coat
                                  g_c0 ~ g_c02, g_c90 ~ g_c902, g_ru ~ g_ru2, g_rv ~ g_rv2, g_t  ~ g_t2,  g_w0  ~ g_w02,  g_w90 ~ g_w902, g_e ~ g_e2, g_n ~ g_n2, //glossy
                                  gt_c ~ gt_c2, gt_w ~ gt_w2, gt_ior ~ gt_ior2,//glass
                                  d_c ~ d_c2,  d_w ~d_w2,  dt_c ~dt_c2,  dt_w ~dt_w2, b_n ~b_n2, //diffuse
                                  r_c ~r_c2,  r_r ~r_r2,   r_w ~r_w2, is_sheen ~ s2, r_ms_base ~ r_ms_base2, r_ms_d_c ~ r_ms_d_c2, r_ms_dt_c ~ r_ms_dt_c2, r_ms_dt_w ~ r_ms_dt_w2, r_ms_b_n ~ r_ms_b_n2]])[[conditional ~ condition]]
        --> matched_bsdf [[ type = "full",
                                  c_c = condition ? color(0.0) : c_c2,
                                  c_ru = condition ? 1.0 : c_ru2,
                                  c_rv = condition ? 1.0 : c_rv2,
                                  c_t = condition ? state::texture_tangent_u(0) : c_t2,
                                  c_w0 = condition ? 0.0 : c_w02,
                                  c_w90 = condition ? 0.0 : c_w902,
                                  c_n = condition ? state::normal() : c_n2,
                                  g_c0 = condition ? color(0.0) : g_c02,
                                  g_c90 = condition ? color(0.0) : g_c902,
                                  g_ru = condition ? 1.0 : g_ru2,
                                  g_rv = condition ? 1.0 : g_rv2,
                                  g_t = condition ? state::texture_tangent_u(0) : g_t2, 
                                  g_w0 = condition ? 0.0 : g_w02,
                                  g_w90 = condition ? 0.0 : g_w902,
                                  g_e = condition ? 5.0 : g_e2,
                                  g_n = condition ? state::normal() : g_n2,
                                  gt_c = condition ? color(0.0) : gt_c2,
                                  gt_w = condition ? 0.0 : gt_w2,
                                  gt_ior = condition ? color(1.5) : gt_ior2,
                                  d_c = condition ? color(0.0) : d_c2,
                                  d_w = condition ? 0.0 : d_w2,
                                  dt_c = condition ? color(0.0) : dt_c2,
                                  dt_w = condition ? 0.0 : dt_w2,
                                  b_n = condition ? state::normal() : b_n2,
                                  r_c = condition ? color(0.0) : r_c2,
                                  r_r = condition ? 0.0 : r_r2,
                                  r_w = condition ? 0.0 : r_w2,
                                  is_sheen = condition ? false : s2, r_ms_base = r_ms_base2, r_ms_d_c = r_ms_d_c2, r_ms_dt_c = r_ms_dt_c2, r_ms_dt_w = r_ms_dt_w2, r_ms_b_n = r_ms_b_n2]] 
    debug_name "conditional measured top";

    // One path is empty (the layer).
    //
    // Since the bsdf() does not have attributes, we have to scale the base contribution
    // by 1 - layer weight. Note that normals are just taken unmodified from the base.
    //
    // Neede to support constructions like
    //   nvidia::core_definitions::blend(
    //     base: nvidia::core_definitions::diffuse(diffuse_color: color(1, 0.2, 0.2)),
    //     blend: test_black(),
    //     weight: weight);
    matched_bsdf ~ weighted_layer(w,
        bsdf(),
        _[[  type ,
                                  c_c ~ c_c2,  c_ru  ~ c_ru2, c_rv ~ c_rv2, c_t ~ c_t2,  c_w0 ~ c_w02, c_w90 ~ c_w902, c_n ~ c_n2, //coat
                                  g_c0 ~ g_c02, g_c90 ~ g_c902, g_ru ~ g_ru2, g_rv ~ g_rv2, g_t  ~ g_t2,  g_w0  ~ g_w02,  g_w90 ~ g_w902, g_e ~ g_e2, g_n ~ g_n2, //glossy
                                  gt_c ~ gt_c2, gt_w ~ gt_w2, gt_ior ~ gt_ior2,//glass
                                  d_c ~ d_c2,  d_w ~d_w2,  dt_c ~dt_c2,  dt_w ~dt_w2, b_n ~b_n2, //diffuse
                                  r_c ~r_c2,  r_r ~r_r2,   r_w ~r_w2, is_sheen ~ s2, r_ms_base ~ r_ms_base2, r_ms_d_c ~ r_ms_d_c2, r_ms_dt_c ~ r_ms_dt_c2, r_ms_dt_w ~ r_ms_dt_w2, r_ms_b_n ~ r_ms_b_n2]])
        --> matched_bsdf [[ type = "full",                                  
                                  c_c = c_c2 * ww, 
                                  c_ru = c_ru2 * ww, 
                                  c_rv = c_rv2 * ww, 
                                  c_t = c_t2 * ww, 
                                  c_w0 = c_w02 * ww,
                                  c_w90 = c_w902 * ww,
                                  c_n = c_n2,
                                  g_c0  = g_c02 * ww,
                                  g_c90 = g_c902 * ww,
                                  g_ru = g_ru2 * ww, 
                                  g_rv = g_rv2 * ww, 
                                  g_t = g_t2 * ww,
                                  g_w0 = g_w02 * ww, 
                                  g_w90 = g_w902 * ww, 
                                  g_e = g_e2 * ww,
                                  g_n = g_n2,
                                  gt_c = gt_c2 * ww, 
                                  gt_w = gt_w2 * ww,
                                  gt_ior = gt_ior2 * ww,
                                  d_c = d_c2 * ww,
                                  d_w = d_w2 * ww,
                                  dt_c = dt_c2 * ww, 
                                  dt_w = dt_w2 * ww, 
                                  b_n = b_n2,
                                  r_c = r_c2 * ww, 
                                  r_r = r_r2 * ww, 
                                  r_w = r_w2 * ww,
                                  is_sheen = s2, r_ms_base = r_ms_base2, r_ms_d_c = r_ms_d_c2, r_ms_dt_c = r_ms_dt_c2, r_ms_dt_w = r_ms_dt_w2, r_ms_b_n = r_ms_b_n2]]
        where ww = 1.0 - w
        debug_name "measured top (1)";

    // One path is empty.
    //
    // The bsdf_marker(3) shows that this comes from a
    // weighted_layer() with a measured_bsdf() as a layer. In that case, we ignore
    // the layer's contribution completely.
    matched_bsdf ~ weighted_layer(w,
        bsdf_marker(tag, _, _, _),
        _[[  type ,
                                  c_c ~ c_c2,  c_ru  ~ c_ru2, c_rv ~ c_rv2, c_t ~ c_t2,  c_w0 ~ c_w02, c_w90 ~ c_w902, c_n ~ c_n2, //coat
                                  g_c0 ~ g_c02, g_c90 ~ g_c902, g_ru ~ g_ru2, g_rv ~ g_rv2, g_t  ~ g_t2,  g_w0  ~ g_w02,  g_w90 ~ g_w902, g_e ~ g_e2, g_n ~ g_n2, //glossy
                                  gt_c ~ gt_c2, gt_w ~ gt_w2, gt_ior ~ gt_ior2,//glass
                                  d_c ~ d_c2,  d_w ~d_w2,  dt_c ~dt_c2,  dt_w ~dt_w2, b_n ~b_n2, //diffuse
                                  r_c ~r_c2,  r_r ~r_r2,   r_w ~r_w2, is_sheen ~ s2, r_ms_base ~ r_ms_base2, r_ms_d_c ~ r_ms_d_c2, r_ms_dt_c ~ r_ms_dt_c2, r_ms_dt_w ~ r_ms_dt_w2, r_ms_b_n ~ r_ms_b_n2]])
        --> matched_bsdf [[ type = "full",                                  
                                  c_c = c_c2, 
                                  c_ru = c_ru2, 
                                  c_rv = c_rv2, 
                                  c_t = c_t2, 
                                  c_w0 = c_w02*w,
                                  c_w90 = c_w902*w,
                                  c_n = c_n2,
                                  g_c0  = g_c02,
                                  g_c90 = g_c902,
                                  g_ru = g_ru2, 
                                  g_rv = g_rv2, 
                                  g_t = g_t2,
                                  g_w0 = g_w02*w, 
                                  g_w90 = g_w902*w, 
                                  g_e = g_e2,
								  g_n = g_n2,
                                  gt_c = gt_c2, 
                                  gt_w = gt_w2*w,
                                  gt_ior = gt_ior2,
                                  d_c = d_c2,
                                  d_w = d_w2*w,
                                  dt_c = dt_c2, 
                                  dt_w = dt_w2*w, 
                                  b_n = b_n2,
                                  r_c = r_c2, 
                                  r_r = r_r2*w, 
                                  r_w = r_w2*w,
                                  is_sheen = s2, r_ms_base = r_ms_base2, r_ms_d_c = r_ms_d_c2, r_ms_dt_c = r_ms_dt_c2, r_ms_dt_w = r_ms_dt_w2, r_ms_b_n = r_ms_b_n2]]
        if tag == 3
        debug_name "measured top (2)";

    // Normal added to diffuse
    //
    // All the colors and weights of the layer are scaled by the layer weight, so that the
    // black bsdf() is taken into account. Normals are not scaled, and the base normal is taken 
    // from the weighted_layer() itself.
    //
    // Needed to support constructions like
    //   nvidia::core_definitions::blend(
    //     base: test_black(),
    //     blend: nvidia::core_definitions::diffuse(diffuse_color: color(0.3, 1, 0.4)),
    //     weight: weight);
    matched_bsdf ~ weighted_layer(w, _[[  type ~ type1,
                                  c_c ~ c_c1, c_ru ~ c_ru1, c_rv ~ c_rv1, c_t ~ c_t1, c_w0 ~ c_w01, c_w90 ~ c_w901, c_n ~ c_n1, //coat
                                  g_c0 ~ g_c01, g_c90 ~ g_c901, g_ru ~ g_ru1, g_rv ~ g_rv1, g_t ~ g_t1, g_w0 ~ g_w01, g_w90 ~ g_w901, g_e ~ g_e1, g_n ~ g_n1, //glossy
                                  gt_c ~ gt_c1, gt_w ~ gt_w1, //glass
                                  d_c ~ d_c1, d_w ~ d_w1, dt_c ~ dt_c1, dt_w ~ dt_w1, b_n, //diffuse
                                  r_c ~ r_c1, r_r ~ r_r1, r_w ~ r_w1, is_sheen ~ s1, r_ms_base ~ r_ms_base1, r_ms_d_c ~ r_ms_d_c1, r_ms_dt_c ~ r_ms_dt_c1, r_ms_dt_w ~ r_ms_dt_w1, r_ms_b_n ~ r_ms_b_n1]],//retro
                            bsdf(),n)
        --> matched_bsdf [[ type = type1,
                                  c_c = c_c1 * w, c_ru = c_ru1 * w, c_rv = c_rv1 * w, c_t = c_t1 * w, c_w0 = c_w01 * w, c_w90 = c_w901 * w,c_n = c_n1,
                                  g_c0 = g_c01 * w, g_c90 = g_c901 * w, g_ru = g_ru1 * w, g_rv = g_rv1 * w, g_t = g_t1 * w, g_w0 = g_w01 * w, g_w90 = g_w901 * w, g_e = g_e1 * w, g_n = g_n1,
                                  gt_c = gt_c1 * w, gt_w = gt_w1 * w, gt_ior = color(1.0) * w,
                                  d_c = d_c1 * w, d_w = d_w1 * w, dt_c = dt_c1 * w, dt_w = dt_w1 * w, b_n = n,
                                  r_c = r_c1 * w, r_r = r_r1 * w, r_w  = r_w1 * w, is_sheen = s1, r_ms_base = r_ms_base1, r_ms_d_c = r_ms_d_c1, r_ms_dt_c = r_ms_dt_c1, r_ms_dt_w = r_ms_dt_w1, r_ms_b_n = r_ms_b_n1]]
        if type1 == "diffuse"
        debug_name "add_normal_to_diffuse (1)";

    // Normal added to diffuse where the base comes from measured_bsdf()
    //
    // In this case, the base contribution is ignored.
    matched_bsdf ~ weighted_layer(_, _[[  type ~ type1,
                                  c_c ~ c_c1, c_ru ~ c_ru1, c_rv ~ c_rv1, c_t ~ c_t1, c_w0 ~ c_w01, c_w90 ~ c_w901, c_n ~ c_n1, //coat
                                  g_c0 ~ g_c01, g_c90 ~ g_c901, g_ru ~ g_ru1, g_rv ~ g_rv1, g_t ~ g_t1, g_w0 ~ g_w01, g_w90 ~ g_w901, g_e ~ g_e1, g_n ~ g_n1, //glossy
                                  gt_c ~ gt_c1, gt_w ~ gt_w1, //glass
                                  d_c ~ d_c1, d_w ~ d_w1, dt_c ~ dt_c1, dt_w ~ dt_w1, b_n, //diffuse
                                  r_c ~ r_c1, r_r ~ r_r1, r_w ~ r_w1, is_sheen ~ s1, r_ms_base ~ r_ms_base1, r_ms_d_c ~ r_ms_d_c1, r_ms_dt_c ~ r_ms_dt_c1, r_ms_dt_w ~ r_ms_dt_w1, r_ms_b_n ~ r_ms_b_n1]],//retro
                            bsdf_marker(tag, _, _, _),n)
        --> matched_bsdf [[ type = type1,
                                  c_c = c_c1, c_ru = c_ru1, c_rv = c_rv1, c_t = c_t1, c_w0 = c_w01, c_w90 = c_w901,c_n = c_n1,
                                  g_c0 = g_c01, g_c90 = g_c901, g_ru = g_ru1, g_rv = g_rv1, g_t = g_t1, g_w0 = g_w01, g_w90 = g_w901, g_e = g_e1, g_n = g_n1,
                                  gt_c = gt_c1, gt_w = gt_w1, gt_ior = color(1.0),
                                  d_c = d_c1, d_w = d_w1, dt_c = dt_c1, dt_w = dt_w1, b_n = n,
                                  r_c = r_c1, r_r = r_r1, r_w  = r_w1, is_sheen = s1, r_ms_base = r_ms_base1, r_ms_d_c = r_ms_d_c1, r_ms_dt_c = r_ms_dt_c1, r_ms_dt_w = r_ms_dt_w1, r_ms_b_n = r_ms_b_n1]]
        if tag == 3 && type1 == "diffuse"
        debug_name "add_normal_to_diffuse (2)";

    //normal added to ggx
    matched_bsdf ~ weighted_layer(_, _[[  type ~ type1,
                                  c_c ~ c_c1, c_ru ~ c_ru1, c_rv ~ c_rv1, c_t ~ c_t1, c_w0 ~ c_w01, c_w90 ~ c_w901, c_n ~ c_n1, //coat
                                  g_c0 ~ g_c01, g_c90 ~ g_c901, g_ru ~ g_ru1, g_rv ~ g_rv1, g_t ~ g_t1, g_w0 ~ g_w01, g_w90 ~ g_w901, g_e ~ g_e1, g_n, //glossy
                                  gt_c ~ gt_c1, gt_w ~ gt_w1, //glass
                                  d_c ~ d_c1, d_w ~ d_w1, dt_c ~ dt_c1, dt_w ~ dt_w1, b_n ~b_n1, //diffuse
                                  r_c ~ r_c1, r_r ~ r_r1, r_w ~ r_w1, is_sheen ~ s1, r_ms_base ~ r_ms_base1, r_ms_d_c ~ r_ms_d_c1, r_ms_dt_c ~ r_ms_dt_c1, r_ms_dt_w ~ r_ms_dt_w1, r_ms_b_n ~ r_ms_b_n1]],//retro
                            bsdf(),n)
        --> matched_bsdf [[ type = type1,
                                  c_c = c_c1, c_ru = c_ru1, c_rv = c_rv1, c_t = c_t1, c_w0 = c_w01, c_w90 = c_w901,c_n = c_n1,
                                  g_c0 = g_c01, g_c90 = g_c901, g_ru = g_ru1, g_rv = g_rv1, g_t = g_t1, g_w0 = g_w01, g_w90 = g_w901, g_e = g_e1, g_n = n,
                                  gt_c = gt_c1, gt_w = gt_w1, gt_ior = color(1.0),
                                  d_c = d_c1, d_w = d_w1, dt_c = dt_c1, dt_w = dt_w1, b_n = b_n1,
                                  r_c = r_c1, r_r = r_r1, r_w = r_w1, is_sheen = s1, r_ms_base = r_ms_base1, r_ms_d_c = r_ms_d_c1, r_ms_dt_c = r_ms_dt_c1, r_ms_dt_w = r_ms_dt_w1, r_ms_b_n = r_ms_b_n1,normal_fixed = true]]
        if type1 == "metal"
        debug_name "add_normal_to_ggx";


    //normal added to anything
    matched_bsdf ~ weighted_layer(w, _[[  type ~ type1,
                                  c_c ~ c_c1, c_ru ~ c_ru1, c_rv ~ c_rv1, c_t ~ c_t1, c_w0 ~ c_w01, c_w90 ~ c_w901, c_n ~ c_n1, //coat
                                  g_c0 ~ g_c01, g_c90 ~ g_c901, g_ru ~ g_ru1, g_rv ~ g_rv1, g_t ~ g_t1, g_w0 ~ g_w01, g_w90 ~ g_w901, g_e ~ g_e1, g_n, //glossy
                                  gt_c ~ gt_c1, gt_w ~ gt_w1, //glass
                                  d_c ~ d_c1, d_w ~ d_w1, dt_c ~ dt_c1, dt_w ~ dt_w1, b_n , //diffuse
                                  r_c ~ r_c1, r_r ~ r_r1, r_w ~ r_w1, is_sheen ~ s1, r_ms_base ~ r_ms_base1, r_ms_d_c ~ r_ms_d_c1, r_ms_dt_c ~ r_ms_dt_c1, r_ms_dt_w ~ r_ms_dt_w1, r_ms_b_n ~ r_ms_b_n1]],//retro
                            bsdf(),n)
        --> matched_bsdf [[ type = type1,
                                  c_c = c_c1 * w, c_ru = c_ru1, c_rv = c_rv1, c_t = c_t1, c_w0 = c_w01, c_w90 = c_w901,c_n = c_n1,
                                  g_c0 = g_c01 * w, g_c90 = g_c901 * w, g_ru = g_ru1, g_rv = g_rv1, g_t = g_t1, g_w0 = g_w01, g_w90 = g_w901, g_e = g_e1, g_n = n,
                                  gt_c = gt_c1 * w, gt_w = gt_w1, gt_ior = color(1.0),
                                  d_c = d_c1 * w, d_w = d_w1, dt_c = dt_c1 * w, dt_w = dt_w1, b_n = n,
                                  r_c = r_c1 * w, r_r = r_r1, r_w = r_w1, is_sheen = s1, r_ms_base = r_ms_base1, r_ms_d_c = r_ms_d_c1, r_ms_dt_c = r_ms_dt_c1, r_ms_dt_w = r_ms_dt_w1, r_ms_b_n = r_ms_b_n1]];
    //sheen added to anything
    matched_bsdf ~ weighted_layer(w, _[[  type ~ type1,
                                  c_c , c_ru , c_rv , c_t , c_w0 , c_w90 , c_n , //coat
                                  g_c0 , g_c90 , g_ru , g_rv , g_t , g_w0 , g_w90 , g_e , g_n , //glossy
                                  gt_c , gt_w , //glass
                                  d_c ~ d_c1, d_w ~ d_w1, dt_c, dt_w, b_n , //diffuse
                                  r_c ~ r_c1, r_r ~ r_r1, r_w , is_sheen ~ s1, r_ms_base ~ r_ms_base1, r_ms_d_c ~ r_ms_d_c1, r_ms_dt_c ~ r_ms_dt_c1, r_ms_dt_w ~ r_ms_dt_w1, r_ms_b_n ~ r_ms_b_n1]],//retro
                            _[[  type ,
                                  c_c ~ c_c2, c_ru ~ c_ru2, c_rv ~ c_rv2, c_t ~ c_t2, c_w0 ~ c_w02, c_w90 ~ c_w902, c_n ~ c_n2, //coat
                                  g_c0 ~ g_c02, g_c90 ~ g_c902, g_ru ~ g_ru2, g_rv ~ g_rv2, g_t ~ g_t2, g_w0 ~ g_w02, g_w90 ~ g_w902, g_e ~ g_e2, g_n ~ g_n2, //glossy
                                  gt_c ~ gt_c2, gt_w ~ gt_w2,gt_ior ~ gt_ior2 , //glass
                                  d_c ~ d_c2, d_w ~ d_w2, dt_c ~ dt_c2, dt_w ~ dt_w2, b_n ~b_n2, //diffuse
                                  r_c , r_r , r_w ]],//retro
                          _)
        --> matched_bsdf [[ type = "diffuse_retro",
                                  c_c = c_c2, c_ru = c_ru2, c_rv = c_rv2, c_t = c_t2, c_w0 = c_w02, c_w90 = c_w902,c_n = c_n2,
                                  g_c0 = g_c02, g_c90 = g_c902, g_ru = g_ru2, g_rv = g_rv2, g_t = g_t2, g_w0 = g_w02, g_w90 = g_w902, g_e = g_e2, g_n = g_n2,
                                  gt_c = gt_c2, gt_w = gt_w2, gt_ior = gt_ior2,
                                  d_c = nvidia::distilling_support::average(d_w1 * w, d_c1, d_w2 * (1.0 - w), d_c2), d_w = d_w2,
                                  dt_c = dt_c2, dt_w = dt_w2, b_n = b_n2,
                                  r_c = r_c1, r_r = r_r1, r_w  = w, is_sheen = s1, r_ms_base = r_ms_base1, r_ms_d_c = r_ms_d_c1, r_ms_dt_c = r_ms_dt_c1, r_ms_dt_w = r_ms_dt_w1, r_ms_b_n = r_ms_b_n1]]
        if (type1 == "retroreflective") && (s1 == true)
        debug_name "sheen_over_anything!"
        ;
        
    //normal added to anything
    matched_bsdf ~ weighted_layer(w, _[[  type ~ type1,
                                  c_c ~ c_c1, c_ru ~ c_ru1, c_rv ~ c_rv1, c_t ~ c_t1, c_w0 ~ c_w01, c_w90 ~ c_w901, c_n , //coat
                                  g_c0 ~ g_c01, g_c90 ~ g_c901, g_ru ~ g_ru1, g_rv ~ g_rv1, g_t ~ g_t1, g_w0 ~ g_w01, g_w90 ~ g_w901, g_e ~ g_e1, g_n, //glossy
                                  gt_c ~ gt_c1, gt_w ~ gt_w1, //glass
                                  d_c ~ d_c1, d_w ~ d_w1, dt_c ~ dt_c1, dt_w ~ dt_w1, b_n , //diffuse
                                  r_c ~ r_c1, r_r ~ r_r1, r_w ~ r_w1, is_sheen ~ s1, r_ms_base ~ r_ms_base1, r_ms_d_c ~ r_ms_d_c1, r_ms_dt_c ~ r_ms_dt_c1, r_ms_dt_w ~ r_ms_dt_w1, r_ms_b_n ~ r_ms_b_n1]],//retro
                            _,n)
        --> matched_bsdf [[ type = type1,
                                  c_c = c_c1, c_ru = c_ru1, c_rv = c_rv1, c_t = c_t1, c_w0 = c_w01, c_w90 = c_w901,c_n = n,
                                  g_c0 = g_c01, g_c90 = g_c901, g_ru = g_ru1, g_rv = g_rv1, g_t = g_t1, g_w0 = g_w01, g_w90 = g_w901, g_e = g_e1, g_n = n,
                                  gt_c = gt_c1, gt_w = gt_w1, gt_ior = color(1.0),
                                  d_c = d_c1, d_w = d_w1, dt_c = dt_c1, dt_w = dt_w1, b_n = n,
                                  r_c = r_c1, r_r = r_r1, r_w = r_w1, is_sheen = s1, r_ms_base = r_ms_base1, r_ms_d_c = r_ms_d_c1, r_ms_dt_c = r_ms_dt_c1, r_ms_dt_w = r_ms_dt_w1, r_ms_b_n = r_ms_b_n1]]
		if w == 1.0
        debug_name "add_normal_anything"
        ;

    //metal over diffuse
    matched_bsdf ~ weighted_layer(w, _[[  type ~ type1,
                                  c_c ~ c_c1, c_ru ~ c_ru1, c_rv ~ c_rv1, c_t ~ c_t1, c_w0 ~ c_w01, c_w90 ~ c_w901, c_n ~ c_n1, //coat
                                  g_c0 ~ g_c01, g_c90 ~ g_c901, g_ru ~ g_ru1, g_rv ~ g_rv1, g_t ~ g_t1, g_w0 ~ g_w01, g_w90 ~ g_w901, g_e ~ g_e1, g_n ~ g_n1, //glossy
                                  gt_c ~ gt_c1, gt_w ~ gt_w1, //glass
                                  d_c , d_w , dt_c , dt_w , b_n , //diffuse
                                  r_c ~ r_c1, r_r ~ r_r1, r_w ~ r_w1, is_sheen ~ s1, r_ms_base ~ r_ms_base1, r_ms_d_c ~ r_ms_d_c1, r_ms_dt_c ~ r_ms_dt_c1, r_ms_dt_w ~ r_ms_dt_w1, r_ms_b_n ~ r_ms_b_n1]],//retro
                            _[[  type ~ type2,
                                  c_c , c_ru , c_rv , c_t , c_w0 , c_w90 , c_n , //coat
                                  g_c0 , g_c90 , g_ru , g_rv , g_t , g_w0 , g_w90 , g_n , //glossy
                                  gt_c , gt_w , //glass
                                  d_c ~ d_c2, d_w ~ d_w2, dt_c ~ dt_c2, dt_w ~ dt_w2, b_n ~b_n2, //diffuse
                                  r_c , r_r , r_w ]],//retro
                          n)
        --> matched_bsdf [[ type = "metalrough",
                                  c_c = c_c1, c_ru = c_ru1, c_rv = c_rv1, c_t = c_t1, c_w0 = c_w01, c_w90 = c_w901,c_n = c_n1,
                                  g_c0 = g_c01, g_c90 = g_c901, g_ru = g_ru1, g_rv = g_rv1, g_t = g_t1, g_w0 = g_w01*w, g_w90 = g_w901*w, g_e = g_e1, g_n = n,
                                  gt_c = gt_c1, gt_w = gt_w1, gt_ior = color(1.0),
                                  d_c = d_c2,d_w = d_w2,
                                  dt_c = dt_c2, dt_w = dt_w2, b_n = b_n2,
                                  r_c = r_c1, r_r = r_r1, r_w  = r_w1, is_sheen = s1, r_ms_base = r_ms_base1, r_ms_d_c = r_ms_d_c1, r_ms_dt_c = r_ms_dt_c1, r_ms_dt_w = r_ms_dt_w1, r_ms_b_n = r_ms_b_n1]]
        if (type1 == "metal") && (type2 == "diffuse") && (g_n1 == state::normal());

    //metal over diffuse, here the metal is already bumped, so the weighted layer has no effect on normal
    matched_bsdf ~ weighted_layer(w, _[[  type ~ type1,
                                  c_c ~ c_c1, c_ru ~ c_ru1, c_rv ~ c_rv1, c_t ~ c_t1, c_w0 ~ c_w01, c_w90 ~ c_w901, c_n ~ c_n1, //coat
                                  g_c0 ~ g_c01, g_c90 ~ g_c901, g_ru ~ g_ru1, g_rv ~ g_rv1, g_t ~ g_t1, g_w0 ~ g_w01, g_w90 ~ g_w901, g_e ~ g_e1, g_n ~ g_n1, //glossy
                                  gt_c ~ gt_c1, gt_w ~ gt_w1, //glass
                                  d_c , d_w , dt_c , dt_w , b_n , //diffuse
                                  r_c ~ r_c1, r_r ~ r_r1, r_w ~ r_w1, is_sheen ~ s1, r_ms_base ~ r_ms_base1, r_ms_d_c ~ r_ms_d_c1, r_ms_dt_c ~ r_ms_dt_c1, r_ms_dt_w ~ r_ms_dt_w1, r_ms_b_n ~ r_ms_b_n1]],//retro
                            _[[  type ~ type2,
                                  c_c , c_ru , c_rv , c_t , c_w0 , c_w90 , c_n , //coat
                                  g_c0 , g_c90 , g_ru , g_rv , g_t , g_w0 , g_w90 , g_n , //glossy
                                  gt_c , gt_w , //glass
                                  d_c ~ d_c2, d_w ~ d_w2, dt_c ~ dt_c2, dt_w ~ dt_w2, b_n ~b_n2, //diffuse
                                  r_c , r_r , r_w ]],//retro
                          _)
        --> matched_bsdf [[ type = type1,
                                  c_c = c_c1, c_ru = c_ru1, c_rv = c_rv1, c_t = c_t1, c_w0 = c_w01, c_w90 = c_w901,c_n = c_n1,
                                  g_c0 = g_c01, g_c90 = g_c901, g_ru = g_ru1, g_rv = g_rv1, g_t = g_t1, g_w0 = g_w01*w, g_w90 = g_w901*w, g_e = g_e1, g_n = g_n1,
                                  gt_c = gt_c1, gt_w = gt_w1, gt_ior = color(1.0),
                                  d_c = d_c2,d_w = d_w2,
                                  dt_c = dt_c2, dt_w = dt_w2, b_n = b_n2,
                                  r_c = r_c1, r_r = r_r1, r_w  = r_w1, is_sheen = s1, r_ms_base = r_ms_base1, r_ms_d_c = r_ms_d_c1, r_ms_dt_c = r_ms_dt_c1, r_ms_dt_w = r_ms_dt_w1, r_ms_b_n = r_ms_b_n1]]
        if (type1 == "metal") && (type2 == "diffuse");

    //mix of 2 diffuse
    matched_bsdf ~ weighted_layer(w, _[[  type ~ type1,
                                  c_c ~ c_c1, c_ru ~ c_ru1, c_rv ~ c_rv1, c_t ~ c_t1, c_w0 ~ c_w01, c_w90 ~ c_w901, c_n ~ c_n1, //coat
                                  g_c0 ~ g_c01, g_c90 ~ g_c901, g_ru ~ g_ru1, g_rv ~ g_rv1, g_t ~ g_t1, g_w0 ~ g_w01, g_w90 ~ g_w901, g_e ~ g_e1, g_n ~ g_n1, //glossy
                                  gt_c ~ gt_c1, gt_w ~ gt_w1, //glass
                                  d_c ~ d_c1, d_w ~ d_w1, dt_c ~ dt_c1, dt_w ~ dt_w1, b_n , //diffuse
                                  r_c ~ r_c1, r_r ~ r_r1, r_w ~ r_w1, is_sheen ~ s1, r_ms_base ~ r_ms_base1, r_ms_d_c ~ r_ms_d_c1, r_ms_dt_c ~ r_ms_dt_c1, r_ms_dt_w ~ r_ms_dt_w1, r_ms_b_n ~ r_ms_b_n1]],//retro
                            _[[  type ~ type2,
                                  c_c , c_ru , c_rv , c_t , c_w0 , c_w90 , c_n , //coat
                                  g_c0 , g_c90 , g_ru , g_rv , g_t , g_w0 , g_w90 , g_n , //glossy
                                  gt_c , gt_w , //glass
                                  d_c ~ d_c2, d_w ~ d_w2, dt_c ~ dt_c2, dt_w ~ dt_w2, b_n ~b_n2, //diffuse
                                  r_c , r_r , r_w ]],//retro
                          n)
        --> matched_bsdf [[ type = type1,
                                  c_c = c_c1, c_ru = c_ru1, c_rv = c_rv1, c_t = c_t1, c_w0 = c_w01, c_w90 = c_w901,c_n = c_n1,
                                  g_c0 = g_c01, g_c90 = g_c901, g_ru = g_ru1, g_rv = g_rv1, g_t = g_t1, g_w0 = g_w01, g_w90 = g_w901, g_e = g_e1, g_n = g_n1,
                                  gt_c = gt_c1, gt_w = gt_w1, gt_ior = color(1.0),
                                  d_c = nvidia::distilling_support::average(d_w1*w,d_c1,d_w2*(1.-w),d_c2),d_w = math::lerp(d_w2, d_w1,w),
                                  dt_c = nvidia::distilling_support::average(dt_w1*w,dt_c1,dt_w2*(1.-w),dt_c2), dt_w = math::lerp(dt_w2,dt_w1,w), b_n = math::normalize(math::lerp(b_n2,n,w)),
                                  r_c = r_c1, r_r = r_r1, r_w  = r_w1, is_sheen = s1, r_ms_base = r_ms_base1, r_ms_d_c = r_ms_d_c1, r_ms_dt_c = r_ms_dt_c1, r_ms_dt_w = r_ms_dt_w1, r_ms_b_n = r_ms_b_n1]]
        if (type1 == "diffuse") && (type2 == "diffuse");
    //mix of dielectric and metal
    matched_bsdf ~ weighted_layer(w,
        _[[  type ~ type1,
                                  c_c ~ c_c1, c_ru ~ c_ru1, c_rv ~ c_rv1, c_t ~ c_t1, c_w0 ~ c_w01, c_w90 ~ c_w901, c_n ~ c_n1, //coat
                                  g_c0 ~ g_c01, g_c90 ~ g_c901, g_ru ~ g_ru1, g_rv ~ g_rv1, g_t  ~ g_t1,  g_w0  ~ g_w01,  g_w90 ~ g_w901, g_e ~ g_e1 , g_n ~ g_n1, //glossy
                                  gt_c, gt_w, //glass
                                  d_c, d_w, dt_c, dt_w, b_n, //diffuse
                                  r_c , r_r, r_w, normal_fixed]],
        _[[  type ~ type2,
                                  c_c , c_ru , c_rv , c_t, c_w0, c_w90, c_n , //coat
                                  g_c0 ~ g_c02, g_c90 ~ g_c902, g_ru ~ g_ru2, g_rv ~ g_rv2, g_t  ~ g_t2,  g_w0  ~ g_w02,  g_w90 ~ g_w902, g_e ~ g_e2, g_n ~ g_n2, //glossy
                                  gt_c ~gt_c2, gt_w ~gt_w2 , //glass
                                  d_c ~ d_c2, d_w ~ d_w2, dt_c ~ dt_c2, dt_w ~ dt_w2, b_n ~ b_n2, //diffuse
                                  r_c ~r_c2, r_r ~r_r2, r_w ~ r_w2, is_sheen ~ s2, r_ms_base ~ r_ms_base2, r_ms_d_c ~ r_ms_d_c2, r_ms_dt_c ~ r_ms_dt_c2, r_ms_dt_w ~ r_ms_dt_w2, r_ms_b_n ~ r_ms_b_n2]],
        _)
        --> matched_bsdf [[ type = "metalrough",
                                  c_c = c_c1, c_ru = c_ru1, c_rv = c_rv1, c_t = c_t1, c_w0 = c_w01*w, c_w90 = c_w901*w,c_n = c_n1,
                                  g_c0 = math::lerp(g_c02*g_w02,g_c01*g_w01,w)/w0,
                                  g_c90 = math::lerp(g_c902*g_w902,g_c901*g_w901,w)/w90, 
                                  g_ru = math::lerp(g_ru2,g_ru1,w), g_rv = math::lerp(g_rv2,g_rv1,w), g_t = math::normalize(math::lerp(g_t2,g_t1,w)),
                                  g_w0 = w0, 
                                  g_w90 = w90, g_e = math::lerp(g_e2,g_e1,w), g_n = math::normalize(math::lerp(g_n2,g_n1,w)),
                                  gt_c = gt_c2, gt_w = gt_w2, gt_ior = color(1.0),
                                  d_c = d_c2, d_w = d_w2, dt_c = dt_c2, dt_w = dt_w2, b_n = b_n2,
                                  r_c = r_c2, r_r = r_r2, r_w = r_w2, is_sheen = s2, r_ms_base = r_ms_base2, r_ms_d_c = r_ms_d_c2, r_ms_dt_c = r_ms_dt_c2, r_ms_dt_w = r_ms_dt_w2, r_ms_b_n = r_ms_b_n2]]
        if ( (type2 == "dielectric")) && ( type1 == "metal" )
        where   w0 = math::max(math::lerp(g_w02,g_w01,w), 0.0001)
                w90 = math::max(math::lerp(g_w902,g_w901,w), 0.0001);

    //mix of dielectric and metal
    matched_bsdf ~ weighted_layer(w,
        _[[  type ~ type1,
                                  c_c ~ c_c1, c_ru ~ c_ru1, c_rv ~ c_rv1, c_t ~ c_t1, c_w0 ~ c_w01, c_w90 ~ c_w901, c_n ~ c_n1, //coat
                                  g_c0 ~ g_c01, g_c90 ~ g_c901, g_ru ~ g_ru1, g_rv ~ g_rv1, g_t  ~ g_t1,  g_w0  ~ g_w01,  g_w90 ~ g_w901, g_e ~ g_e1 , g_n, //glossy
                                  gt_c, gt_w, //glass
                                  d_c, d_w, dt_c, dt_w, b_n, //diffuse
                                  r_c , r_r, r_w]],
        _[[  type ~ type2,
                                  c_c , c_ru , c_rv , c_t, c_w0, c_w90, c_n , //coat
                                  g_c0 ~ g_c02, g_c90 ~ g_c902, g_ru ~ g_ru2, g_rv ~ g_rv2, g_t  ~ g_t2,  g_w0  ~ g_w02,  g_w90 ~ g_w902, g_e ~ g_e2, g_n ~ g_n2, //glossy
                                  gt_c ~gt_c2, gt_w ~gt_w2 , //glass
                                  d_c ~ d_c2, d_w ~ d_w2, dt_c ~ dt_c2, dt_w ~ dt_w2, b_n ~ b_n2, //diffuse
                                  r_c ~r_c2, r_r ~r_r2, r_w ~ r_w2, is_sheen ~ s2, r_ms_base ~ r_ms_base2, r_ms_d_c ~ r_ms_d_c2, r_ms_dt_c ~ r_ms_dt_c2, r_ms_dt_w ~ r_ms_dt_w2, r_ms_b_n ~ r_ms_b_n2]],
        n)
        --> matched_bsdf [[ type = "metalrough",
                                  c_c = c_c1, c_ru = c_ru1, c_rv = c_rv1, c_t = c_t1, c_w0 = c_w01*w, c_w90 = c_w901*w,c_n = c_n1,
                                  g_c0 = math::lerp(g_c02*g_w02,g_c01*g_w01,w)/w0,
                                  g_c90 = math::lerp(g_c902*g_w902,g_c901*g_w901,w)/w90, 
                                  g_ru = math::lerp(g_ru2,g_ru1,w), g_rv = math::lerp(g_rv2,g_rv1,w), g_t = math::normalize(math::lerp(g_t2,g_t1,w)),
                                  g_w0 = w0, 
                                  g_w90 = w90, g_e = math::lerp(g_e2,g_e1,w), g_n = math::normalize(math::lerp(g_n2,n,w)),
                                  gt_c = gt_c2, gt_w = gt_w2, gt_ior = color(1.0),
                                  d_c = d_c2, d_w = d_w2, dt_c = dt_c2, dt_w = dt_w2, b_n = b_n2,
                                  r_c = r_c2, r_r = r_r2, r_w = r_w2, is_sheen = s2, r_ms_base = r_ms_base2, r_ms_d_c = r_ms_d_c2, r_ms_dt_c = r_ms_dt_c2, r_ms_dt_w = r_ms_dt_w2, r_ms_b_n = r_ms_b_n2]]
        if ( (type2 == "dielectric" || type2 == "diffuse_retro")) && ( type1 == "metal" )
        where   w0 = math::max(math::lerp(g_w02,g_w01,w), 0.0001)
                w90 = math::max(math::lerp(g_w902,g_w901,w), 0.0001);

    //mix 2 metals
    matched_bsdf ~ weighted_layer(w,
        _[[  type ~ type1,
                                  c_c ~ c_c1, c_ru ~ c_ru1, c_rv ~ c_rv1, c_t ~ c_t1, c_w0 ~ c_w01, c_w90 ~ c_w901, c_n ~ c_n1, //coat
                                  g_c0 ~ g_c01, g_c90 ~ g_c901, g_ru ~ g_ru1, g_rv ~ g_rv1, g_t  ~ g_t1,  g_w0  ~ g_w01,  g_w90 ~ g_w901 , g_e ~ g_e1, g_n ~ g_n1, //glossy
                                  gt_c, gt_w, //glass
                                  d_c, d_w, dt_c, dt_w, b_n, //diffuse
                                  r_c , r_r, r_w]],
        _[[  type ~ type2,
                                  c_c , c_ru , c_rv , c_t, c_w0, c_w90, c_n , //coat
                                  g_c0 ~ g_c02, g_c90 ~ g_c902, g_ru ~ g_ru2, g_rv ~ g_rv2, g_t  ~ g_t2,  g_w0  ~ g_w02,  g_w90 ~ g_w902, g_e ~ g_e2, g_n ~ g_n2, //glossy
                                  gt_c ~gt_c2, gt_w ~gt_w2 , //glass
                                  d_c ~ d_c2, d_w ~ d_w2, dt_c ~ dt_c2, dt_w ~ dt_w2, b_n, //diffuse
                                  r_c ~r_c2, r_r ~r_r2, r_w ~ r_w2, is_sheen ~ s2, r_ms_base ~ r_ms_base2, r_ms_d_c ~ r_ms_d_c2, r_ms_dt_c ~ r_ms_dt_c2, r_ms_dt_w ~ r_ms_dt_w2, r_ms_b_n ~ r_ms_b_n2]],
        n)
        --> matched_bsdf [[ type = "metal",
                                  c_c = c_c1, c_ru = c_ru1, c_rv = c_rv1, c_t = c_t1, c_w0 = c_w01*w, c_w90 = c_w901*w,c_n = c_n1,
                                  g_c0 = w0 > 0.0001
                                      ? math::lerp(g_c02*g_w02,g_c01*g_w01,w)/w0
                                      : math::lerp(g_c02,g_c01,w),
                                  g_c90 = w90 > 0.0001
                                      ? math::lerp(g_c902*g_w902,g_c901*g_w901,w)/w90
                                      : math::lerp(g_c902,g_c901,w),
                                  g_ru = math::lerp(g_ru2,g_ru1,w), g_rv = math::lerp(g_rv2,g_rv1,w), g_t = math::normalize(math::lerp(g_t2,g_t1,w)),
                                  g_w0 = w0, g_w90 = w90, g_e = math::lerp(g_e2,g_e1,w), g_n = math::normalize(math::lerp(g_n2,g_n1,w)),
                                  gt_c = gt_c2, gt_w = gt_w2, gt_ior = color(1.0),
                                  d_c = d_c2, d_w = d_w2, dt_c = dt_c2, dt_w = dt_w2, b_n = n,
                                  r_c = r_c2, r_r = r_r2, r_w = r_w2, is_sheen = s2, r_ms_base = r_ms_base2, r_ms_d_c = r_ms_d_c2, r_ms_dt_c = r_ms_dt_c2, r_ms_dt_w = r_ms_dt_w2, r_ms_b_n = r_ms_b_n2]]
        if ( (type2 == "metal")) && ( type1 == "metal" )
        where w0 = math::lerp(g_w02,g_w01,w)
              w90 = math::lerp(g_w902,g_w901,w);
        
   matched_bsdf ~ weighted_layer(w,
        _[[  type ~ type1,
                                  c_c  ,  c_ru  ,  c_rv , c_t  ,  c_w0 , c_w90 , c_n   , //coat
                                  g_c0 ~ g_c01, g_c90 , g_ru ~ g_ru1, g_rv ~ g_rv1, g_t  ~ g_t1,  g_w0  ~ g_w01,  g_w90 ~ g_w901, g_e  , g_n , //glossy
                                  gt_c , gt_w  ,  gt_ior ,//glass
                                  d_c  ,  d_w  ,   dt_c ,  dt_w, b_n, //diffuse
                                  r_c   , r_r   ,   r_w   ]],
        _[[  type ~ type2,
                                  c_c  ,  c_ru   , c_rv , c_t  ,  c_w0 , c_w90 , c_n    , //coat
                                  g_c0 ~ g_c02, g_c90 ~ g_c902, g_ru ~ g_ru2, g_rv ~ g_rv2, g_t  ~ g_t2,  g_w0  ~ g_w02,  g_w90 ~ g_w902, g_e ~ g_e2, g_n ~ g_n2, //glossy
                                  gt_c ~ gt_c2, gt_w  ~ gt_w2 , gt_ior ~ gt_ior2,//glass
                                  d_c  ~ d_c2,  d_w   ~ d_w2,   dt_c  ~ dt_c2,  dt_w ~ dt_w2, b_n  ~ b_n2, //diffuse
                                  r_c  ~ r_c2,  r_r   ~ r_r2,   r_w  ~ r_w2, is_sheen ~ s2, r_ms_base ~ r_ms_base2, r_ms_d_c ~ r_ms_d_c2, r_ms_dt_c ~ r_ms_dt_c2, r_ms_dt_w ~ r_ms_dt_w2, r_ms_b_n ~ r_ms_b_n2]],
        _)
        --> matched_bsdf [[ type = "full",
                                  c_c = g_c01, 
                                  c_ru = g_ru1, 
                                  c_rv = g_rv1, 
                                  c_t = g_t1, 
                                  c_w0 = g_w01*w,
                                  c_w90 = g_w901*w,
                                  c_n = g_n2,
                                  g_c0  = g_c02,
                                  g_c90 = g_c902,
                                  g_ru = g_ru2, 
                                  g_rv = g_rv2, 
                                  g_t = g_t2,
                                  g_w0 = g_w02, 
                                  g_w90 = g_w902, 
                                  g_e = g_e2,
								  g_n = g_n2,
                                  gt_c = gt_c2, 
                                  gt_w = gt_w2,
                                  gt_ior = gt_ior2,
                                  d_c = d_c2,
                                  d_w = d_w2,
                                  dt_c = dt_c2, 
                                  dt_w = dt_w2, 
                                  b_n = b_n2,
                                  r_c = r_c2, 
                                  r_r = r_r2, 
                                  r_w = r_w2, is_sheen = s2, r_ms_base = r_ms_base2, r_ms_d_c = r_ms_d_c2, r_ms_dt_c = r_ms_dt_c2, r_ms_dt_w = r_ms_dt_w2, r_ms_b_n = r_ms_b_n2]]
        if ( type1 == "metal" ) && ( type2 == "glass")
        debug_name "metal over glass"                          
        ;

        matched_bsdf ~ weighted_layer(w,
        _[[  type ~ type1,
                                  c_c  ~ c_c1,  c_ru  ~ c_ru1,  c_rv ~ c_rv1, c_t  ~ c_t1,  c_w0 ~ c_w01, c_w90 ~ c_w901, c_n   , //coat
                                  g_c0 ~ g_c01, g_c90 ~ g_c901, g_ru ~ g_ru1, g_rv ~ g_rv1, g_t  ~ g_t1,  g_w0  ~ g_w01,  g_w90 ~ g_w901, g_e ~ g_e1 , g_n , //glossy
                                  gt_c , gt_w  ,  gt_ior ,//glass
                                  d_c  ,  d_w  ,   dt_c ,  dt_w, b_n, //diffuse
                                  r_c   , r_r   ,   r_w   ]],
        _[[  type,
                                  c_c  ~ c_c2,  c_ru  ~ c_ru2 , c_rv ~ c_rv2, c_t  ~ c_t2,  c_w0 ~ c_w02, c_w90 ~ c_w902, c_n   ~ c_n2 , //coat
                                  g_c0 ~ g_c02, g_c90 ~ g_c902, g_ru ~ g_ru2, g_rv ~ g_rv2, g_t  ~ g_t2,  g_w0  ~ g_w02,  g_w90 ~ g_w902, g_e ~ g_e2, g_n ~ g_n2, //glossy
                                  gt_c ~ gt_c2, gt_w  ~ gt_w2 , gt_ior ~ gt_ior2,//glass
                                  d_c  ~ d_c2,  d_w   ~ d_w2,   dt_c  ~ dt_c2,  dt_w ~ dt_w2, b_n  ~ b_n2, //diffuse
                                  r_c  ~ r_c2,  r_r   ~ r_r2,   r_w  ~ r_w2, is_sheen ~ s2, r_ms_base ~ r_ms_base2, r_ms_d_c ~ r_ms_d_c2, r_ms_dt_c ~ r_ms_dt_c2, r_ms_dt_w ~ r_ms_dt_w2, r_ms_b_n ~ r_ms_b_n2]],
        n)
        --> matched_bsdf [[ type = "full",
                                  c_c = math::lerp(c_c2,c_c1,w), 
                                  c_ru = math::lerp(c_ru2,c_ru1,w), 
                                  c_rv = math::lerp(c_rv2,c_rv1,w), 
                                  c_t = math::normalize(math::lerp(c_t2,c_t1,w)), 
                                  c_w0 = math::lerp(c_w02,c_w01,w),
                                  c_w90 = math::lerp(c_w902,c_w901,w),
                                  c_n = math::normalize(math::lerp(c_n2,n,w)),
                                  g_c0  = nvidia::distilling_support::average(g_w02 *(1.0-w),g_c02,  g_w01 *w,g_c01),
                                  g_c90 = nvidia::distilling_support::average(g_w902*(1.0-w),g_c902, g_w901*w,g_c901),
                                  g_ru = math::lerp(g_ru2,g_ru1,w), 
                                  g_rv = math::lerp(g_rv2,g_rv1,w), 
                                  g_t = math::normalize(math::lerp(g_t2,g_t1,w)),
                                  g_w0 = math::lerp(g_w02,g_w01,w), 
                                  g_w90 = math::lerp(g_w902,g_w901,w), 
                                  g_e = math::lerp(g_e2, g_e1,w),
								  g_n = math::normalize(math::lerp(g_n2,n,w)),
                                  gt_c = gt_c2, 
                                  gt_w = gt_w2*(1.-w),
                                  gt_ior = gt_ior2,
                                  d_c = d_c2,
                                  d_w = d_w2,
                                  dt_c = dt_c2, 
                                  dt_w = dt_w2, 
                                  b_n = b_n2,
                                  r_c = r_c2, 
                                  r_r = r_r2, 
                                  r_w = r_w2, is_sheen = s2, r_ms_base = r_ms_base2, r_ms_d_c = r_ms_d_c2, r_ms_dt_c = r_ms_dt_c2, r_ms_dt_w = r_ms_dt_w2, r_ms_b_n = r_ms_b_n2]]
        if ( type1 == "metal" )
        debug_name "metal over anything"                          
        ;        

    //mix of dielectric and metal with 2 lobes
    matched_bsdf ~ weighted_layer(w,
        _[[  type ~ type1,
                                  c_c ~ c_c1, c_ru ~ c_ru1, c_rv ~ c_rv1, c_t ~ c_t1, c_w0 ~ c_w01, c_w90 ~ c_w901, c_n ~ c_n1, //coat
                                  g_c0 ~ g_c01, g_c90 ~ g_c901, g_ru ~ g_ru1, g_rv ~ g_rv1, g_t  ~ g_t1,  g_w0  ~ g_w01,  g_w90 ~ g_w901, g_e ~ g_e1 , g_n ~ g_n1, //glossy
                                  gt_c, gt_w, //glass
                                  d_c, d_w, dt_c, dt_w, b_n, //diffuse
                                  r_c , r_r, r_w]],
        _[[  type ~ type2,
                                  c_c , c_ru , c_rv , c_t, c_w0, c_w90, c_n , //coat
                                  g_c0 ~ g_c02, g_c90 ~ g_c902, g_ru ~ g_ru2, g_rv ~ g_rv2, g_t  ~ g_t2,  g_w0  ~ g_w02,  g_w90 ~ g_w902, g_e ~ g_e2, g_n ~ g_n2, //glossy
                                  gt_c ~gt_c2, gt_w ~gt_w2 , //glass
                                  d_c ~ d_c2, d_w ~ d_w2, dt_c ~ dt_c2, dt_w ~ dt_w2, b_n, //diffuse
                                  r_c ~r_c2, r_r ~r_r2, r_w ~ r_w2, is_sheen ~ s2, r_ms_base ~ r_ms_base2, r_ms_d_c ~ r_ms_d_c2, r_ms_dt_c ~ r_ms_dt_c2, r_ms_dt_w ~ r_ms_dt_w2, r_ms_b_n ~ r_ms_b_n2]],
        n)
        --> matched_bsdf [[ type = "coated",
                                  c_c = c_c1, c_ru = c_ru1, c_rv = c_rv1, c_t = c_t1, c_w0 = c_w01*w, c_w90 = c_w901*w,c_n = c_n1,
                                  g_c0 = math::lerp(g_c02,g_c01,w), g_c90 = math::lerp(g_c902,g_c901,w), g_ru = math::lerp(g_ru2,g_ru1,w), g_rv = math::lerp(g_rv2,g_rv1,w), g_t = math::normalize(math::lerp(g_t2,g_t1,w)),
                                  g_w0 = math::lerp(g_w02,g_w01,w), g_w90 = math::lerp(g_w902,g_w901,w), g_e = math::lerp(g_e2, g_e1,w), g_n = math::normalize(math::lerp(g_n2,g_n1,w)),
                                  gt_c = gt_c2, gt_w = gt_w2, gt_ior = color(1.0),
                                  d_c = d_c2, d_w = d_w2, dt_c = dt_c2, dt_w = dt_w2, b_n = n,
                                  r_c = r_c2, r_r = r_r2, r_w = r_w2, is_sheen = s2, r_ms_base = r_ms_base2, r_ms_d_c = r_ms_d_c2, r_ms_dt_c = r_ms_dt_c2, r_ms_dt_w = r_ms_dt_w2, r_ms_b_n = r_ms_b_n2]]
        if ( (type2 == "dielectric")) && ( type1 == "doubleglossy" );

    //mixing diffuse and retro
    matched_bsdf ~ weighted_layer(w,
        _[[  type ~ type1,
                                  c_c  ~ c_c1,  c_ru  ~ c_ru1,  c_rv ~ c_rv1, c_t  ~ c_t1,  c_w0 ~ c_w01, c_w90 ~ c_w901, c_n   ~ c_n1, //coat
                                  g_c0 ~ g_c01, g_c90 ~ g_c901, g_ru ~ g_ru1, g_rv ~ g_rv1, g_t  ~ g_t1,  g_w0  ~ g_w01,  g_w90 ~ g_w901, g_e ~ g_e1 , g_n ~ g_n1, //glossy
                                  gt_c ~ gt_c1, gt_w  ~ gt_w1,  gt_ior ~ gt_ior1,//glass
                                  d_c  ~ d_c1,  d_w   ~ d_w1,   dt_c ~ dt_c1,  dt_w ~ dt_w1, b_n  ~ b_n1, //diffuse
                                  r_c  ~ r_c1 , r_r   ~ r_r1,   r_w  ~ r_w1 , is_sheen ~ s1, r_ms_base ~ r_ms_base1, r_ms_d_c ~ r_ms_d_c1, r_ms_dt_c ~ r_ms_dt_c1, r_ms_dt_w ~ r_ms_dt_w1, r_ms_b_n ~ r_ms_b_n1]],
        _[[  type ~ type2,
                                  c_c  ,  c_ru   , c_rv , c_t  ,  c_w0 , c_w90 , c_n , //coat
                                  g_c0 , g_c90 , g_ru , g_rv , g_t  ,  g_w0  ,  g_w90 , g_e , g_n , //glossy
                                  gt_c , gt_w   , gt_ior ,//glass
                                  d_c  ~ d_c2,  d_w   ~ d_w2,   dt_c  ~ dt_c2,  dt_w ~ dt_w2, b_n  ~ b_n2, //diffuse
                                  r_c  ~ r_c2,  r_r   ~ r_r2,   r_w  ~ r_w2, is_sheen ~ s2, r_ms_base ~ r_ms_base2, r_ms_d_c ~ r_ms_d_c2, r_ms_dt_c ~ r_ms_dt_c2, r_ms_dt_w ~ r_ms_dt_w2, r_ms_b_n ~ r_ms_b_n2]],
        _)
        --> matched_bsdf [[ type = "diffuse_retro",
                                  c_c = c_c1, c_ru = c_ru1, c_rv = c_rv1, c_t = c_t1, c_w0 = c_w01,
                                  c_w90 = c_w901,c_n = c_n1,
                                  g_c0 = g_c01,
                                  g_c90 = g_c901,
                                  g_ru = g_ru1, g_rv = g_rv1, g_t = g_t1,
                                  g_w0 = g_w01, g_w90 = g_w901, g_e = g_e1,
								  g_n = g_n1,
                                  gt_ior = gt_ior1,
                                  gt_c = gt_c1, gt_w = gt_w1,
                                  d_c = nvidia::distilling_support::average(d_w1*w,d_c1,d_w2*(1.-w),d_c2),d_w = math::lerp(d_w2, d_w1,w),
                                  dt_c = nvidia::distilling_support::average(dt_w1*w,dt_c1,dt_w2*(1.-w),dt_c2), dt_w = math::lerp(dt_w2,dt_w1,w), b_n = math::normalize(math::lerp(b_n2,b_n1,w)),
                                  r_c = nvidia::distilling_support::average(r_w1*w,r_c1,r_w2*(1.-w),r_c2), r_r = math::lerp(r_r2,r_r1,w), r_w = math::lerp(r_w2,r_w1,w),
                                  is_sheen = s1 || s2, r_ms_base = bsdf_conditional_operator(s1, r_ms_base1, r_ms_base2), r_ms_d_c = !s1 ? r_ms_d_c2 : !s2 ? r_ms_d_c1 : nvidia::distilling_support::average(r_w1*w,r_ms_d_c1,r_w2*(1.0-w),r_ms_d_c2), r_ms_dt_c = !s1 ? r_ms_dt_c2 : !s2 ? r_ms_dt_c1 : nvidia::distilling_support::average(r_w1*w,r_ms_dt_c1,r_w2*(1.0-w),r_ms_dt_c2), r_ms_dt_w = !s1 ? r_ms_dt_w2 : !s2 ? r_ms_dt_w1 : nvidia::distilling_support::average(r_w1*w,r_ms_dt_w1,r_w2*(1.0-w),r_ms_dt_w2), r_ms_b_n = !s1 ? r_ms_b_n2 : !s2 ? r_ms_b_n1 : math::normalize(math::lerp(r_ms_b_n2,r_ms_b_n1,w))]]
        if (( type2 == "diffuse") || (type2 == "retroreflective") || (type2 == "diffuse_retro")) && (( type1 == "diffuse") || (type1 == "retroreflective") || (type1 == "diffuse_retro"));

    //mixing glass with diffuse, this is still a dielectric base sometimes
    matched_bsdf ~ weighted_layer(w,
        _[[  type ~ type1,
                                  c_c  ~ c_c1,  c_ru  ~ c_ru1,  c_rv ~ c_rv1, c_t  ~ c_t1,  c_w0 ~ c_w01, c_w90 ~ c_w901, c_n   ~ c_n1, //coat
                                  g_c0 ~ g_c01, g_c90 ~ g_c901, g_ru ~ g_ru1, g_rv ~ g_rv1, g_t  ~ g_t1,  g_w0  ~ g_w01,  g_w90 ~ g_w901, g_e ~ g_e1 , g_n ~ g_n1, //glossy
                                  gt_c ~ gt_c1, gt_w  ~ gt_w1,  gt_ior ~ gt_ior1,//glass
                                  d_c  ,  d_w   ,   dt_c ,  dt_w , b_n  , //diffuse
                                  r_c  , r_r   ,   r_w  , is_sheen, r_ms_base, r_ms_d_c, r_ms_dt_c, r_ms_dt_w, r_ms_b_n ]],
        _[[  type ~ type2,
                                  c_c  ,  c_ru   , c_rv , c_t  ,  c_w0 , c_w90 , c_n , //coat
                                  g_c0 , g_c90 , g_ru , g_rv , g_t  ,  g_w0  ,  g_w90 , g_e , g_n , //glossy
                                  gt_c , gt_w   , gt_ior ,//glass
                                  d_c  ~ d_c2,  d_w   ~ d_w2,   dt_c  ~ dt_c2,  dt_w ~ dt_w2, b_n  ~ b_n2, //diffuse
                                  r_c  ~ r_c2,  r_r   ~ r_r2,   r_w  ~ r_w2, is_sheen ~ s2, r_ms_base ~ r_ms_base2, r_ms_d_c ~ r_ms_d_c2, r_ms_dt_c ~ r_ms_dt_c2, r_ms_dt_w ~ r_ms_dt_w2, r_ms_b_n ~ r_ms_b_n2]],
        _)
        --> matched_bsdf [[ type = "diffuse_retro",
                                  c_c = c_c1, c_ru = c_ru1, c_rv = c_rv1, c_t = c_t1, c_w0 = c_w01,
                                  c_w90 = c_w901,c_n = c_n1,
                                  g_c0 = g_c01,
                                  g_c90 = g_c901,
                                  g_ru = g_ru1, g_rv = g_rv1, g_t = g_t1,
                                  g_w0 = g_w01, g_w90 = g_w901, g_e = g_e1,
								  g_n = g_n1,
                                  gt_ior = gt_ior1,
                                  gt_c = gt_c1, 
								  gt_w = gt_w1*w,
                                  d_c = d_c2,
								  d_w = d_w2,
                                  dt_c = dt_c2, 
								  dt_w = dt_w2, 
								  b_n = b_n2,
                                  r_c = r_c2, 
                                  r_r = r_r2, 
                                  r_w = r_w2,
                                  is_sheen = s2, r_ms_base = r_ms_base2, r_ms_d_c = r_ms_d_c2, r_ms_dt_c = r_ms_dt_c2, r_ms_dt_w = r_ms_dt_w2, r_ms_b_n = r_ms_b_n2]]
        if (type1 == "glass") && (( type2 == "diffuse") || (type2 == "diffuse_retro")|| (type2 == "retroreflective"))
        debug_name "mix_glass_diffuse"
    ;

    //mixing in some diffuse
    matched_bsdf ~ weighted_layer(w,
        _[[  type,
                                  c_c  ~ c_c1,  c_ru  ~ c_ru1,  c_rv ~ c_rv1, c_t  ~ c_t1,  c_w0 ~ c_w01, c_w90 ~ c_w901, c_n   ~ c_n1, //coat
                                  g_c0 ~ g_c01, g_c90 ~ g_c901, g_ru ~ g_ru1, g_rv ~ g_rv1, g_t  ~ g_t1,  g_w0  ~ g_w01,  g_w90 ~ g_w901, g_e ~ g_e1 , g_n ~ g_n1, //glossy
                                  gt_c ~ gt_c1, gt_w  ~ gt_w1,  gt_ior ~ gt_ior1,//glass
                                  d_c  ~ d_c1,  d_w   ~ d_w1,   dt_c ~ dt_c1,  dt_w ~ dt_w1, b_n  ~ b_n1, //diffuse
                                  r_c  ~ r_c1 , r_r   ~ r_r1,   r_w  ~ r_w1 , is_sheen ~ s1, r_ms_base ~ r_ms_base1, r_ms_d_c ~ r_ms_d_c1, r_ms_dt_c ~ r_ms_dt_c1, r_ms_dt_w ~ r_ms_dt_w1, r_ms_b_n ~ r_ms_b_n1]],
        _[[  type ~ type2,
                                  c_c  ,  c_ru   , c_rv , c_t  ,  c_w0 , c_w90 , c_n , //coat
                                  g_c0 , g_c90 , g_ru , g_rv , g_t  ,  g_w0  ,  g_w90 , g_e , g_n , //glossy
                                  gt_c , gt_w   , gt_ior ,//glass
                                  d_c  ~ d_c2,  d_w   ~ d_w2,   dt_c  ~ dt_c2,  dt_w ~ dt_w2, b_n  ~ b_n2, //diffuse
                                  r_c  ~ r_c2,  r_r   ~ r_r2,   r_w  ~ r_w2, is_sheen ~ s2, r_ms_base ~ r_ms_base2, r_ms_d_c ~ r_ms_d_c2, r_ms_dt_c ~ r_ms_dt_c2, r_ms_dt_w ~ r_ms_dt_w2, r_ms_b_n ~ r_ms_b_n2]],
        _)
        --> matched_bsdf [[ type = "full",
                                  c_c = c_c1, c_ru = c_ru1, c_rv = c_rv1, c_t = c_t1, c_w0 = c_w01,
                                  c_w90 = c_w901,c_n = c_n1,
                                  g_c0 = g_c01,
                                  g_c90 = g_c901,
                                  g_ru = g_ru1, g_rv = g_rv1, g_t = g_t1,
                                  g_w0 = g_w01*w, g_w90 = g_w901*w, g_e = g_e1,
								  g_n = g_n1,
                                  gt_ior = gt_ior1,
                                  gt_c = gt_c1, gt_w = gt_w1*w,
                                  d_c = nvidia::distilling_support::average(d_w1*w,d_c1,d_w2*(1.-w),d_c2),d_w = math::lerp(d_w2, d_w1,w),
                                  //d_c = math::lerp(d_c2*d_w2,d_w1*d_c1,w)/w0,d_w = math::lerp(d_w2, d_w1,w),
                                  dt_c = nvidia::distilling_support::average(dt_w1*w,dt_c1,dt_w2*(1.-w),dt_c2), dt_w = math::lerp(dt_w2,dt_w1,w), b_n = math::normalize(math::lerp(b_n2,b_n1,w)),
                                  r_c = nvidia::distilling_support::average(r_w1*w,r_c1,r_w2*(1.-w),r_c2), 
                                  r_r = math::lerp(r_r2,r_r1,w), 
                                  r_w = math::lerp(r_w2,r_w1,w),
                                  is_sheen = s1 || s2, r_ms_base = bsdf_conditional_operator(s1, r_ms_base1, r_ms_base2), r_ms_d_c = !s1 ? r_ms_d_c2 : !s2 ? r_ms_d_c1 : nvidia::distilling_support::average(r_w1*w,r_ms_d_c1,r_w2*(1.0-w),r_ms_d_c2), r_ms_dt_c = !s1 ? r_ms_dt_c2 : !s2 ? r_ms_dt_c1 : nvidia::distilling_support::average(r_w1*w,r_ms_dt_c1,r_w2*(1.0-w),r_ms_dt_c2), r_ms_dt_w = !s1 ? r_ms_dt_w2 : !s2 ? r_ms_dt_w1 : nvidia::distilling_support::average(r_w1*w,r_ms_dt_w1,r_w2*(1.0-w),r_ms_dt_w2), r_ms_b_n = !s1 ? r_ms_b_n2 : !s2 ? r_ms_b_n1 : math::normalize(math::lerp(r_ms_b_n2,r_ms_b_n1,w))]]
        if ( type2 == "diffuse") || (type2 == "diffuse_retro")|| (type2 == "retroreflective")
        //where   w0 = math::max(math::lerp(d_w2,d_w1,w), 0.0001)
        debug_name "mix_diffuse_into_anything"
    ;



    //mixing in some diffuse
    matched_bsdf ~ weighted_layer(w,
        _[[  type ~ type1,
                                  c_c ,  c_ru  ,  c_rv , c_t  ,  c_w0 , c_w90 , c_n   , //coat
                                  g_c0 , g_c90 , g_ru , g_rv , g_t  ,  g_w0  ,  g_w90 , g_e  , g_n , //glossy
                                  gt_c , gt_w  ,  gt_ior ,//glass
                                  d_c  ~ d_c1,  d_w   ~ d_w1,   dt_c ~ dt_c1,  dt_w ~ dt_w1, b_n, //diffuse
                                  r_c  ~ r_c1 , r_r   ~ r_r1,   r_w  ~ r_w1 , is_sheen ~ s1, r_ms_base ~ r_ms_base1, r_ms_d_c ~ r_ms_d_c1, r_ms_dt_c ~ r_ms_dt_c1, r_ms_dt_w ~ r_ms_dt_w1, r_ms_b_n ~ r_ms_b_n1]],
        _[[  type,
                                  c_c  ~ c_c2,  c_ru  ~ c_ru2 , c_rv ~ c_rv2, c_t  ~ c_t2,  c_w0 ~ c_w02, c_w90 ~ c_w902, c_n   ~ c_n2 , //coat
                                  g_c0 ~ g_c02, g_c90 ~ g_c902, g_ru ~ g_ru2, g_rv ~ g_rv2, g_t  ~ g_t2,  g_w0  ~ g_w02,  g_w90 ~ g_w902, g_e ~ g_e2, g_n ~ g_n2, //glossy
                                  gt_c ~ gt_c2, gt_w  ~ gt_w2 , gt_ior ~ gt_ior2,//glass
                                  d_c  ~ d_c2,  d_w   ~ d_w2,   dt_c  ~ dt_c2,  dt_w ~ dt_w2, b_n  ~ b_n2, //diffuse
                                  r_c  ~ r_c2,  r_r   ~ r_r2,   r_w  ~ r_w2, is_sheen ~ s2, r_ms_base ~ r_ms_base2, r_ms_d_c ~ r_ms_d_c2, r_ms_dt_c ~ r_ms_dt_c2, r_ms_dt_w ~ r_ms_dt_w2, r_ms_b_n ~ r_ms_b_n2]],
        n)
        --> matched_bsdf [[ type = "full",
                                  c_c = c_c2, c_ru = c_ru2, c_rv = c_rv2, c_t = c_t2, c_w0 = c_w02*(1.-w),
                                  c_w90 = c_w902,c_n = c_n2,
                                  g_c0 = g_c02,
                                  g_c90 = g_c902,
                                  g_ru = g_ru2, g_rv = g_rv2, g_t = g_t2,
                                  g_w0 =g_w02*(1.0-w), g_w90 = g_w902*(1.0-w), g_e = g_e2,
								  g_n = g_n2,
                                  gt_ior = gt_ior2,
                                  gt_c = gt_c2, gt_w = gt_w2*(1.0-w),
                                  d_c = nvidia::distilling_support::average(d_w1*w,d_c1,d_w2*(1.-w),d_c2),d_w = math::lerp(d_w2, d_w1,w),
                                  dt_c = nvidia::distilling_support::average(dt_w1*w,dt_c1,dt_w2*(1.-w),dt_c2), dt_w = math::lerp(dt_w2,dt_w1,w), 
                                  b_n = math::normalize(math::lerp(b_n2,n,w)),
                                  r_c = nvidia::distilling_support::average(r_w1*w,r_c1,r_w2*(1.-w),r_c2), r_r = math::lerp(r_r2,r_r1,w), r_w = math::lerp(r_w2,r_w1,w),
                                  is_sheen = s1 || s2, r_ms_base = bsdf_conditional_operator(s1, r_ms_base1, r_ms_base2), r_ms_d_c = !s1 ? r_ms_d_c2 : !s2 ? r_ms_d_c1 : nvidia::distilling_support::average(r_w1*w,r_ms_d_c1,r_w2*(1.0-w),r_ms_d_c2), r_ms_dt_c = !s1 ? r_ms_dt_c2 : !s2 ? r_ms_dt_c1 : nvidia::distilling_support::average(r_w1*w,r_ms_dt_c1,r_w2*(1.0-w),r_ms_dt_c2), r_ms_dt_w = !s1 ? r_ms_dt_w2 : !s2 ? r_ms_dt_w1 : nvidia::distilling_support::average(r_w1*w,r_ms_dt_w1,r_w2*(1.0-w),r_ms_dt_w2), r_ms_b_n = !s1 ? r_ms_b_n2 : !s2 ? r_ms_b_n1 : math::normalize(math::lerp(r_ms_b_n2,r_ms_b_n1,w))]]
       if ( type1 == "diffuse") || (type1 == "diffuse_retro")|| (type1 == "retroreflective")
           debug_name "mixing in some diffuse";

 //any mixing
    matched_bsdf ~ weighted_layer(w,
        _[[  type,
                                  c_c  ~ c_c1,  c_ru  ~ c_ru1,  c_rv ~ c_rv1, c_t  ~ c_t1,  c_w0 ~ c_w01, c_w90 ~ c_w901, c_n   ~ c_n1, //coat
                                  g_c0 ~ g_c01, g_c90 ~ g_c901, g_ru ~ g_ru1, g_rv ~ g_rv1, g_t  ~ g_t1,  g_w0  ~ g_w01,  g_w90 ~ g_w901, g_e ~ g_e1 , g_n ~ g_n1, //glossy
                                  gt_c ~ gt_c1, gt_w  ~ gt_w1,  gt_ior ~ gt_ior1,//glass
                                  d_c  ~ d_c1,  d_w   ~ d_w1,   dt_c ~ dt_c1,  dt_w ~ dt_w1, b_n  ~ b_n1, //diffuse
                                  r_c  ~ r_c1 , r_r   ~ r_r1,   r_w  ~ r_w1 , is_sheen ~ s1, r_ms_base ~ r_ms_base1, r_ms_d_c ~ r_ms_d_c1, r_ms_dt_c ~ r_ms_dt_c1, r_ms_dt_w ~ r_ms_dt_w1, r_ms_b_n ~ r_ms_b_n1]],
        _[[  type,
                                  c_c  ~ c_c2,  c_ru  ~ c_ru2 , c_rv ~ c_rv2, c_t  ~ c_t2,  c_w0 ~ c_w02, c_w90 ~ c_w902, c_n   ~ c_n2 , //coat
                                  g_c0 ~ g_c02, g_c90 ~ g_c902, g_ru ~ g_ru2, g_rv ~ g_rv2, g_t  ~ g_t2,  g_w0  ~ g_w02,  g_w90 ~ g_w902, g_e ~ g_e2, g_n ~ g_n2, //glossy
                                  gt_c ~ gt_c2, gt_w  ~ gt_w2 , gt_ior ~ gt_ior2,//glass
                                  d_c  ~ d_c2,  d_w   ~ d_w2,   dt_c  ~ dt_c2,  dt_w ~ dt_w2, b_n  ~ b_n2, //diffuse
                                  r_c  ~ r_c2,  r_r   ~ r_r2,   r_w  ~ r_w2, is_sheen ~ s2, r_ms_base ~ r_ms_base2, r_ms_d_c ~ r_ms_d_c2, r_ms_dt_c ~ r_ms_dt_c2, r_ms_dt_w ~ r_ms_dt_w2, r_ms_b_n ~ r_ms_b_n2]],
        _)
        --> matched_bsdf [[ type = "full",
                                  c_c = math::lerp(c_c2,c_c1,w), 
                                  c_ru = math::lerp(c_ru2,c_ru1,w), 
                                  c_rv = math::lerp(c_rv2,c_rv1,w), 
                                  c_t = math::normalize(math::lerp(c_t2,c_t1,w)), 
                                  c_w0 = math::lerp(c_w02,c_w01,w),
                                  c_w90 = math::lerp(c_w902,c_w901,w),
                                  c_n = math::normalize(math::lerp(c_n2,c_n1,w)),
                                  //g_c0 = math::lerp(g_c02,g_c01,w),
                                  //g_c90 = math::lerp(g_c902,g_c901,w),
                                  g_c0  = (g_w01 + g_w02 < 0.0001)? g_c01 : nvidia::distilling_support::average(g_w02 *(1.0-w),g_c02,  g_w01 *w,g_c01),
                                  g_c90 = (g_w901 + g_w902 < 0.0001)? g_c901 : nvidia::distilling_support::average(g_w902*(1.0-w),g_c902, g_w901*w,g_c901),
                                  g_ru = math::lerp(g_ru2,g_ru1,w), 
                                  g_rv = math::lerp(g_rv2,g_rv1,w), 
                                  g_t = math::normalize(math::lerp(g_t2,g_t1,w)),
                                  g_w0 = math::lerp(g_w02,g_w01,w), 
                                  g_w90 = math::lerp(g_w902,g_w901,w), 
                                  g_e = math::lerp(g_e2, g_e1,w),
								  g_n = math::normalize(math::lerp(g_n2,g_n1,w)),
                                  gt_c = nvidia::distilling_support::average(gt_w1*w,gt_c1,gt_w2*(1.-w),gt_c2), 
                                  gt_w = math::lerp(gt_w2,gt_w1,w),
                                  gt_ior = math::max(gt_ior1,gt_ior2),
                                  d_c = nvidia::distilling_support::average(d_w1*w,d_c1,d_w2*(1.-w),d_c2),
                                  d_w = math::lerp(d_w2, d_w1,w),
                                  dt_c = nvidia::distilling_support::average(dt_w1*w,dt_c1,dt_w2*(1.-w),dt_c2), 
                                  dt_w = math::lerp(dt_w2,dt_w1,w), 
                                  b_n = math::normalize(math::lerp(b_n2,b_n1,w)),
                                  r_c = nvidia::distilling_support::average(r_w1*w,r_c1,r_w2*(1.-w),r_c2), 
                                  r_r = math::lerp(r_r2,r_r1,w), 
                                  r_w = math::lerp(r_w2,r_w1,w),
                                  is_sheen = s1 || s2, r_ms_base = bsdf_conditional_operator(s1, r_ms_base1, r_ms_base2), r_ms_d_c = !s1 ? r_ms_d_c2 : !s2 ? r_ms_d_c1 : nvidia::distilling_support::average(r_w1*w,r_ms_d_c1,r_w2*(1.0-w),r_ms_d_c2), r_ms_dt_c = !s1 ? r_ms_dt_c2 : !s2 ? r_ms_dt_c1 : nvidia::distilling_support::average(r_w1*w,r_ms_dt_c1,r_w2*(1.0-w),r_ms_dt_c2), r_ms_dt_w = !s1 ? r_ms_dt_w2 : !s2 ? r_ms_dt_w1 : nvidia::distilling_support::average(r_w1*w,r_ms_dt_w1,r_w2*(1.0-w),r_ms_dt_w2), r_ms_b_n = !s1 ? r_ms_b_n2 : !s2 ? r_ms_b_n1 : math::normalize(math::lerp(r_ms_b_n2,r_ms_b_n1,w))]]
        debug_name "any weighted layer"     
        ;
    //should not be possible
/*    matched_bsdf ~ weighted_layer(w,
        l,
        b,
        _)
        --> matched_bsdf [[ type = "full",
                                  c_c = color(1.), 
                                  c_ru = 1., 
                                  c_rv = 1., 
                                  c_t = float3(1.), 
                                  c_w0 = 1.,
                                  c_w90 = 1.,
                                  c_n = float3(1.),
                                  g_c0  = color(1.),
                                  g_c90 = color(1.),
                                  g_ru = 1., 
                                  g_rv = 1., 
                                  g_t = float3(1.),
                                  g_w0 = 1., 
                                  g_w90 = 1., 
                                  g_e = 1.,
								  g_n = float3(1.),
                                  gt_c = color(1.), 
                                  gt_w = 1.,
                                  gt_ior = color(1.),
                                  d_c = color(1.),
                                  d_w = 1.,
                                  dt_c = color(1.), 
                                  dt_w = 1., 
                                  b_n = float3(1.),
                                  r_c = color(1.), 
                                  r_r = 1., 
                                  r_w = 1., is_sheen = false, r_ms_base = bsdf(), r_ms_d_c = color(0.0), r_ms_dt_c = color(0.0), r_ms_dt_w = 0.0, r_ms_b_n = state::normal() ]]
    debug_name "error"
    //debug_print(w)
    //debug_print(l)
    //debug_print(b)
    ;*/

    //mix metal-metal
    matched_bsdf ~ bsdf_mix_2(w1,
        _[[  type ~ type1,
                                  c_c  ~ c_c1,  c_ru  ~ c_ru1,  c_rv ~ c_rv1, c_t  ~ c_t1,  c_w0 ~ c_w01, c_w90 ~ c_w901, c_n   ~ c_n1, //coat
                                  g_c0 ~ g_c01, g_c90 ~ g_c901, g_ru ~ g_ru1, g_rv ~ g_rv1, g_t  ~ g_t1,  g_w0  ~ g_w01,  g_w90 ~ g_w901, g_e ~ g_e1 , g_n ~ g_n1, //glossy
                                  gt_c ~ gt_c1, gt_w  ~ gt_w1,  gt_ior ~ gt_ior1,//glass
                                  d_c  ~ d_c1,  d_w   ~ d_w1,  dt_c  ~ dt_c1,  dt_w ~ dt_w1, b_n  ~ b_n1, //diffuse
                                  r_c  ~ r_c1 , r_r   ~ r_r1,   r_w  ~ r_w1 , is_sheen ~ s1, r_ms_base ~ r_ms_base1, r_ms_d_c ~ r_ms_d_c1, r_ms_dt_c ~ r_ms_dt_c1, r_ms_dt_w ~ r_ms_dt_w1, r_ms_b_n ~ r_ms_b_n1]],
        w2,
        _[[  type ~ type2,
                                  c_c ,  c_ru  , c_rv, c_t ,  c_w0 , c_w90 , c_n , //coat
                                  g_c0 ~ g_c02, g_c90 ~ g_c902, g_ru ~ g_ru2, g_rv ~ g_rv2, g_t  ~ g_t2,  g_w0  ~ g_w02,  g_w90 ~ g_w902, g_e ~ g_e2, g_n ~ g_n2, //glossy
                                  gt_c , gt_w  , gt_ior ,//glass
                                  d_c ,  d_w ,  dt_c ,  dt_w , b_n , //diffuse
                                  r_c ,  r_r ,   r_w ]])
        --> matched_bsdf [[ type = "metal",
                                  c_c = c_c1,
                                  c_ru = c_ru1,
                                  c_rv = c_rv1,
                                  c_t = c_t1,
                                  c_w0 = c_w01,
                                  c_w90 = c_w901,
                                  c_n = c_n1,
                                  g_c0 = nvidia::distilling_support::average(w1,g_c01,w2,g_c02),
                                  g_c90 = nvidia::distilling_support::average(w1,g_c901,w2,g_c902),
                                  g_ru = nvidia::distilling_support::average(w1,g_ru1,w2,g_ru2),
                                  g_rv = nvidia::distilling_support::average(w1,g_rv1,w2,g_rv2),
                                  g_t = (w1+w2)> 0.0?math::normalize(w1*g_t1+w2*g_t2):state::texture_tangent_u(0),
                                  g_w0 = nvidia::distilling_support::average(w1,g_w01,w2,g_w02),
                                  g_w90 = nvidia::distilling_support::average(w1,g_w901,w2,g_w902),
                                  g_e = nvidia::distilling_support::average(w1,g_e1,w2,g_e2),
                                  g_n = (w1+w2)> 0.0?math::normalize(w1*g_n1+w2*g_n2):state::normal(),
                                  gt_c = gt_c1,
                                  gt_w = gt_w1,
                                  gt_ior = gt_ior1,
                                  d_c = d_c1,
                                  d_w = d_w1,
                                  dt_c = dt_c1,
                                  dt_w = dt_w1,
                                  b_n = b_n1,
                                  r_c = r_c1,
                                  r_r = r_r1,
                                  r_w = r_w1,
                                  is_sheen = s1, r_ms_base = r_ms_base1, r_ms_d_c = r_ms_d_c1, r_ms_dt_c = r_ms_dt_c1, r_ms_dt_w = r_ms_dt_w1, r_ms_b_n = r_ms_b_n1]]                                  
    if (type1 == "metal") && (type2 == "metal")
    debug_name "mix metal-metal"
    ;
    
    //mix metal-diffuse
    matched_bsdf ~ bsdf_mix_2(w1,
        _[[  type ~ type1,
                                  c_c  ~ c_c1,  c_ru  ~ c_ru1,  c_rv ~ c_rv1, c_t  ~ c_t1,  c_w0 ~ c_w01, c_w90 ~ c_w901, c_n   ~ c_n1, //coat
                                  g_c0 ~ g_c01, g_c90 ~ g_c901, g_ru ~ g_ru1, g_rv ~ g_rv1, g_t  ~ g_t1,  g_w0  ~ g_w01,  g_w90 ~ g_w901, g_e ~ g_e1 , g_n ~ g_n1, //glossy
                                  gt_c ~ gt_c1, gt_w  ~ gt_w1,  gt_ior ~ gt_ior1,//glass
                                  d_c  ,  d_w   ,  dt_c  ,  dt_w , b_n , //diffuse
                                  r_c  ~ r_c1 , r_r   ~ r_r1,   r_w  ~ r_w1 , is_sheen ~ s1, r_ms_base ~ r_ms_base1, r_ms_d_c ~ r_ms_d_c1, r_ms_dt_c ~ r_ms_dt_c1, r_ms_dt_w ~ r_ms_dt_w1, r_ms_b_n ~ r_ms_b_n1]], 
        w2,
        _[[  type ~ type2,
                                  c_c ,  c_ru  , c_rv, c_t ,  c_w0 , c_w90 , c_n , //coat
                                  g_c0 , g_c90, g_ru , g_rv , g_t ,  g_w0  ,  g_w90 , g_e , g_n , //glossy
                                  gt_c , gt_w  , gt_ior ,//glass
                                  d_c ~ d_c2,  d_w ~ d_w2,  dt_c ~ dt_c2,  dt_w ~ dt_w2 , b_n  ~ b_n2, //diffuse
                                  r_c ,  r_r ,   r_w ]])
        --> matched_bsdf [[ type = "metalrough",
                                  c_c = c_c1,
                                  c_ru = c_ru1,
                                  c_rv = c_rv1,
                                  c_t = c_t1,
                                  c_w0 = c_w01,
                                  c_w90 = c_w901,
                                  c_n = c_n1,
                                  g_c0 = g_c01*g_w01,
                                  g_c90 = g_c901*g_w901,
                                  
                                  g_ru = g_ru1,
                                  g_rv = g_rv1,
                                  g_t = g_t1, 

                                  g_w0 = w1,  
                                  g_w90 = w1, 
                                  
                                  g_e = g_e1,
                                  g_n = g_n1, 
                                  gt_c = gt_c1,
                                  gt_w = gt_w1,
                                  gt_ior = gt_ior1,
                                  d_c = w2*d_c2/(1.0-w1),
                                  
                                  d_w = d_w2,
                                  dt_c = dt_c2,
                                  dt_w = dt_w2,
                                  b_n = b_n2,
                                  r_c = r_c1,
                                  r_r = r_r1,
                                  r_w = r_w1, is_sheen = s1, r_ms_base = r_ms_base1, r_ms_d_c = r_ms_d_c1, r_ms_dt_c = r_ms_dt_c1, r_ms_dt_w = r_ms_dt_w1, r_ms_b_n = r_ms_b_n1]]
    if (type1 == "metal")&& (type2 == "diffuse")
    debug_name "mix metal-diffuse 1 -> metalrough"
    ;
    //mix metal-diffuse
    matched_bsdf ~ bsdf_mix_2(w1,
        _[[  type ~ type1,
                                  c_c  ~ c_c1,  c_ru  ~ c_ru1,  c_rv ~ c_rv1, c_t  ~ c_t1,  c_w0 ~ c_w01, c_w90 ~ c_w901, c_n   ~ c_n1, //coat
                                  g_c0 , g_c90 , g_ru , g_rv , g_t  ,  g_w0  ,  g_w90 , g_e  , g_n , //glossy
                                  gt_c ~ gt_c1, gt_w  ~ gt_w1,  gt_ior ~ gt_ior1,//glass
                                  d_c  ~ d_c1,  d_w   ~ d_w1,  dt_c  ~ dt_c1,  dt_w ~ dt_w1, b_n  ~ b_n1, //diffuse
                                  r_c  ~ r_c1 , r_r   ~ r_r1,   r_w  ~ r_w1 , is_sheen ~ s1, r_ms_base ~ r_ms_base1, r_ms_d_c ~ r_ms_d_c1, r_ms_dt_c ~ r_ms_dt_c1, r_ms_dt_w ~ r_ms_dt_w1, r_ms_b_n ~ r_ms_b_n1]],
        w2,
        _[[  type ~ type2,
                                  c_c ,  c_ru  , c_rv, c_t ,  c_w0 , c_w90 , c_n , //coat
                                  g_c0 ~ g_c02, g_c90 ~ g_c902, g_ru ~ g_ru2, g_rv ~ g_rv2, g_t  ~ g_t2,  g_w0  ~ g_w02,  g_w90 ~ g_w902, g_e ~ g_e2, g_n ~ g_n2, //glossy
                                  gt_c , gt_w  , gt_ior ,//glass
                                  d_c ,  d_w ,  dt_c ,  dt_w , b_n , //diffuse
                                  r_c ,  r_r ,   r_w ]])
        --> matched_bsdf [[ type = "metalrough",
                                  c_c = c_c1,
                                  c_ru = c_ru1,
                                  c_rv = c_rv1,
                                  c_t = c_t1,
                                  c_w0 = c_w01,
                                  c_w90 = c_w901,
                                  c_n = c_n1,
                                  g_c0 = g_c02*g_w02,
                                  g_c90 = g_c902*g_w902,
                                  
                                  g_ru = g_ru2,
                                  g_rv = g_rv2,
                                  g_t = g_t2, 

                                  g_w0 = w2a,  
                                  g_w90 = w2a, 
                                  
                                  g_e = g_e2,
                                  g_n = g_n2, 
                                  gt_c = gt_c1,
                                  gt_w = gt_w1,
                                  gt_ior = gt_ior1,
                                  d_c = w1a*d_c1/(1.0-w2a),
                                  
                                  d_w = d_w1,
                                  dt_c = dt_c1,
                                  dt_w = dt_w1,
                                  b_n = b_n1,
                                  r_c = r_c1,
                                  r_r = r_r1,
                                  r_w = r_w1, is_sheen = s1, r_ms_base = r_ms_base1, r_ms_d_c = r_ms_d_c1, r_ms_dt_c = r_ms_dt_c1, r_ms_dt_w = r_ms_dt_w1, r_ms_b_n = r_ms_b_n1]]
    if (type2 == "metal")&& (type1 == "diffuse")
    //normalize for axf
    where
        w1a = (w1+w2)>1.0 ? w1/(w1+w2) : w1 
        w2a = (w1+w2)>1.0 ? w2/(w1+w2) : w2 

    debug_name "mix metal-diffuse 2 -> metalrough"
    ;
    
    //mix metal-diffuse
    matched_bsdf ~ bsdf_mix_2(w1,
        _[[  type ~ type1,
                                  c_c  ~ c_c1,  c_ru  ~ c_ru1,  c_rv ~ c_rv1, c_t  ~ c_t1,  c_w0 ~ c_w01, c_w90 ~ c_w901, c_n   ~ c_n1, //coat
                                  g_c0 ~ g_c01, g_c90 ~ g_c901, g_ru ~ g_ru1, g_rv ~ g_rv1, g_t  ~ g_t1,  g_w0  ~ g_w01,  g_w90 ~ g_w901, g_e ~ g_e1 , g_n ~ g_n1, //glossy
                                  gt_c ~ gt_c1, gt_w  ~ gt_w1,  gt_ior ~ gt_ior1,//glass
                                  d_c  ~ d_c1,  d_w   ~ d_w1,  dt_c  ~ dt_c1,  dt_w ~ dt_w1, b_n  ~ b_n1, //diffuse
                                  r_c  ~ r_c1 , r_r   ~ r_r1,   r_w  ~ r_w1 , is_sheen ~ s1, r_ms_base ~ r_ms_base1, r_ms_d_c ~ r_ms_d_c1, r_ms_dt_c ~ r_ms_dt_c1, r_ms_dt_w ~ r_ms_dt_w1, r_ms_b_n ~ r_ms_b_n1]],
        w2,
        _[[  type ~ type2,
                                  c_c ,  c_ru  , c_rv, c_t ,  c_w0 , c_w90 , c_n , //coat
                                  g_c0 ~ g_c02, g_c90 ~ g_c902, g_ru ~ g_ru2, g_rv ~ g_rv2, g_t  ~ g_t2,  g_w0  ~ g_w02,  g_w90 ~ g_w902, g_e ~ g_e2, g_n ~ g_n2, //glossy
                                  gt_c , gt_w  , gt_ior ,//glass
                                  d_c ~ d_c2,  d_w ~ d_w2,  dt_c ,  dt_w , b_n , //diffuse
                                  r_c ,  r_r ,   r_w ]])
        --> matched_bsdf [[ type = "metalrough",
                                  c_c = c_c1,
                                  c_ru = c_ru1,
                                  c_rv = c_rv1,
                                  c_t = c_t1,
                                  c_w0 = c_w01,
                                  c_w90 = c_w901,
                                  c_n = c_n1,
//                                  g_c0 = nvidia::distilling_support::average(gwa1,g_c01*w1,gwa2,g_c02*w2),
//                                  g_c90 = nvidia::distilling_support::average(gwa1,g_c901*w1,gwa2,g_c902*w2),

                                  //fold old weight into tint
                                  g_c0 = nvidia::distilling_support::average(gwa1,g_c01*g_w01,gwa2,g_c02*g_w02),
                                  g_c90 = nvidia::distilling_support::average(gwa1,g_c901*g_w901,gwa2,g_c902*g_w902),
                                  
                                  g_ru = nvidia::distilling_support::average(gra1,g_ru1,gra2,g_ru2),
                                  g_rv = nvidia::distilling_support::average(gra1,g_rv1,gra2,g_rv2),
                                  g_t = (gra1+gra2)> 0.0?math::normalize(gra1*g_t1+gra2*g_t2):state::texture_tangent_u(0),

//                                  g_w0 = nvidia::distilling_support::average(w1,g_w01,w2,g_w02),
//                                  g_w90 = nvidia::distilling_support::average(w1,g_w901,w2,g_w902),

                                  //since old weight is folded into tint, weight is just w1 or w2
                                  g_w0 = w1_n + w2_n,  //nvidia::distilling_support::average(g_w01,w1,w2,g_w02),
                                  g_w90 = w1_n + w2_n, //nvidia::distilling_support::average(w1,g_w901,w2,g_w902),
                                  
                                  g_e = nvidia::distilling_support::average(gwa1,g_e1,gwa2,g_e2),
                                  g_n = (gwa1+gwa2)> 0.0?math::normalize(gwa1*g_n1+gwa2*g_n2):state::normal(),
                                  gt_c = gt_c1,
                                  gt_w = gt_w1,
                                  gt_ior = gt_ior1,
                                  
                                  //since weare transforming a mix into a layering, we need to compensate the implicit weighting with (1-wx) due to layering.
                                  d_c = w1*d_c1/( g_w02>0.0?(1.0-w2):1.0 )+w2*d_c2/( g_w02>0.0?(1.0-w2):1.0 ),
//                                  d_c = nvidia::distilling_support::average(w1*d_w1,d_c1,w2*d_w2,d_c2),

                                  d_w = nvidia::distilling_support::average(w1,d_w1,w2,d_w2),
                                  dt_c = dt_c1,
                                  dt_w = dt_w1,
                                  b_n = b_n1,
                                  r_c = r_c1,
                                  r_r = r_r1,
                                  r_w = r_w1, is_sheen = s1, r_ms_base = r_ms_base1, r_ms_d_c = r_ms_d_c1, r_ms_dt_c = r_ms_dt_c1, r_ms_dt_w = r_ms_dt_w1, r_ms_b_n = r_ms_b_n1]]
    if ((type1 == "metal") || (type1 == "diffuse")|| (type1 == "metalrough"))&& ((type2 == "metal") || (type2 == "diffuse")|| (type2 == "metalrough"))
    where 
        gra1 = math::max(gwa1, gt_w1*w1)
        gra2 = gwa2
        gwa1 = (g_w01+g_w901)/2.0*w1
        gwa2 = (g_w02+g_w902)/2.0*w2
        w1_n = (g_w01>0.0) ? w1 : 0.0 
        w2_n = (g_w02>0.0) ? w2 : 0.0 
    debug_name "mix metal-diffuse -> metalrough"
    ;

    //any mixing
    matched_bsdf ~ bsdf_mix_2(w1,
        _[[  type,
                                  c_c  ~ c_c1,  c_ru  ~ c_ru1,  c_rv ~ c_rv1, c_t  ~ c_t1,  c_w0 ~ c_w01, c_w90 ~ c_w901, c_n   ~ c_n1, //coat
                                  g_c0 ~ g_c01, g_c90 ~ g_c901, g_ru ~ g_ru1, g_rv ~ g_rv1, g_t  ~ g_t1,  g_w0  ~ g_w01,  g_w90 ~ g_w901, g_e ~ g_e1 , g_n ~ g_n1, //glossy
                                  gt_c ~ gt_c1, gt_w  ~ gt_w1,  gt_ior ~ gt_ior1,//glass
                                  d_c  ~ d_c1,  d_w   ~ d_w1,  dt_c  ~ dt_c1,  dt_w ~ dt_w1, b_n  ~ b_n1, //diffuse
                                  r_c  ~ r_c1 , r_r   ~ r_r1,   r_w  ~ r_w1 , is_sheen ~ s1, r_ms_base ~ r_ms_base1, r_ms_d_c ~ r_ms_d_c1, r_ms_dt_c ~ r_ms_dt_c1, r_ms_dt_w ~ r_ms_dt_w1, r_ms_b_n ~ r_ms_b_n1]],
        w2,
        _[[  type,
                                  c_c  ~ c_c2,  c_ru  ~ c_ru2 , c_rv ~ c_rv2, c_t  ~ c_t2,  c_w0 ~ c_w02, c_w90 ~ c_w902, c_n   ~ c_n2 , //coat
                                  g_c0 ~ g_c02, g_c90 ~ g_c902, g_ru ~ g_ru2, g_rv ~ g_rv2, g_t  ~ g_t2,  g_w0  ~ g_w02,  g_w90 ~ g_w902, g_e ~ g_e2, g_n ~ g_n2, //glossy
                                  gt_c ~ gt_c2, gt_w  ~ gt_w2 , gt_ior ~ gt_ior2,//glass
                                  d_c  ~ d_c2,  d_w   ~ d_w2,  dt_c  ~ dt_c2,  dt_w ~ dt_w2, b_n  ~ b_n2, //diffuse
                                  r_c  ~ r_c2,  r_r   ~ r_r2,   r_w  ~ r_w2, is_sheen ~ s2, r_ms_base ~ r_ms_base2, r_ms_d_c ~ r_ms_d_c2, r_ms_dt_c ~ r_ms_dt_c2, r_ms_dt_w ~ r_ms_dt_w2, r_ms_b_n ~ r_ms_b_n2]])
        --> matched_bsdf [[ type = "full",
                                  c_c = nvidia::distilling_support::average(w1,c_c1,w2,c_c2),
                                  c_ru = nvidia::distilling_support::average(w1,c_ru1,w2,c_ru2),
                                  c_rv = nvidia::distilling_support::average(w1,c_rv1,w2,c_rv2),
                                  c_t = (w1+w2)> 0.0?math::normalize(w1*c_t1+w2*c_t2):state::texture_tangent_u(0),
                                  c_w0 = nvidia::distilling_support::average(w1,c_w01,w2,c_w02),
                                  c_w90 = nvidia::distilling_support::average(w1,c_w901,w2,c_w902),
                                  c_n = (w1+w2)> 0.0?math::normalize(w1*c_n1+w2*c_n2):state::normal(),
                                  //g_c0 = g_c01+g_c02,
                                  g_c0 = nvidia::distilling_support::average(gwa1,g_c01,gwa2,g_c02),
                                  //g_c90 = g_c901+g_c902
                                  g_c90 = nvidia::distilling_support::average(gwa1,g_c901,gwa2,g_c902),
                                  g_ru = nvidia::distilling_support::average(gra1,g_ru1,gra2,g_ru2),
                                  g_rv = nvidia::distilling_support::average(gra1,g_rv1,gra2,g_rv2),
                                  g_t = (gra1+gra2)> 0.0?math::normalize(gra1*g_t1+gra2*g_t2):state::texture_tangent_u(0),
                                  g_w0 = nvidia::distilling_support::average(w1,g_w01,w2,g_w02),
                                  g_w90 = nvidia::distilling_support::average(w1,g_w901,w2,g_w902),
                                  g_e = nvidia::distilling_support::average(gwa1,g_e1,gwa2,g_e2),
                                  g_n = (gwa1+gwa2)> 0.0?math::normalize(gwa1*g_n1+gwa2*g_n2):state::normal(),
                                  
                                  gt_c = nvidia::distilling_support::average(w1,gt_c1,w2,gt_c2),
                                  gt_w = nvidia::distilling_support::average(w1,gt_w1,w2,gt_w2),
                                  gt_ior = math::max(gt_ior1,gt_ior2),
                                  d_c = w1*d_c1+w2*d_c2,
                                  d_w = nvidia::distilling_support::average(w1,d_w1,w2,d_w2),
                                  dt_c = nvidia::distilling_support::average(w1,dt_c1,w2,dt_c2),
                                  dt_w = nvidia::distilling_support::average(w1,dt_w1,w2,dt_w2),
                                  b_n = (w1+w2)> 0.0?math::normalize(w1*b_n1+w2*b_n2):state::normal(),
                                  r_c = nvidia::distilling_support::average(w1,r_c1,w2,r_c2),
                                  r_r = nvidia::distilling_support::average(w1,r_r1,w2,r_r2),
                                  r_w = nvidia::distilling_support::average(w1,r_w1,w2,r_w2),
                                  is_sheen = s1 || s2, r_ms_base = bsdf_conditional_operator(s1, r_ms_base1, r_ms_base2), r_ms_d_c = !s1 ? r_ms_d_c2 : !s2 ? r_ms_d_c1 : nvidia::distilling_support::average(r_w1*w1,r_ms_d_c1,r_w2*w2,r_ms_d_c2), r_ms_dt_c = !s1 ? r_ms_dt_c2 : !s2 ? r_ms_dt_c1 : nvidia::distilling_support::average(r_w1*w1,r_ms_dt_c1,r_w2*w2,r_ms_dt_c2), r_ms_dt_w = !s1 ? r_ms_dt_w2 : !s2 ? r_ms_dt_w1 : nvidia::distilling_support::average(r_w1*w1,r_ms_dt_w1,r_w2*w2,r_ms_dt_w2), r_ms_b_n = !s1 ? r_ms_b_n2 : !s2 ? r_ms_b_n1 : (w1+w2)>0.0 ? math::normalize(w1*r_ms_b_n1+w2*r_ms_b_n2) : state::normal()]]
                                  where 
                                    gra1 = math::max(gwa1, gt_w1*w1)
                                    gra2 = math::max(gwa2, gt_w2*w2)
                                    gwa1 = (g_w01+g_w901)/2.0*w1
                                    gwa2 = (g_w02+g_w902)/2.0*w2
                                  ;

//likely this is an entirely missing path after throwing out things (measured_bsdf)
    matched_bsdf ~ bsdf_mix_2(_,
        _[[  type ~ type1,
                                  c_c ~ c_c1, c_ru ~ c_ru1, c_rv ~ c_rv1, c_t ~ c_t1, c_w0 ~ c_w01, c_w90 ~ c_w901, c_n ~ c_n1, //coat
                                  g_c0 ~ g_c01, g_c90 ~ g_c901, g_ru ~ g_ru1, g_rv ~ g_rv1, g_t ~ g_t1, g_w0 ~ g_w01, g_w90 ~ g_w901, g_e ~ g_e1, g_n  ~ g_n1, //glossy
