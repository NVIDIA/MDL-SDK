                    material_emission(diffuse_edf(),e_i,mode)),
                material_surface(
                    custom_curve_layer(c_w01B,c_w901B,5.0,1.0,
                        microfacet_ggx_vcavities_bsdf( c_ru1B,c_rv1B,c_c1B,color(0.),c_t1B,scatter_reflect), //coat above everything
                        weighted_layer(gt_w1B,
                                                //Fix: add tint_ex to properly support tinted glass
                            bsdf_tint_ex( g_c01B,gt_c1B,microfacet_ggx_vcavities_bsdf(g_ru1B,g_rv1B,color(1.0),color(0.),g_t1B,scatter_reflect_transmit)), //glass like constructs
//                             microfacet_ggx_vcavities_bsdf(g_ru1,g_rv1,g_c01,gt_c1,g_t1,scatter_reflect_transmit), //glass like constructs
                            custom_curve_layer( g_w01B, g_w901B, 5.0, 1.0,
                                bsdf_directional_factor(g_c01B,g_c901B,/*f82_factor=*/color(1.0),g_e1B,
                                    microfacet_ggx_vcavities_bsdf( g_ru1B,g_rv1B,color(1.0),color(0.),g_t1B,scatter_reflect)), //general glossy, metal or not
                                weighted_layer(r_w1B,
                                    backscattering_glossy_reflection_bsdf(r_r1B,r_r1B,r_c1B,d_c1B,state::texture_tangent_u(0)), //retroreflectivity
                                    weighted_layer(dt_w1B,
                                        diffuse_transmission_bsdf(dt_c1B), //diffuse_transmission
                                        //weighted_layer(1.0,diffuse_reflection_bsdf( d_c1 * d_w1,0.0),bsdf(),b_n1),b_n1),b_n1), //basic diffuse
                                        weighted_layer(1.0,diffuse_reflection_bsdf( d_c1B ,0.0),bsdf(),b_n1B),b_n1B),b_n1B), //basic diffuse
                                g_n1B),
                            g_n1B),
                        c_n1B),
                    material_emission(diffuse_edf(),e_iB,modeB)),
                math::max(ior,gt_ior1),material_volume(vdf(),absorption,scattering),
                geometry)
            skip_recursion
            if typeB != "empty";

//single sided material, backside emission, sheen
    material(   thinwalled,
                material_surface(_[[
                                  c_c  ~ c_c1,  c_ru  ~ c_ru1,  c_rv ~ c_rv1, c_t  ~ c_t1,  c_w0 ~ c_w01, c_w90 ~ c_w901, c_n   ~ c_n1, //coat
                                  g_c0 ~ g_c01, g_c90 ~ g_c901, g_ru ~ g_ru1, g_rv ~ g_rv1, g_t  ~ g_t1,  g_w0  ~ g_w01,  g_w90 ~ g_w901 ,g_e ~ g_e1 , g_n ~ g_n1, //glossy
                                  gt_c ~ gt_c1, gt_w  ~ gt_w1,  gt_ior ~ gt_ior1,//glass
                                  d_c  ~ d_c1,  d_w, dt_c  ~ dt_c1,  dt_w ~ dt_w1, b_n  ~ b_n1, //diffuse
                                  r_c  ~ r_c1 , r_r   ~ r_r1,   r_w  ~ r_w1 , is_sheen ~s1,
                                  r_ms_d_c ~ r_ms_d_c1, r_ms_dt_c ~ r_ms_dt_c1,
                                  r_ms_dt_w ~ r_ms_dt_w1, r_ms_b_n ~ r_ms_b_n1]],

                    material_emission(_,_,mode) [[ e_intensity ~ e_i ]]),
                material_surface(
                _,
                material_emission(_,_,mode2) [[ e_intensity ~ e_i2 ]]),
                ior,
                material_volume(_,absorption,scattering),
                geometry) [[ use_r_ms ~ use_r_ms ]]
        --> material(thinwalled,
                material_surface(
                    custom_curve_layer(c_w01,c_w901,5.0,1.0,
                        microfacet_ggx_vcavities_bsdf( c_ru1,c_rv1,c_c1,color(0.),c_t1,scatter_reflect), //coat above everything
                        weighted_layer(gt_w1,
                                                //Fix: add tint_ex to properly support tinted glass
                            bsdf_tint_ex( g_c01,gt_c1,microfacet_ggx_vcavities_bsdf(g_ru1,g_rv1,color(1.0),color(0.),g_t1,scatter_reflect_transmit)), //glass like constructs
//                             microfacet_ggx_vcavities_bsdf(g_ru1,g_rv1,g_c01,gt_c1,g_t1,scatter_reflect_transmit), //glass like constructs
                            custom_curve_layer( g_w01, g_w901, 5.0, 1.0,
                                bsdf_directional_factor(g_c01,g_c901,/*f82_factor=*/color(1.0),g_e1,
                                    microfacet_ggx_vcavities_bsdf( g_ru1,g_rv1,color(1.0),color(0.),g_t1,scatter_reflect)), //general glossy, metal or not
                                weighted_layer(r_w1,
                                    sheen_bsdf(r_r1,r_c1,color(1.0),
                                        weighted_layer(use_r_ms ? r_ms_dt_w1 : dt_w1,
                                            diffuse_transmission_bsdf(use_r_ms ? r_ms_dt_c1 : dt_c1), //diffuse_transmission
                                            weighted_layer(1.0,diffuse_reflection_bsdf( use_r_ms ? r_ms_d_c1 : d_c1 ,0.0),bsdf(),use_r_ms ? r_ms_b_n1 : b_n1))),
                                    weighted_layer(dt_w1,
                                        diffuse_transmission_bsdf(dt_c1), //diffuse_transmission
                                        //weighted_layer(1.0,diffuse_reflection_bsdf( d_c1 * d_w1,0.0),bsdf(),b_n1),b_n1),b_n1), //basic diffuse
                                        weighted_layer(1.0,diffuse_reflection_bsdf( d_c1 ,0.0),bsdf(),b_n1),b_n1),b_n1), //basic diffuse
                                g_n1),
                            g_n1),
                        c_n1),
                    material_emission(diffuse_edf(),e_i,mode)),
                material_surface(bsdf(),material_emission(diffuse_edf(),e_i2,mode2)),
                math::max(ior,gt_ior1),material_volume(vdf(),absorption,scattering),
                geometry)
            skip_recursion
            if ( e_i2 != color(0.0) ) && s1
 ;
//single sided material, backside emission
    material(   thinwalled,
                material_surface(_[[
                                  c_c  ~ c_c1,  c_ru  ~ c_ru1,  c_rv ~ c_rv1, c_t  ~ c_t1,  c_w0 ~ c_w01, c_w90 ~ c_w901, c_n   ~ c_n1, //coat
                                  g_c0 ~ g_c01, g_c90 ~ g_c901, g_ru ~ g_ru1, g_rv ~ g_rv1, g_t  ~ g_t1,  g_w0  ~ g_w01,  g_w90 ~ g_w901 ,g_e ~ g_e1 , g_n ~ g_n1, //glossy
                                  gt_c ~ gt_c1, gt_w  ~ gt_w1,  gt_ior ~ gt_ior1,//glass
                                  d_c  ~ d_c1,  d_w, dt_c  ~ dt_c1,  dt_w ~ dt_w1, b_n  ~ b_n1, //diffuse
                                  r_c  ~ r_c1 , r_r   ~ r_r1,   r_w  ~ r_w1 ]],

                    material_emission(_,_,mode) [[ e_intensity ~ e_i ]]),
                material_surface(
                _,
                material_emission(_,_,mode2) [[ e_intensity ~ e_i2 ]]),
                ior,
                material_volume(_,absorption,scattering),
                geometry)
        --> material(thinwalled,
                material_surface(
                    custom_curve_layer(c_w01,c_w901,5.0,1.0,
                        microfacet_ggx_vcavities_bsdf( c_ru1,c_rv1,c_c1,color(0.),c_t1,scatter_reflect), //coat above everything
                        weighted_layer(gt_w1,
                                                //Fix: add tint_ex to properly support tinted glass
                            bsdf_tint_ex( g_c01,gt_c1,microfacet_ggx_vcavities_bsdf(g_ru1,g_rv1,color(1.0),color(0.),g_t1,scatter_reflect_transmit)), //glass like constructs
//                             microfacet_ggx_vcavities_bsdf(g_ru1,g_rv1,g_c01,gt_c1,g_t1,scatter_reflect_transmit), //glass like constructs
                            custom_curve_layer( g_w01, g_w901, 5.0, 1.0,
                                bsdf_directional_factor(g_c01,g_c901,/*f82_factor=*/color(1.0),g_e1,
                                    microfacet_ggx_vcavities_bsdf( g_ru1,g_rv1,color(1.0),color(0.),g_t1,scatter_reflect)), //general glossy, metal or not
                                weighted_layer(r_w1,
                                    backscattering_glossy_reflection_bsdf(r_r1,r_r1,r_c1,d_c1,state::texture_tangent_u(0)), //retroreflectivity
                                    weighted_layer(dt_w1,
                                        diffuse_transmission_bsdf(dt_c1), //diffuse_transmission
                                        //weighted_layer(1.0,diffuse_reflection_bsdf( d_c1 * d_w1,0.0),bsdf(),b_n1),b_n1),b_n1), //basic diffuse
                                        weighted_layer(1.0,diffuse_reflection_bsdf( d_c1 ,0.0),bsdf(),b_n1),b_n1),b_n1), //basic diffuse
                                g_n1),
                            g_n1),
                        c_n1),
                    material_emission(diffuse_edf(),e_i,mode)),
                material_surface(bsdf(),material_emission(diffuse_edf(),e_i2,mode2)),
                math::max(ior,gt_ior1),material_volume(vdf(),absorption,scattering),
                geometry)
            skip_recursion
            if ( e_i2 != color(0.0) )
 ;
// In class compilation a parameter-dependent backface intensity is not
// provably zero or nonzero. Preserve its emission while retaining an empty
// backface scattering slot.
    material(   thinwalled,
                material_surface(_[[
                                  c_c  ~ c_c1,  c_ru  ~ c_ru1,  c_rv ~ c_rv1, c_t  ~ c_t1,  c_w0 ~ c_w01, c_w90 ~ c_w901, c_n   ~ c_n1, //coat
                                  g_c0 ~ g_c01, g_c90 ~ g_c901, g_ru ~ g_ru1, g_rv ~ g_rv1, g_t  ~ g_t1,  g_w0  ~ g_w01,  g_w90 ~ g_w901 ,g_e ~ g_e1 , g_n ~ g_n1, //glossy
                                  gt_c ~ gt_c1, gt_w  ~ gt_w1,  gt_ior ~ gt_ior1,//glass
                                  d_c  ~ d_c1,  d_w, dt_c  ~ dt_c1,  dt_w ~ dt_w1, b_n  ~ b_n1, //diffuse
                                  r_c  ~ r_c1 , r_r   ~ r_r1,   r_w  ~ r_w1 ]],

                    material_emission(_,_,mode) [[ e_intensity ~ e_i ]]),
                material_surface(
                _,
                material_emission(_,_,mode2) [[ e_intensity ~ e_i2 ]]),
                ior,
                material_volume(_,absorption,scattering),
                geometry)
        --> material(thinwalled,
                material_surface(
                    custom_curve_layer(c_w01,c_w901,5.0,1.0,
                        microfacet_ggx_vcavities_bsdf( c_ru1,c_rv1,c_c1,color(0.),c_t1,scatter_reflect), //coat above everything
                        weighted_layer(gt_w1,
                                                //Fix: add tint_ex to properly support tinted glass
                            bsdf_tint_ex( g_c01,gt_c1,microfacet_ggx_vcavities_bsdf(g_ru1,g_rv1,color(1.0),color(0.),g_t1,scatter_reflect_transmit)), //glass like constructs
                            custom_curve_layer( g_w01, g_w901, 5.0, 1.0,
                                bsdf_directional_factor(g_c01,g_c901,/*f82_factor=*/color(1.0),g_e1,
                                    microfacet_ggx_vcavities_bsdf( g_ru1,g_rv1,color(1.0),color(0.),g_t1,scatter_reflect)), //general glossy, metal or not
                                weighted_layer(r_w1,
                                    backscattering_glossy_reflection_bsdf(r_r1,r_r1,r_c1,d_c1,state::texture_tangent_u(0)), //retroreflectivity
                                    weighted_layer(dt_w1,
                                        diffuse_transmission_bsdf(dt_c1), //diffuse_transmission
                                        weighted_layer(1.0,diffuse_reflection_bsdf( d_c1 ,0.0),bsdf(),b_n1),b_n1),b_n1), //basic diffuse
                                g_n1),
                            g_n1),
                        c_n1),
                    material_emission(diffuse_edf(),e_i,mode)),
                material_surface(bsdf(),material_emission(diffuse_edf(),e_i2,mode2)),
                math::max(ior,gt_ior1),material_volume(vdf(),absorption,scattering),
                geometry)
            skip_recursion
            maybe ( e_i2 != color(0.0) )
 ;
//single sided material, no backside emission, sheen
    material(   thinwalled,
                material_surface(_[[
                                  c_c  ~ c_c1,  c_ru  ~ c_ru1,  c_rv ~ c_rv1, c_t  ~ c_t1,  c_w0 ~ c_w01, c_w90 ~ c_w901, c_n   ~ c_n1, //coat
                                  g_c0 ~ g_c01, g_c90 ~ g_c901, g_ru ~ g_ru1, g_rv ~ g_rv1, g_t  ~ g_t1,  g_w0  ~ g_w01,  g_w90 ~ g_w901 ,g_e ~ g_e1 , g_n ~ g_n1, //glossy
                                  gt_c ~ gt_c1, gt_w  ~ gt_w1,  gt_ior ~ gt_ior1,//glass
                                  d_c  ~ d_c1,  d_w, dt_c  ~ dt_c1,  dt_w ~ dt_w1, b_n  ~ b_n1, //diffuse
                                  r_c  ~ r_c1 , r_r   ~ r_r1,   r_w  ~ r_w1 , is_sheen ~s1,
                                  r_ms_d_c ~ r_ms_d_c1, r_ms_dt_c ~ r_ms_dt_c1,
                                  r_ms_dt_w ~ r_ms_dt_w1, r_ms_b_n ~ r_ms_b_n1]],

                    material_emission(_,_,mode) [[ e_intensity ~ e_i ]]),
                _,
                ior,
                material_volume(_,absorption,scattering),
                geometry) [[ use_r_ms ~ use_r_ms ]]
        --> material(thinwalled,
                material_surface(
                    custom_curve_layer(c_w01,c_w901,5.0,1.0,
                        microfacet_ggx_vcavities_bsdf( c_ru1,c_rv1,c_c1,color(0.),c_t1,scatter_reflect), //coat above everything
                        weighted_layer(gt_w1,
                                                //Fix: add tint_ex to properly support tinted glass
                            bsdf_tint_ex( g_c01,gt_c1,microfacet_ggx_vcavities_bsdf(g_ru1,g_rv1,color(1.0),color(0.),g_t1,scatter_reflect_transmit)), //glass like constructs
//                             microfacet_ggx_vcavities_bsdf(g_ru1,g_rv1,g_c01,gt_c1,g_t1,scatter_reflect_transmit), //glass like constructs
                            custom_curve_layer( g_w01, g_w901, 5.0, 1.0,
                                bsdf_directional_factor(g_c01,g_c901,/*f82_factor=*/color(1.0),g_e1,
                                    microfacet_ggx_vcavities_bsdf( g_ru1,g_rv1,color(1.0),color(0.),g_t1,scatter_reflect)), //general glossy, metal or not
                                weighted_layer(r_w1,
                                    sheen_bsdf(r_r1,r_c1,color(1.0),
                                        weighted_layer(use_r_ms ? r_ms_dt_w1 : dt_w1,
                                            diffuse_transmission_bsdf(use_r_ms ? r_ms_dt_c1 : dt_c1), //diffuse_transmission
                                            weighted_layer(1.0,diffuse_reflection_bsdf( use_r_ms ? r_ms_d_c1 : d_c1 ,0.0),bsdf(),use_r_ms ? r_ms_b_n1 : b_n1))),
                                    weighted_layer(dt_w1,
                                        diffuse_transmission_bsdf(dt_c1), //diffuse_transmission
                                        //weighted_layer(1.0,diffuse_reflection_bsdf( d_c1 * d_w1,0.0),bsdf(),b_n1),b_n1),b_n1), //basic diffuse
                                        weighted_layer(1.0,diffuse_reflection_bsdf( d_c1 ,0.0),bsdf(),b_n1),b_n1),b_n1), //basic diffuse
                                g_n1),
                            g_n1),
                        c_n1),
                    material_emission(diffuse_edf(),e_i,mode)),
                material_surface(),
                math::max(ior,gt_ior1),material_volume(vdf(),absorption,scattering),
                geometry)
            skip_recursion 
            if s1;
//single sided material, no backside emission
    material(   thinwalled,
                material_surface(_[[
                                  c_c  ~ c_c1,  c_ru  ~ c_ru1,  c_rv ~ c_rv1, c_t  ~ c_t1,  c_w0 ~ c_w01, c_w90 ~ c_w901, c_n   ~ c_n1, //coat
                                  g_c0 ~ g_c01, g_c90 ~ g_c901, g_ru ~ g_ru1, g_rv ~ g_rv1, g_t  ~ g_t1,  g_w0  ~ g_w01,  g_w90 ~ g_w901 ,g_e ~ g_e1 , g_n ~ g_n1, //glossy
                                  gt_c ~ gt_c1, gt_w  ~ gt_w1,  gt_ior ~ gt_ior1,//glass
                                  d_c  ~ d_c1,  d_w, dt_c  ~ dt_c1,  dt_w ~ dt_w1, b_n  ~ b_n1, //diffuse
                                  r_c  ~ r_c1 , r_r   ~ r_r1,   r_w  ~ r_w1 ]],

                    material_emission(_,_,mode) [[ e_intensity ~ e_i ]]),
                _,
                ior,
                material_volume(_,absorption,scattering),
                geometry)
        --> material(thinwalled,
                material_surface(
                    custom_curve_layer(c_w01,c_w901,5.0,1.0,
                        microfacet_ggx_vcavities_bsdf( c_ru1,c_rv1,c_c1,color(0.),c_t1,scatter_reflect), //coat above everything
                        weighted_layer(gt_w1,
                                                //Fix: add tint_ex to properly support tinted glass
                            bsdf_tint_ex( g_c01,gt_c1,microfacet_ggx_vcavities_bsdf(g_ru1,g_rv1,color(1.0),color(0.),g_t1,scatter_reflect_transmit)), //glass like constructs
//                             microfacet_ggx_vcavities_bsdf(g_ru1,g_rv1,g_c01,gt_c1,g_t1,scatter_reflect_transmit), //glass like constructs
                            custom_curve_layer( g_w01, g_w901, 5.0, 1.0,
                                bsdf_directional_factor(g_c01,g_c901,/*f82_factor=*/color(1.0),g_e1,
                                    microfacet_ggx_vcavities_bsdf( g_ru1,g_rv1,color(1.0),color(0.),g_t1,scatter_reflect)), //general glossy, metal or not
                                weighted_layer(r_w1,
                                    backscattering_glossy_reflection_bsdf(r_r1,r_r1,r_c1,d_c1,state::texture_tangent_u(0)), //retroreflectivity
                                    weighted_layer(dt_w1,
                                        diffuse_transmission_bsdf(dt_c1), //diffuse_transmission
                                        //weighted_layer(1.0,diffuse_reflection_bsdf( d_c1 * d_w1,0.0),bsdf(),b_n1),b_n1),b_n1), //basic diffuse
                                        weighted_layer(1.0,diffuse_reflection_bsdf( d_c1 ,0.0),bsdf(),b_n1),b_n1),b_n1), //basic diffuse
                                g_n1),
                            g_n1),
                        c_n1),
                    material_emission(diffuse_edf(),e_i,mode)),
                material_surface(),
                math::max(ior,gt_ior1),material_volume(vdf(),absorption,scattering),
                geometry)
            skip_recursion
        debug_name "single sided material, no backside emission";

//just emission
    material(   thinwalled,
                material_surface(bsdf(),
                    material_emission(_,_,mode) [[ e_intensity ~ e_i ]]),
                material_surface(
                    _,
                    material_emission(_,_,mode2) [[ e_intensity ~ e_i2 ]]),
                ior,
                material_volume(_,absorption,scattering),
                geometry)
        --> material(thinwalled,
                material_surface(
                    custom_curve_layer(0.0,0.0,5.0,1.0,
                        microfacet_ggx_vcavities_bsdf( 0.0,0.0,color(0.0),color(0.),state::texture_tangent_u(0),scatter_reflect), //coat above everything
                        weighted_layer(0.0,
                            bsdf_tint_ex( color(0.),color(0.),microfacet_ggx_vcavities_bsdf(0.,0.,color(0.0),color(0.),state::texture_tangent_u(0),scatter_reflect_transmit)), //glass like constructs
                            custom_curve_layer( 0.0, 0.0, 5.0, 1.0,
                                bsdf_directional_factor(color(0.0),color(0.0),/*f82_factor=*/color(1.0),5.0,
                                    microfacet_ggx_vcavities_bsdf( 0.0,0.0,color(1.0),color(0.),state::texture_tangent_u(0),scatter_reflect)), //general glossy, metal or not
                                weighted_layer(0.0,
                                    backscattering_glossy_reflection_bsdf(0.0,0.0,color(0.0),color(0.0),state::texture_tangent_u(0)), //retroreflectivity
                                    weighted_layer(0.0,
                                        diffuse_transmission_bsdf(color(0.0)), //diffuse_transmission
                                        weighted_layer(1.0,diffuse_reflection_bsdf( color(0.0),0.0),bsdf(),state::normal()),state::normal()),state::normal()), //basic diffuse
                                state::normal()),
                            state::normal()),
                        state::normal()),
                    material_emission(diffuse_edf(),e_i,mode)),
                material_surface(bsdf(),material_emission(diffuse_edf(),e_i2,mode2)),
                ior,material_volume(vdf(),absorption,scattering),
                geometry)
            skip_recursion ;
            
    //the following rule should not be triggert unless something is wrong. in this case make sure postcond failes
    material(   _,
                _,
                _,
                _,
                _,
                _)
        --> material(true,
                material_surface(simple_glossy_bsdf(0.5,0.5,color(1.0,1.0,0.0),color(1.0,1.0,0.0))),
                material_surface(simple_glossy_bsdf(0.5,0.5,color(1.0,1.0,0.0),color(1.0,1.0,0.0))),
                color(1.0),
                material_volume(),
                material_geometry()
                )
            //debug_print(s)
            deadrule
            ;
            
     postcond nonode(simple_glossy_bsdf) &&
         nonode(bsdf_marker); 
}

rules Use_microflake_sheen_for_ovrtx topdown {
    sheen_bsdf(roughness,tint,multiscatter_tint,multiscatter,handle)
        --> microflake_sheen_bsdf(
            roughness,tint,multiscatter_tint,multiscatter,handle);

    postcond nonode(sheen_bsdf);
}


